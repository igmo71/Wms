@using Wms.Domain
@using Wms.Domain.Enums

@if (Assessment is { } assessment && (assessment.Level != OrderSynchronizationLevel.Synchronized || (Receiving && assessment.Differences.Count > 0)))
{
    <MudAlert Severity="@(assessment.Level == OrderSynchronizationLevel.Blocking ? Severity.Error : assessment.Level == OrderSynchronizationLevel.Synchronized ? Severity.Info : Severity.Warning)"
              Variant="Variant.Outlined">
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.subtitle1"><b>@(Receiving ? "Сверка приходного ордера с 1С" : assessment.Level.GetDisplayText())</b></MudText>
            </MudStack>
            <MudText Typo="Typo.body2">
                @(Receiving ? "Количественные расхождения рассматривает заведующий. Удаление документа, отмена проведения и ошибки проверки не допускают завершения."
                    : assessment.Level == OrderSynchronizationLevel.Blocking
                    ? "Расхождения затрагивают складские данные. Продолжение операции недопустимо до исправления источника."
                    : "Прочитайте изменения. Подтверждение применит перечисленные значения из 1С в WMS.")
            </MudText>

            <MudTable T="OrderSynchronizationDifference"
                      Items="assessment.Differences"
                      Dense="true"
                      Hover="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>Поле</MudTh>
                    <MudTh>WMS</MudTh>
                    <MudTh>1С</MudTh>
                    <MudTh>Уровень</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Поле">@context.FieldName</MudTd>
                    <MudTd DataLabel="WMS">@(context.WmsValue ?? "—")</MudTd>
                    <MudTd DataLabel="1С">@(context.OneCValue ?? "—")</MudTd>
                    <MudTd DataLabel="Уровень">@(Receiving && context.Level == OrderSynchronizationLevel.Synchronized ? "Информация" : context.Level.GetDisplayText())</MudTd>
                </RowTemplate>
            </MudTable>

            @if (assessment.Level == OrderSynchronizationLevel.RequiresOperatorDecision)
            {
                <MudButton Color="Color.Warning"
                           Variant="Variant.Filled"
                           Disabled="IsAcknowledging"
                           StartIcon="@Icons.Material.Filled.DoneAll"
                           OnClick="OnAcknowledge">
                    Принять изменения из 1С
                </MudButton>
            }
        </MudStack>
    </MudAlert>
}

@if (AcknowledgedAtUtc is DateTimeOffset acknowledgedAtUtc)
{
    <MudText Typo="Typo.caption">
        Последнее подтверждение: @AcknowledgedBy, @acknowledgedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
    </MudText>
}

@code {
    [Parameter]
    public bool Receiving { get; set; }

    [Parameter, EditorRequired]
    public OrderSynchronizationAssessment? Assessment { get; set; }

    [Parameter]
    public bool IsAcknowledging { get; set; }

    [Parameter]
    public EventCallback OnAcknowledge { get; set; }

    [Parameter]
    public string AcknowledgedBy { get; set; } = "—";

    [Parameter]
    public DateTimeOffset? AcknowledgedAtUtc { get; set; }
}
