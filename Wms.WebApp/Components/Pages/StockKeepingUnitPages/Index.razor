@page "/stock-keeping-units"
@attribute [Authorize(Roles = ApplicationRoles.ManagerOrAdministrator)]
@using Wms.Common
@using Wms.Domain

<PageTitle>Номенклатура</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Номенклатура</MudText>
    <MudSpacer />
    <AuthorizeView Roles="@ApplicationRoles.Manager">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_isImporting" OnClick="RefreshFromOneCAsync">
            @(_isImporting ? "Обновление..." : "Обновить из 1С")
        </MudButton>
    </AuthorizeView>
</MudStack>

@if (_isImporting)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
@if (_importFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_importMessage</MudAlert>
}
else if (_importSucceeded)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@_importMessage</MudAlert>
}
else if (_importWarning)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@_importMessage</MudAlert>
}
@if (_trackingMessage is not null)
{
    <MudAlert Severity="@(_trackingError ? Severity.Error : Severity.Success)" Class="mb-4">@_trackingMessage</MudAlert>
}
@if (_pendingTracking is not null)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_isChangingTracking" OnClick="RetryTrackingAsync" Class="mb-4">
        Повторить изменение признака
    </MudButton>
}

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudTextField T="string" Value="_searchString" ValueChanged="OnSearchChangedAsync" Label="Поиск по наименованию" Immediate="true" DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        <MudSwitch T="bool" Value="_includeDeleted" ValueChanged="OnIncludeDeletedChangedAsync" Color="Color.Primary" Label="Показать деактивированные" Class="ml-4" />
    </MudStack>
</MudPaper>

<MudDataGrid T="StockKeepingUnit" @ref="_dataGrid" ServerData="LoadServerDataAsync" SortMode="SortMode.Single" Filterable="false" Hover="true" Striped="true" Dense="true" RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="Код" Sortable="true" />
        <PropertyColumn Property="x => x.Name" Title="Наименование" Sortable="true" />
        <PropertyColumn Property="x => x.BaseUnitOfMeasure!.Name" Title="Базовая единица" Sortable="true" />
        <PropertyColumn Property="x => x.WeightKg" Title="Вес, кг" Sortable="true">
            <CellTemplate>@(context.Item.WeightKg is double weight ? weight.ToString("0.###") : "—")</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.VolumeM3" Title="Объём, м³" Sortable="true">
            <CellTemplate>@(context.Item.VolumeM3 is double volume ? volume.ToString("0.######") : "—")</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Учёт срока" Sortable="false">
            <CellTemplate>
                <AuthorizeView Roles="@ApplicationRoles.Manager" Context="authorization">
                    <Authorized>
                        <MudSwitch T="bool" Value="context.Item.TracksExpirationDate"
                                   ValueChanged="enabled => ChangeTrackingAsync(context.Item, enabled)"
                                   Disabled="@(_isChangingTracking || _pendingTracking is not null)"
                                   Color="Color.Primary" />
                    </Authorized>
                    <NotAuthorized>@(context.Item.TracksExpirationDate ? "Включён" : "Выключен")</NotAuthorized>
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="История срока" Sortable="false">
            <CellTemplate>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => ShowTrackingHistoryAsync(context.Item)" Disabled="_isChangingTracking">История</MudButton>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Статус" Sortable="false"><CellTemplate><MudTooltip Text="@(context.Item.DeletionMark ? "Деактивирована" : "Активна")"><MudIcon Icon="@(context.Item.DeletionMark ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="@(context.Item.DeletionMark ? Color.Default : Color.Success)" /></MudTooltip></CellTemplate></TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="StockKeepingUnit" PageSizeOptions="new[] { 10, 25, 50 }" /></PagerContent>
</MudDataGrid>

@if (_historySkuId is not null)
{
    <MudPaper Class="pa-3 mt-4" Elevation="1">
        <MudText Typo="Typo.h6">История учёта срока: @_historySkuName</MudText>
        @if (_trackingHistory.Count == 0)
        {
            <MudText>Переключений пока нет.</MudText>
        }
        else
        {
            @foreach (var change in _trackingHistory)
            {
                <MudText>@change.OccurredAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @change.ActorName: @(change.Before ? "Включён" : "Выключен") → @(change.After ? "Включён" : "Выключен")</MudText>
            }
        }
    </MudPaper>
}
