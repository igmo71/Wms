@page "/sku-barcodes"
@attribute [Authorize(Roles = ApplicationRoles.ManagerOrAdministrator)]
@using Wms.Application.SkuBarcodes
@using Wms.Domain.Enums

<PageTitle>Штрихкоды</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Штрихкоды SKU</MudText>
    <MudSpacer />
    <AuthorizeView Roles="@ApplicationRoles.Manager">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(_isImporting || _isRemoving || _pendingRemoval is not null)" OnClick="RefreshFromOneCAsync">
            @(_isImporting ? "Обновление..." : "Обновить из 1С")
        </MudButton>
    </AuthorizeView>
</MudStack>
@if (_isImporting)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
@if (_importFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_importMessage</MudAlert>
}
else if (_importSucceeded)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@_importMessage</MudAlert>
}
@if (_removalMessage is not null)
{
    <MudAlert Severity="@(_removalError ? Severity.Error : Severity.Success)" Class="mb-4">@_removalMessage</MudAlert>
}
@if (_pendingRemoval is not null)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_isRemoving"
               OnClick="RetryRemovalAsync" Class="mb-4">Повторить удаление</MudButton>
}
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudTextField T="string" Value="_searchString" ValueChanged="OnSearchChangedAsync"
                      Label="Поиск по штрихкоду или SKU" Immediate="true"
                      DebounceInterval="300" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        <MudSwitch T="bool" Value="_onlyDuplicates" ValueChanged="OnOnlyDuplicatesChangedAsync"
                   Color="Color.Primary" Label="Только дубли" Class="ml-4" />
        <MudSwitch T="bool" Value="_includeDeleted" ValueChanged="OnIncludeDeletedChangedAsync"
                   Color="Color.Primary" Label="Показать неактивные SKU" Class="ml-4" />
    </MudStack>
</MudPaper>
<MudDataGrid T="SkuBarcodeListRow" @ref="_dataGrid" ServerData="LoadServerDataAsync" SortMode="SortMode.Single" Filterable="false" Hover="true" Striped="true" Dense="true" RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Value" Title="Штрихкод" Sortable="true" />
        <PropertyColumn Property="x => x.SkuName" Title="SKU" Sortable="true">
            <CellTemplate>@SkuDisplay(context.Item)</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Источник" Sortable="false">
            <CellTemplate>@(context.Item.Source == SkuBarcodeSource.Wms ? "WMS" : "1С")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Дубль" Sortable="false">
            <CellTemplate>@(context.Item.IsDuplicate ? "Да" : "—")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Действие" Sortable="false">
            <CellTemplate>
                <AuthorizeView Roles="@ApplicationRoles.Manager" Context="authorization">
                    <Authorized>
                        @if (context.Item.Source == SkuBarcodeSource.Wms)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                       Disabled="@(_isRemoving || _pendingRemoval is not null || _isImporting)"
                                       OnClick="() => ConfirmRemovalAsync(context.Item)">Удалить</MudButton>
                        }
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="SkuBarcodeListRow" PageSizeOptions="new[] { 10, 25, 50 }" /></PagerContent>
</MudDataGrid>
