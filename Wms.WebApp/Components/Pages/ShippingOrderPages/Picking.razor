@page "/shipping-orders/{Id:guid}/picking"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Отбор расходного ордера</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Расходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Расходный ордер №@_order.Number от @_order.Date.ToString("dd.MM.yyyy HH:mm")</MudText>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_isCompleting || !CanCompletePicking)" StartIcon="@Icons.Material.Filled.Check" OnClick="SetReadyForShipmentAsync">
                Готов к отгрузке
            </MudButton>
            @if (CanRollback)
            {
                <MudTooltip Text="Ордер вернётся в статус «Подготовлено», а фактическое количество будет сброшено.">
                    <span>
                        <MudButton Color="Color.Error"
                                   Variant="Variant.Outlined"
                                   Disabled="_isRollingBack"
                                   StartIcon="@Icons.Material.Filled.Undo"
                                   OnClick="ShowRollbackDialogAsync">
                            Откатить
                        </MudButton>
                    </span>
                </MudTooltip>
            }
            <MudButton Href="shipping-orders" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">К списку</MudButton>
        </MudStack>

        @if (_isCompleting)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.caption">Отправляется запрос в 1С…</MudText>
        }

        @if (_operationFailed)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_synchronizationErrorMessage))
        {
            <MudAlert Severity="Severity.Error">@_synchronizationErrorMessage</MudAlert>
        }

        <OrderSynchronizationPanel Assessment="_synchronizationAssessment"
                                   IsAcknowledging="_isAcknowledgingSynchronization"
                                   OnAcknowledge="AcknowledgeSynchronizationAsync"
                                   AcknowledgedBy="@GetUserName(_order.SynchronizationAcknowledgedBy)"
                                   AcknowledgedAtUtc="_order.SynchronizationAcknowledgedAtUtc" />

        @if (_isRollingBack)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.caption">Выполняется откат ордера…</MudText>
        }

        @if (!IsPickingEditable)
        {
            <MudAlert Severity="Severity.Warning">Отбор доступен только для ордера в статусе отбора или проверки.</MudAlert>
        }

        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Склад</MudText><MudText>@_order.Warehouse?.Name</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Складская операция</MudText><MudText>@_order.WarehouseOperation.GetDisplayName()</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Получатель</MudText><MudText>@PartyDisplay.Format(_order.Receiver, _order.ReceiverId, _order.ReceiverType)</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Статус</MudText><MudChip T="string" Size="Size.Small" Color="@_order.Status.GetChipColor()">@_order.Status.GetDisplayName()</MudChip></MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Очередь</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@_order.Queue.GetIcon()" Size="Size.Small" />
                        <MudText>@_order.Queue.GetDisplayName()</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Направление доставки</MudText><MudText>@_order.DeliveryDirection?.Description</MudText></MudItem>
            </MudGrid>
            <MudDivider Class="my-1" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Позиция отгрузки</MudText><MudText>@StorageLocationDisplay.FormatOrDash(_order.ShippingLocation)</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Планируемая дата отгрузки</MudText><MudText>@FormatDateTime(_order.PlannedShippingDate)</MudText></MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTooltip Text="@(_order.Comment ?? "—")">
                        <MudText Typo="Typo.caption">Комментарий</MudText>
                        <MudText Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(_order.Comment ?? "—")</MudText>
                    </MudTooltip>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Фактический вес</MudText><MudText>@WeightDisplay.FormatTotal(_order.KnownFactWeightKg, _order.IsFactWeightComplete)</MudText></MudItem>
            </MudGrid>
            <MudDivider Class="my-1" />
            <MudGrid Spacing="2">
                <DocumentOperationInfo Title="Начал сборку" UserName="@GetUserName(_order.PickingStartedBy)" Timestamp="_order.PickingStartedAtUtc" />
                <DocumentOperationInfo Title="Собрал" UserName="@GetUserName(_order.ReadyForShipmentBy)" Timestamp="_order.ReadyForShipmentAtUtc" />
                <DocumentOperationInfo Title="Отгрузил" UserName="@GetUserName(_order.ShippedBy)" Timestamp="_order.ShippedAtUtc" />
                @if (_order.RolledBackAtUtc is not null)
                {
                    <DocumentOperationInfo Title="Последний откат" UserName="@GetUserName(_order.RolledBackBy)" Timestamp="_order.RolledBackAtUtc" Detail="@_order.RollbackReason" />
                }
            </MudGrid>
        </MudPaper>

        @if (IsPickingEditable)
        {
            <MudDataGrid T="ShippingOrderItem"
                         @ref="_orderItemsGrid"
                         Items="_order.Items"
                         Hover="true"
                         Striped="true"
                         Dense="true"
                         ExpandSingleRow="false">
                <Columns>
                    <HierarchyColumn T="ShippingOrderItem">
                        <CellTemplate Context="lineContext">
                            <MudIconButton Icon="@(_expandedLineNumber == lineContext.Item.LineNumber
                                                                                                                ? Icons.Material.Filled.ExpandMore
                                                                                                                : Icons.Material.Filled.ChevronRight)"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleLinePickingAsync(lineContext.Item))" />
                        </CellTemplate>
                    </HierarchyColumn>
                    <PropertyColumn Property="x => x.LineNumber" Title="Строка" />
                    <PropertyColumn Property="x => x.StockKeepingUnit == null ? string.Empty : x.StockKeepingUnit.Name" Title="Номенклатура" />
                    <PropertyColumn Property="x => x.PlanQuantity" Title="План" />
                    <PropertyColumn Property="x => x.FactQuantity" Title="Факт" />
                    <TemplateColumn Title="Фактический вес"><CellTemplate>@WeightDisplay.Format(context.Item.FactWeightKg)</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.RemainingQuantity" Title="Осталось" />

                </Columns>
                <ChildRowContent>
                    @if (_selectedLine?.LineNumber == context.Item.LineNumber)
                    {
                        <MudPaper Class="pa-3 ma-2" Elevation="0" Outlined="true">
                            <MudDataGrid T="InventoryMovement" Items="_movements" Hover="true" Striped="true" Dense="true">
                                <Columns>
                                    <TemplateColumn Title="Ячейка-источник">
                                        <CellTemplate Context="sourceContext">@StorageLocationDisplay.FormatOrDash(sourceContext.Item.SourceStorageLocation)</CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="x => x.Quantity" Title="Количество" />
                                    <TemplateColumn Title="Вес"><CellTemplate Context="weightContext">@WeightDisplay.Format(weightContext.Item.WeightKg)</CellTemplate></TemplateColumn>
                                    <PropertyColumn Property="x => x.CreatedAtUtc" Title="Создано" Format="dd.MM.yyyy HH:mm" />
                                    <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Изменено" Format="dd.MM.yyyy HH:mm" />
                                    <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
                                        <CellTemplate Context="movementContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => BeginEditing(movementContext.Item))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteMovementAsync(movementContext.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>

                            <MudGrid Spacing="6" Class="mt-1">
                                <MudItem xs="12" md="6">
                                    <MudSelect T="StorageLocation"
                                               Label="Ячейка-источник"
                                               @bind-Value="_selectedSourceLocation"
                                               ToStringFunc="StorageLocationDisplay.Format"
                                               Clearable="true">
                                        @foreach (var sourceLocation in _availableSourceLocations)
                                        {
                                            <MudSelectItem Value="@sourceLocation.StorageLocation">@FormatSourceLocation(sourceLocation)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (_selectedSourceLocation is not null)
                                    {
                                        <MudText Typo="Typo.caption">Фактический остаток: @FormatQuantity(SelectedSourcePhysicalQuantity) / @WeightDisplay.Format(WeightCalculation.CalculateKg(SelectedSourcePhysicalQuantity, _selectedLine.StockKeepingUnit)) · Доступно к отбору: @FormatQuantity(SelectedSourceAvailableQuantity) / @WeightDisplay.Format(WeightCalculation.CalculateKg(SelectedSourceAvailableQuantity, _selectedLine.StockKeepingUnit))</MudText>
                                    }
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudNumericField T="decimal" Label="Фактическое количество" @bind-Value="_movementQuantity" Min="0" Max="MaximumPickingQuantity" HideSpinButtons="true" />
                                    <MudText Typo="Typo.caption">Можно отобрать: @FormatQuantity(MaximumPickingQuantity)</MudText>
                                    <MudText Typo="Typo.caption">Вес: @WeightDisplay.Format(WeightCalculation.CalculateKg(_movementQuantity, _selectedLine.StockKeepingUnit))</MudText>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSaveMovement)" OnClick="SaveMovementAsync">@(_editingMovement is null ? "Добавить" : "Сохранить")</MudButton>
                                    @if (_editingMovement is not null)
                                    {
                                        <MudButton Variant="Variant.Text" OnClick="CancelEditing">Отмена</MudButton>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </ChildRowContent>
            </MudDataGrid>
        }
    </MudStack>
}
