@page "/shipping-orders/{Id:guid}/picking"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Отбор расходного ордера</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Расходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">Расходный ордер №@_order.Number от @_order.Date.ToString("dd.MM.yyyy HH:mm")</MudText>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_isCompleting || !IsPickingEditable)" StartIcon="@Icons.Material.Filled.Check" OnClick="SetReadyForShipmentAsync">
                Готов к отгрузке
            </MudButton>
            @if (CanRollback)
            {
                <MudButton Color="Color.Error"
                           Variant="Variant.Outlined"
                           Disabled="_isRollingBack"
                           StartIcon="@Icons.Material.Filled.Undo"
                           OnClick="ShowRollbackDialogAsync">
                    Откатить
                </MudButton>
            }
            <MudButton Href="shipping-orders" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">К списку</MudButton>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3"><MudText Typo="Typo.caption">Склад</MudText><MudText>@_order.Warehouse?.Name</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Статус</MudText><MudText>@_order.Status.GetDisplayName()</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Очередь</MudText><MudText>@_order.Queue.GetDisplayName()</MudText></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudText Typo="Typo.caption">Направление доставки</MudText><MudText>@_order.DeliveryDirection?.Description</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Планируемая дата отгрузки</MudText><MudText>@FormatDateTime(_order.PlannedShippingDate)</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Зона отгрузки</MudText><MudText>@_order.ShippingLocation?.Zone?.Name</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Место отгрузки</MudText><MudText>@_order.ShippingLocation?.Name</MudText></MudItem>
                <MudItem xs="12" sm="6" md="8"><MudText Typo="Typo.caption">Комментарий</MudText><MudText>@_order.Comment</MudText></MudItem>
                @if (_order.RolledBackAtUtc is not null)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption">Последний откат</MudText>
                        <MudTooltip Text="@GetRollbackDescription()">
                            <MudText Typo="Typo.caption" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @GetRollbackSummary()
                            </MudText>
                        </MudTooltip>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        @if (!IsPickingEditable)
        {
            <MudAlert Severity="Severity.Warning">Отбор доступен только для ордера в статусе отбора или проверки.</MudAlert>
        }

        @if (_operationFailed)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (IsPickingEditable)
        {
            <MudDataGrid T="ShippingOrderItem"
                         @ref="_orderItemsGrid"
                         Items="_order.Items"
                         Hover="true"
                         Striped="true"
                         Dense="true"
                         ExpandSingleRow="false">
                <Columns>
                    <HierarchyColumn T="ShippingOrderItem">
                        <CellTemplate Context="lineContext">
                            <MudIconButton Icon="@(_expandedLineNumber == lineContext.Item.LineNumber
                                                        ? Icons.Material.Filled.ExpandMore
                                                        : Icons.Material.Filled.ChevronRight)"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleLinePickingAsync(lineContext.Item))" />
                        </CellTemplate>
                    </HierarchyColumn>
                    <PropertyColumn Property="x => x.LineNumber" Title="Строка" />
                    <PropertyColumn Property="x => x.StockKeepingUnit == null ? string.Empty : x.StockKeepingUnit.Name" Title="Номенклатура" />
                    <PropertyColumn Property="x => x.PlanQuantity" Title="План" />
                    <PropertyColumn Property="x => x.FactQuantity" Title="Факт" />
                    <PropertyColumn Property="x => x.RemainingQuantity" Title="Осталось" />

                </Columns>
                <ChildRowContent>
                    @if (_selectedLine?.LineNumber == context.Item.LineNumber)
                    {
                        <MudPaper Class="pa-3 ma-2" Elevation="0" Outlined="true">
                            <MudDataGrid T="InventoryMovement" Items="_movements" Hover="true" Striped="true" Dense="true">
                                <Columns>
                                    <PropertyColumn Property="x => x.SourceStorageLocation == null ? string.Empty : x.SourceStorageLocation.Name" Title="Ячейка-источник" />
                                    <PropertyColumn Property="x => x.Quantity" Title="Количество" />
                                    <PropertyColumn Property="x => x.CreatedAtUtc" Title="Создано" Format="dd.MM.yyyy HH:mm" />
                                    <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Изменено" Format="dd.MM.yyyy HH:mm" />
                                    <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
                                        <CellTemplate Context="movementContext">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => BeginEditing(movementContext.Item))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteMovementAsync(movementContext.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>

                            <MudGrid Spacing="6" Class="mt-1">
                                <MudItem xs="12" md="6">
                                    <MudSelect T="StorageLocation"
                                               Label="Ячейка-источник"
                                               @bind-Value="_selectedSourceLocation"
                                               ToStringFunc="location => location?.Name ?? string.Empty"
                                               Clearable="true">
                                        @foreach (var sourceLocation in _availableSourceLocations)
                                        {
                                            <MudSelectItem Value="@sourceLocation.StorageLocation">@FormatSourceLocation(sourceLocation)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (_selectedSourceLocation is not null)
                                    {
                                        <MudText Typo="Typo.caption">Фактический остаток: @FormatQuantity(SelectedSourcePhysicalQuantity) · Доступно к отбору: @FormatQuantity(SelectedSourceAvailableQuantity)</MudText>
                                    }
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudNumericField T="double" Label="Фактическое количество" @bind-Value="_movementQuantity" Min="0" Max="MaximumPickingQuantity" HideSpinButtons="true" />
                                    <MudText Typo="Typo.caption">Можно отобрать: @FormatQuantity(MaximumPickingQuantity)</MudText>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSaveMovement)" OnClick="SaveMovementAsync">@(_editingMovement is null ? "Добавить" : "Сохранить")</MudButton>
                                    @if (_editingMovement is not null)
                                    {
                                        <MudButton Variant="Variant.Text" OnClick="CancelEditing">Отмена</MudButton>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </ChildRowContent>
            </MudDataGrid>
        }
    </MudStack>
}
