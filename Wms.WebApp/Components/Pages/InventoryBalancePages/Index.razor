@page "/inventory-balances"
@using Wms.Domain

<PageTitle>Остатки</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Остатки на складе</MudText>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudTextField T="string"
                      Value="_searchString"
                      ValueChanged="OnSearchChangedAsync"
                      Label="Поиск"
                      Immediate="true"
                      DebounceInterval="300"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" />
        <MudAutocomplete T="Warehouse"
                         Value="_warehouse"
                         ValueChanged="OnWarehouseChangedAsync"
                         SearchFunc="SearchWarehousesAsync"
                         ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                         Label="Склад"
                         Clearable="true"
                         Class="ml-4" />
        <MudAutocomplete T="StorageLocation"
                         Value="_storageLocation"
                         ValueChanged="OnStorageLocationChangedAsync"
                         SearchFunc="SearchStorageLocationsAsync"
                         ToStringFunc="StorageLocationDisplay.Format"
                         Label="Ячейка хранения"
                         Clearable="true"
                         Class="ml-4" />
        <MudAutocomplete T="StockKeepingUnit"
                         Value="_stockKeepingUnit"
                         ValueChanged="OnStockKeepingUnitChangedAsync"
                         SearchFunc="SearchStockKeepingUnitsAsync"
                         ToStringFunc="stockKeepingUnit => stockKeepingUnit?.Name ?? string.Empty"
                         Label="Номенклатура"
                         Clearable="true"
                         Class="ml-4" />
    </MudStack>
</MudPaper>

<MudDataGrid T="InventoryBalance"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Warehouse!.Name" Title="Склад" Sortable="true" />
        <PropertyColumn Property="x => x.StorageLocation!.Code" Title="Ячейка хранения" Sortable="true">
            <CellTemplate>@StorageLocationDisplay.Format(context.Item.StorageLocation)</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.StockKeepingUnit!.Name" Title="Номенклатура" Sortable="true" />
        <PropertyColumn Property="x => x.StockKeepingUnit!.Code" Title="Код" Sortable="false" />
        <PropertyColumn Property="x => x.Quantity" Title="Количество" Sortable="true" />
        <TemplateColumn Title="Вес" Sortable="false"><CellTemplate>@WeightDisplay.Format(context.Item.WeightKg)</CellTemplate></TemplateColumn>
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Изменен" Format="g" Sortable="true" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="InventoryBalance" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
