@page "/delivery-directions"
@using Wms.Domain

<PageTitle>Направления доставки</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Направления доставки</MudText>
    <MudSpacer />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_isImporting" OnClick="RefreshFromOneCAsync">
        @(_isImporting ? "Обновление..." : "Обновить из 1С")
    </MudButton>
</MudStack>
@if (_isImporting)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
@if (_importFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_importMessage</MudAlert>
}
else if (_importSucceeded)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@_importMessage</MudAlert>
}
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudSwitch T="bool" Value="_includeDeleted" ValueChanged="OnIncludeDeletedChangedAsync" Color="Color.Primary" Label="Показать деактивированные" />
</MudPaper>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTreeView T="DeliveryDirection" Hover="true" Dense="true">
        @foreach (var direction in GetChildren(null))
        {
            <DeliveryDirectionTreeItem Direction="direction" Directions="_items" />
        }
    </MudTreeView>
}
