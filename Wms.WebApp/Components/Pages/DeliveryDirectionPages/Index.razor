@page "/delivery-directions"
@using Wms.Domain

<PageTitle>Направления доставки</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Направления доставки</MudText>
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudSwitch T="bool" Value="_includeDeleted" ValueChanged="OnIncludeDeletedChangedAsync" Color="Color.Primary" Label="Показать деактивированные" />
</MudPaper>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTreeView T="DeliveryDirection" Hover="true" Dense="true">
        @foreach (var direction in GetChildren(null))
        {
            <DeliveryDirectionTreeItem Direction="direction" Directions="_items" />
        }
    </MudTreeView>
}
