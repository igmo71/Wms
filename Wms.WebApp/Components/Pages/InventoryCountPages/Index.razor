@page "/inventory-counts"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Инвентаризации</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Инвентаризации</MudText>
    <MudSpacer />
    <MudAutocomplete T="Warehouse"
                     Value="_warehouse"
                     ValueChanged="OnWarehouseChanged"
                     SearchFunc="SearchWarehousesAsync"
                     ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                     Label="Склад"
                     Clearable="true"
                     Class="mr-2" />
    <MudTooltip Text="Чтобы создать инвентаризацию, выберите склад.">
        <span>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(_isCreating || _warehouse is null)"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">
                Создать инвентаризацию
            </MudButton>
        </span>
    </MudTooltip>
</MudStack>

@if (_createFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

<MudDataGrid T="InventoryCount"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Номер" Sortable="true">
            <CellTemplate><MudLink Href="@($"inventory-counts/{context.Item.Id}")">@context.Item.Number</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Date" Title="Дата" Format="dd.MM.yyyy" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse == null ? string.Empty : x.Warehouse.Name" Title="Склад" />
        <PropertyColumn Property="x => x.Status.GetDisplayName()" Title="Статус">
            <CellTemplate><MudChip T="string" Size="Size.Small" Color="@context.Item.Status.GetChipColor()">@context.Item.Status.GetDisplayName()</MudChip></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.CreatedAtUtc" Title="Создано" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <PropertyColumn Property="x => x.UpdatedAtUtc" Title="Изменено" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <PropertyColumn Property="x => x.PostedAtUtc" Title="Проведено" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Детали">
                    <MudIconButton Href="@($"inventory-counts/{context.Item.Id}")"
                                   Icon="@Icons.Material.Filled.OpenInNew"
                                   Color="Color.Primary" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="InventoryCount" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
