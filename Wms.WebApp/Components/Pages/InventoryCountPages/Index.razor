@page "/inventory-counts"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Инвентаризации</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">Инвентаризации</MudText>
    <MudSpacer />
    <MudAutocomplete T="Warehouse"
                     Value="_warehouse"
                     ValueChanged="OnWarehouseChanged"
                     SearchFunc="SearchWarehousesAsync"
                     ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                     Label="Склад"
                     Disabled="@InputsLocked"
                     Clearable="true"
                     Class="mr-2" />
    <MudAutocomplete T="StorageLocation"
                     @bind-Value="_storageLocation"
                     SearchFunc="SearchStorageLocationsAsync"
                     ToStringFunc="GetLocationText"
                     Label="Ячейка"
                     Disabled="@(InputsLocked || _warehouse is null)"
                     Clearable="true"
                     Class="mr-2" />
    <AuthorizeView Roles="Operator">
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(InputsLocked || _warehouse is null || _storageLocation is null)"
                   OnClick="CreateAsync">
            Открыть инвентаризацию
        </MudButton>
    </AuthorizeView>
    <AuthorizeView Roles="Manager">
        @if (_storageLocation is not null)
        {
            <MudButton Variant="Variant.Outlined"
                       Disabled="@(_isCreating || _pendingStart is not null)"
                       OnClick="ChangeMixingAsync">
                @(_pendingMixing is not null ? "Повторить настройку мульти-SKU"
                    : _storageLocation.AllowsMultipleSkus ? "Запретить несколько SKU" : "Разрешить несколько SKU")
            </MudButton>
        }
    </AuthorizeView>
</MudStack>

@if (_pendingStart is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        Начало инвентаризации ожидает подтверждения результата.
        <MudButton OnClick="RetryAsync" Disabled="@_isCreating" Color="Color.Primary">Повторить</MudButton>
    </MudAlert>
}

@if (_createFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

<MudDataGrid T="InventoryCount"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Номер" Sortable="true">
            <CellTemplate><MudLink Href="@($"inventory-counts/{context.Item.Id}")">@context.Item.Number</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Date" Title="Дата" Format="dd.MM.yyyy" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse == null ? string.Empty : x.Warehouse.Name" Title="Склад" />
        <TemplateColumn Title="Ячейка">
            <CellTemplate>@GetLocationText(context.Item.StorageLocation)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Status" Title="Статус">
            <CellTemplate><MudChip T="string" Size="Size.Small" Color="@context.Item.Status.GetChipColor()">@context.Item.Status.GetDisplayName()</MudChip></CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Провёл" Sortable="false"><CellTemplate>@GetUserName(context.Item.PostedBy)</CellTemplate></TemplateColumn>
        <PropertyColumn Property="x => x.PostedAtUtc" Title="Проведено" Format="dd.MM.yyyy HH:mm" Sortable="true" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="InventoryCount" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
