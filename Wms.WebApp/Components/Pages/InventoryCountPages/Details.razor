@page "/inventory-counts/{Id:guid}"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Application.Inventory.Counts
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Инвентаризация</PageTitle>

@if (_pendingOperation is { } pending)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        Операция «@pending.Label» ожидает подтверждения результата.
        <MudButton OnClick="RetryAsync" Disabled="@_isBusy" Color="Color.Primary">Повторить</MudButton>
    </MudAlert>
}
@if (_operationFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_inventoryCount is null)
{
    <MudAlert Severity="Severity.Warning">Инвентаризация не найдена.</MudAlert>
}
else
{
    <AuthorizeView Roles="Operator">
        <Authorized>
            @RenderCount(_inventoryCount!, IsDraft)
        </Authorized>
        <NotAuthorized>
            @RenderCount(_inventoryCount!, false)
        </NotAuthorized>
    </AuthorizeView>
}

@code {
private RenderFragment RenderCount(InventoryCount count, bool canEdit) => @<text>
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Инвентаризация №@count.Number</MudText>
            <MudSpacer />
            @if (canEdit)
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@(InputsLocked || UncountedItems > 0)"
                           StartIcon="@Icons.Material.Filled.Check"
                           OnClick="PostAsync">
                    Провести
                </MudButton>
                <MudButton Color="Color.Error"
                           Variant="Variant.Text"
                           Disabled="@InputsLocked"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteDraftAsync">
                    Удалить черновик
                </MudButton>
            }
            <MudButton Href="inventory-counts" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                К списку
            </MudButton>
        </MudStack>


        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">Склад</MudText>
                    <MudText>@count.Warehouse?.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">Ячейка</MudText>
                    <MudText><b>@LocationText</b></MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">Статус</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@count.Status.GetChipColor()">
                        @count.Status.GetDisplayName()
                    </MudChip>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-3" />
            <MudText>
                Позиций: @count.Items.Count · Пересчитано: @CountedItems · Осталось: @UncountedItems
            </MudText>
        </MudPaper>

        @if (canEdit)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Добавить или исправить товар</b></MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="5">
                        <MudAutocomplete T="InventoryCountSkuSearchResult"
                                         Value="_selectedSku"
                                         ValueChanged="SelectSku"
                                         SearchFunc="SearchSkusAsync"
                                         ToStringFunc="GetSkuText"
                                         Label="Наименование, код или штрихкод"
                                         Disabled="@InputsLocked"
                                         Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker @bind-Date="_manualExpiration" DateFormat="dd.MM.yyyy"
                                       Label="Срок годности" Editable="true" Clearable="true"
                                       Disabled="@(InputsLocked || _selectedSku is null || _manualUnknownExpiration)" />
                        @if (_selectedSku is not null)
                        {
                            <MudCheckBox T="bool" @bind-Value="_manualUnknownExpiration" Label="Срок неизвестен"
                                         Disabled="@(InputsLocked || _manualExpiration.HasValue)" />
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_manualQuantity"
                                         Label="Фактически"
                                         Min="0"
                                         Disabled="@InputsLocked"
                                         HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   FullWidth="true"
                                   Disabled="@(!CanSaveManualQuantity)"
                                   OnClick="SaveManualQuantityAsync">
                            Сохранить
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudTable Items="SortedItems" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Товар</MudTh>
                <MudTh>Срок годности</MudTh>
                <MudTh>Ожидается</MudTh>
                <MudTh>Фактически</MudTh>
                <MudTh>Разница</MudTh>
                @if (canEdit) { <MudTh></MudTh> }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Товар">
                    <b>@context.StockKeepingUnit?.Name</b><br />
                    <MudText Typo="Typo.caption">
                        Код: @context.StockKeepingUnit?.Code · @(context.StockKeepingUnit?.BaseUnitOfMeasure?.Description ?? "—")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Срок годности">
                    @FormatExpiration(context)
                    @if (canEdit && RequiresExpiration(context) && context.CountedQuantity > 0 && !context.ExpirationConfirmed)
                    {
                        <MudButton Size="Size.Small" Disabled="@InputsLocked"
                                   OnClick="@(() => UpdateQuantityAsync(context, context.CountedQuantity))">
                            Подтвердить срок
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="Ожидается">@FormatQuantity(context.ExpectedQuantity)</MudTd>
                <MudTd DataLabel="Фактически">
                    @if (canEdit)
                    {
                        <MudNumericField T="decimal?"
                                         @key="(context.Id, _quantityEditorVersion)"
                                         Value="context.CountedQuantity"
                                         ValueChanged="quantity => UpdateQuantityAsync(context, quantity)"
                                         Min="0"
                                         Disabled="@InputsLocked"
                                         Placeholder="Не пересчитано"
                                         HideSpinButtons="true"
                                         Variant="Variant.Text" />
                    }
                    else
                    {
                        @FormatQuantity(context.CountedQuantity)
                    }
                </MudTd>
                <MudTd DataLabel="Разница">@FormatQuantity(context.DifferenceQuantity)</MudTd>
                @if (canEdit)
                {
                    <MudTd>
                        @if (!context.IsExpected)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           Disabled="@InputsLocked"
                                           OnClick="@(() => RemoveItemAsync(context))" />
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    </MudStack>
</text>;
}
