@page "/inventory-counts/{Id:guid}"
@using Wms.Application.Inventory.Counts
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Инвентаризация</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_inventoryCount is null)
{
    <MudAlert Severity="Severity.Warning">Инвентаризация не найдена.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Инвентаризация №@_inventoryCount.Number</MudText>
            <MudSpacer />
            @if (IsDraft)
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@(_isBusy || UncountedItems > 0)"
                           StartIcon="@Icons.Material.Filled.Check"
                           OnClick="PostAsync">
                    Провести
                </MudButton>
                <MudButton Color="Color.Error"
                           Variant="Variant.Text"
                           Disabled="@_isBusy"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="DeleteDraftAsync">
                    Удалить черновик
                </MudButton>
            }
            <MudButton Href="inventory-counts" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                К списку
            </MudButton>
        </MudStack>

        @if (_operationFailed)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">Склад</MudText>
                    <MudText>@_inventoryCount.Warehouse?.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">Ячейка</MudText>
                    <MudText><b>@LocationText</b></MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption">Статус</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@_inventoryCount.Status.GetChipColor()">
                        @_inventoryCount.Status.GetDisplayName()
                    </MudChip>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-3" />
            <MudText>
                Позиций: @_inventoryCount.Items.Count · Пересчитано: @CountedItems · Осталось: @UncountedItems
            </MudText>
        </MudPaper>

        @if (IsDraft)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Добавить или исправить товар</b></MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="7">
                        <MudAutocomplete T="InventoryCountSkuSearchResult"
                                         @bind-Value="_selectedSku"
                                         SearchFunc="SearchSkusAsync"
                                         ToStringFunc="GetSkuText"
                                         Label="Наименование, код или штрихкод"
                                         Disabled="@_isBusy"
                                         Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_manualQuantity"
                                         Label="Фактически"
                                         Min="0"
                                         Disabled="@_isBusy"
                                         HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   FullWidth="true"
                                   Disabled="@(_isBusy || _selectedSku is null || _manualQuantity is null)"
                                   OnClick="SaveManualQuantityAsync">
                            Сохранить
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudTable Items="_inventoryCount.Items.OrderBy(x => x.LineNumber)" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Товар</MudTh>
                <MudTh>Ожидается</MudTh>
                <MudTh>Фактически</MudTh>
                <MudTh>Разница</MudTh>
                @if (IsDraft) { <MudTh></MudTh> }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Товар">
                    <b>@context.StockKeepingUnit?.Name</b><br />
                    <MudText Typo="Typo.caption">
                        Код: @context.StockKeepingUnit?.Code · @context.StockKeepingUnit?.BaseUnitOfMeasure?.Description
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Ожидается">@FormatQuantity(context.ExpectedQuantity)</MudTd>
                <MudTd DataLabel="Фактически">
                    @if (IsDraft)
                    {
                        <MudNumericField T="decimal?"
                                         Value="context.CountedQuantity"
                                         ValueChanged="quantity => UpdateQuantityAsync(context, quantity)"
                                         Min="0"
                                         Disabled="@_isBusy"
                                         Placeholder="Не пересчитано"
                                         HideSpinButtons="true"
                                         Variant="Variant.Text" />
                    }
                    else
                    {
                        @FormatQuantity(context.CountedQuantity)
                    }
                </MudTd>
                <MudTd DataLabel="Разница">@FormatQuantity(context.DifferenceQuantity)</MudTd>
                @if (IsDraft)
                {
                    <MudTd>
                        @if (!context.IsExpected)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           Disabled="@_isBusy"
                                           OnClick="@(() => RemoveItemAsync(context))" />
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    </MudStack>
}
