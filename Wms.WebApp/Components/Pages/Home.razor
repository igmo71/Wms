@page "/"

<PageTitle>WMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">

    @* Hero *@
    <MudPaper Elevation="0" Class="pa-8 mb-6">
        <MudGrid Style="align-items: center;">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h3" GutterBottom="true">
                    Warehouse Management System
                </MudText>

                <MudText Typo="Typo.h5"
                         Color="Color.Secondary"
                         GutterBottom="true">
                    Управление складскими операциями и товарными запасами
                </MudText>

                <MudText Typo="Typo.body1" Class="mt-4">
                    WMS — информационная система для управления основными процессами склада:
                    от приёмки товара и размещения на хранение до перемещения,
                    инвентаризации, комплектации и отгрузки.
                </MudText>

                <MudText Typo="Typo.body1" Class="mt-3">
                    Система объединяет складскую топологию, номенклатуру,
                    оперативные документы и учёт товарных остатков в единой модели
                    и интегрируется с корпоративными информационными системами.
                </MudText>
            </MudItem>

            <MudItem xs="12" md="4" Class="d-flex justify-center">
                <MudIcon Icon="@Icons.Material.Filled.Warehouse"
                         Size="Size.Large"
                         Color="Color.Primary"
                         Style="font-size: 9rem;" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h5" GutterBottom="true">
        Основные возможности
    </MudText>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        В текущей версии реализованы основные справочные и складские операции,
        необходимые для ведения оперативного учёта.
    </MudText>

    <MudGrid>

        @* Receiving *@
        <MudItem xs="12" sm="6" lg="3">
            <MudCard Style="height: 100%;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.Assignment"
                             Size="Size.Large"
                             Color="Color.Primary"
                             Class="mb-3" />

                    <MudText Typo="Typo.h5" GutterBottom="true">
                        Приёмка
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Работа с приходными ордерами, контроль планового
                        и фактически принятого количества товара,
                        оформление поступления на склад.
                    </MudText>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Href="receiving-orders"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Перейти
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Shipping *@
        <MudItem xs="12" sm="6" lg="3">
            <MudCard Style="height: 100%;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping"
                             Size="Size.Large"
                             Color="Color.Primary"
                             Class="mb-3" />

                    <MudText Typo="Typo.h5" GutterBottom="true">
                        Отгрузка
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Расходные ордера, подготовка товара к отгрузке,
                        контроль исполнения заказа и движения товара
                        со склада.
                    </MudText>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Href="shipping-orders"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Перейти
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Inventory *@
        <MudItem xs="12" sm="6" lg="3">
            <MudCard Style="height: 100%;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.Inventory"
                             Size="Size.Large"
                             Color="Color.Primary"
                             Class="mb-3" />

                    <MudText Typo="Typo.h5" GutterBottom="true">
                        Запасы
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Остатки по складам и ячейкам, история движений,
                        складские перемещения, обороты и проведение
                        инвентаризаций.
                    </MudText>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Href="inventory-balances"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Остатки
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Topology *@
        <MudItem xs="12" sm="6" lg="3">
            <MudCard Style="height: 100%;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                             Size="Size.Large"
                             Color="Color.Primary"
                             Class="mb-3" />

                    <MudText Typo="Typo.h5" GutterBottom="true">
                        Структура склада
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Справочники складов, зон и ячеек хранения,
                        номенклатура, единицы измерения, штрихкоды
                        и направления доставки.
                    </MudText>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Href="storage-locations"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Ячейки
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

    </MudGrid>

    @* Additional capabilities *@
    <MudGrid Class="mt-4">

        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-5" Style="height: 100%;">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Sync"
                             Color="Color.Primary"
                             Class="mr-3" />
                    <MudText Typo="Typo.h6">
                        Интеграция с учётными системами
                    </MudText>
                </div>

                <MudText Typo="Typo.body2">
                    WMS взаимодействует с внешней учётной системой 1С,
                    получая необходимые справочные данные и складские документы.
                    Архитектура приложения разделяет складскую бизнес-логику
                    и интеграционные механизмы.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-5" Style="height: 100%;">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Devices"
                             Color="Color.Primary"
                             Class="mr-3" />
                    <MudText Typo="Typo.h6">
                        Единое рабочее пространство
                    </MudText>
                </div>

                <MudText Typo="Typo.body2">
                    Веб-интерфейс объединяет операции склада,
                    справочную информацию и контроль товарных запасов,
                    предоставляя сотрудникам единый интерфейс
                    для выполнения повседневных задач.
                </MudText>
            </MudPaper>
        </MudItem>

    </MudGrid>

    @* Dobroga *@
    <MudPaper Elevation="0"
              Outlined="true"
              Class="pa-5 mt-6">

        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Business"
                     Color="Color.Primary"
                     Size="Size.Large"
                     Class="mr-4" />

            <div>
                <MudText Typo="Typo.h6" GutterBottom="true">
                    Развитие на основе реальных складских процессов
                </MudText>

                <MudText Typo="Typo.body2">
                    Система развивается с учётом практических задач складской логистики.
                    Предприятие «Доброга» выбрано в качестве первой площадки внедрения WMS.
                </MudText>
            </div>
        </div>

    </MudPaper>

    <MudText Typo="Typo.caption"
             Color="Color.Secondary"
             Align="Align.Center"
             Class="mt-6 mb-2">
        WMS · Warehouse Management System
    </MudText>

</MudContainer>
