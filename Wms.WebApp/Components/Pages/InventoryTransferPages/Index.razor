@page "/inventory-transfers"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Перемещения</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Перемещения</MudText>
    <MudSpacer />
    <MudButton Href="inventory-transfers/new"
               Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        Новое перемещение
    </MudButton>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string"
                          @bind-Value="_searchString"
                          Label="Поиск по номеру"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="OnSearchChangedAsync"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="Дата с" Date="_dateFrom" DateChanged="OnDateFromChangedAsync" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="Дата по" Date="_dateTo" DateChanged="OnDateToChangedAsync" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudAutocomplete T="Warehouse"
                             Value="_warehouse"
                             ValueChanged="OnWarehouseChangedAsync"
                             SearchFunc="SearchWarehousesAsync"
                             ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                             Label="Склад"
                             Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="InventoryTransferStatus?"
                       Label="Статус"
                       Value="_status"
                       ValueChanged="OnStatusChangedAsync"
                       Clearable="true">
                @foreach (var status in Enum.GetValues<InventoryTransferStatus>())
                {
                    <MudSelectItem T="InventoryTransferStatus?" Value="@((InventoryTransferStatus?)status)">
                        @status.GetDisplayName()
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudDataGrid T="InventoryTransfer"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Номер" Sortable="true">
            <CellTemplate><MudLink Href="@GetTransferHref(context.Item)">@context.Item.Number</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Date" Title="Дата" Format="dd.MM.yyyy" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse!.Name" Title="Склад" Sortable="true" />
        <PropertyColumn Property="x => x.TransitStorageLocation!.Name" Title="Тележка" Sortable="true">
            <CellTemplate>@(context.Item.TransitStorageLocation?.Name ?? "—")</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Status" Title="Статус" Sortable="true">
            <CellTemplate>@context.Item.Status.GetDisplayName()</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.CreatedAtUtc" Title="Создано" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Открыть перемещение">
                    <MudIconButton Href="@GetTransferHref(context.Item)"
                                   Icon="@Icons.Material.Filled.OpenInNew"
                                   Color="Color.Primary" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="InventoryTransfer" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
