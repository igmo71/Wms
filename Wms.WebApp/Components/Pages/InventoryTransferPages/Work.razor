@page "/inventory-transfers/new"
@page "/inventory-transfers/{Id:guid}/work"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Перемещение</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">@Title</MudText>
        <MudSpacer />
        @if (ShowComplete)
        {
            <MudTooltip Text="@CompleteTooltip">
                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           Disabled="@(!CanComplete || _isSaving)"
                           StartIcon="@Icons.Material.Filled.Check"
                           OnClick="CompleteAsync">
                    Завершить
                </MudButton>
            </MudTooltip>
        }
        @if (CanDelete)
        {
            <MudButton Color="Color.Error"
                       Variant="Variant.Outlined"
                       Disabled="@_isSaving"
                       StartIcon="@Icons.Material.Filled.DeleteOutline"
                       OnClick="DeleteAsync">
                Удалить
            </MudButton>
        }
        <MudButton Href="inventory-transfers" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
            К списку
        </MudButton>
    </MudStack>

    @if (_operationFailed)
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (Id.HasValue && _transfer is null)
    {
        <MudAlert Severity="Severity.Warning">Перемещение не найдено.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3" md="2">
                    <MudText Typo="Typo.caption">Номер</MudText>
                    <MudText>@(_transfer?.Number ?? "Будет присвоен")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3" md="2">
                    <MudText Typo="Typo.caption">Создано</MudText>
                    <MudText>@FormatDateTimeOffset(_transfer?.CreatedAtUtc)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="Warehouse"
                                     Value="_warehouse"
                                     ValueChanged="SetWarehouseAsync"
                                     SearchFunc="SearchWarehousesAsync"
                                     ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                                     Label="Склад"
                                     Clearable="true"
                                     Margin="Margin.Dense"
                                     Disabled="@IsStarted"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="StorageLocation"
                                     @bind-Value="_transitStorageLocation"
                                     SearchFunc="SearchTransitStorageLocationsAsync"
                                     ToStringFunc="location => location?.Name ?? string.Empty"
                                     Label="Тележка"
                                     Clearable="true"
                                     Margin="Margin.Dense"
                                     Disabled="@(IsStarted || _warehouse is null)" />
                    @if (!IsStarted && _noAvailableTransitStorageLocations)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">Свободных пустых тележек нет.</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    @if (!IsStarted)
                    {
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="@(_warehouse is null || _isSaving)"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Size="Size.Small"
                                   OnClick="StartAsync">
                            Начать
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">Статус</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@_transfer!.Status.GetChipColor()">@_transfer.Status.GetDisplayName()</MudChip>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (HasTransit)
        {
            <MudTabs Elevation="0" Outlined="true" Rounded="true">
                <MudTabPanel Text="С тележкой">
                    <MudGrid Spacing="3" Class="pa-3">
                        <MudItem xs="12" lg="4">
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.h6">Отобрать на тележку</MudText>
                                <MudStack Spacing="2" Class="mt-3">
                                    <MudAutocomplete T="StorageLocation"
                                                     Value="_pickSource"
                                                     ValueChanged="SetPickSourceAsync"
                                                     SearchFunc="SearchStorageLocationsAsync"
                                                     ToStringFunc="location => location?.Name ?? string.Empty"
                                                     Label="Из ячейки"
                                                     Clearable="true"
                                                     Margin="Margin.Dense"
                                                     Disabled="@(!CanUseTransit || _isSaving)" />
                                    <MudSelect T="Guid?" @bind-Value="_pickSkuId" Label="Номенклатура"
                                               Disabled="@(!CanUseTransit || _isSaving || _pickSource is null)" Clearable="true" Margin="Margin.Dense">
                                        @foreach (var balance in _pickSourceBalances)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)balance.StockKeepingUnit.Id)">
                                                @balance.StockKeepingUnit.Name
                                                <MudText Typo="Typo.caption"> Остаток: @FormatQuantity(balance.Quantity)</MudText>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField T="double" @bind-Value="_pickQuantity" Label="Количество" Min="0" HideSpinButtons="true"
                                                     Disabled="@(!CanUseTransit || _isSaving)" Margin="Margin.Dense" />
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                               Disabled="@(!CanPick || _isSaving)" OnClick="PickAsync">
                                        Отобрать
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" lg="4">
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.h6">Разместить с тележки</MudText>
                                <MudStack Spacing="2" Class="mt-3">
                                    <MudSelect T="Guid?" @bind-Value="_putSkuId" Label="Номенклатура"
                                               Disabled="@(!CanPutAnything || _isSaving)" Clearable="true" Margin="Margin.Dense">
                                        @foreach (var balance in _transitBalances)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)balance.StockKeepingUnit.Id)">
                                                @balance.StockKeepingUnit.Name
                                                <MudText Typo="Typo.caption"> Остаток: @FormatQuantity(balance.Quantity)</MudText>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudAutocomplete T="StorageLocation"
                                                     @bind-Value="_putDestination"
                                                     SearchFunc="SearchStorageLocationsAsync"
                                                     ToStringFunc="location => location?.Name ?? string.Empty"
                                                     Label="В ячейку"
                                                     Clearable="true"
                                                     Margin="Margin.Dense"
                                                     Disabled="@(!CanPutAnything || _isSaving)" />
                                    <MudNumericField T="double" @bind-Value="_putQuantity" Label="Количество" Min="0" HideSpinButtons="true"
                                                     Disabled="@(!CanPutAnything || _isSaving)" Margin="Margin.Dense" />
                                    <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Unarchive"
                                               Disabled="@(!CanPut || _isSaving)" OnClick="PutAsync">
                                        Разместить
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" lg="4">
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.h6" GutterBottom="true">Остаток на тележке</MudText>
                                <MudTable Items="_transitBalances" Dense="true" Hover="true">
                                    <HeaderContent>
                                        <MudTh>Номенклатура</MudTh>
                                        <MudTh>Количество</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Номенклатура">@context.StockKeepingUnit.Name</MudTd>
                                        <MudTd DataLabel="Количество">@FormatQuantity(context.Quantity)</MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent><MudText Class="pa-3">Тележка пуста.</MudText></NoRecordsContent>
                                </MudTable>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Прямое перемещение">
                    <MudGrid Class="pa-3">
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.h6">Прямое перемещение</MudText>
                                <MudStack Spacing="2" Class="mt-3">
                                    <MudAutocomplete T="StorageLocation" Value="_directSource" ValueChanged="SetDirectSourceAsync" SearchFunc="SearchStorageLocationsAsync"
                                                     ToStringFunc="location => location?.Name ?? string.Empty" Label="Из ячейки"
                                                     Clearable="true" Margin="Margin.Dense"
                                                     Disabled="@(!CanEdit || _isSaving)" />
                                    <MudAutocomplete T="StorageLocation" @bind-Value="_directDestination" SearchFunc="SearchStorageLocationsAsync"
                                                     ToStringFunc="location => location?.Name ?? string.Empty" Label="В ячейку"
                                                     Clearable="true" Margin="Margin.Dense"
                                                     Disabled="@(!CanEdit || _isSaving)" />
                                    <MudSelect T="Guid?" @bind-Value="_directSkuId" Label="Номенклатура"
                                               Disabled="@(!CanEdit || _isSaving || _directSource is null)" Clearable="true" Margin="Margin.Dense">
                                        @foreach (var balance in _directSourceBalances)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)balance.StockKeepingUnit.Id)">
                                                @balance.StockKeepingUnit.Name
                                                <MudText Typo="Typo.caption"> Остаток: @FormatQuantity(balance.Quantity)</MudText>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField T="double" @bind-Value="_directQuantity" Label="Количество" Min="0" HideSpinButtons="true"
                                                     Disabled="@(!CanEdit || _isSaving)" Margin="Margin.Dense" />
                                    <MudButton Color="Color.Info" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                               Disabled="@(!CanMoveDirect || _isSaving)" OnClick="MoveDirectAsync">
                                        Переместить
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" md="6" lg="4">
                    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.h6">Прямое перемещение</MudText>
                        <MudStack Spacing="2" Class="mt-3">
                            <MudAutocomplete T="StorageLocation" Value="_directSource" ValueChanged="SetDirectSourceAsync" SearchFunc="SearchStorageLocationsAsync"
                                             ToStringFunc="location => location?.Name ?? string.Empty" Label="Из ячейки"
                                             Clearable="true" Margin="Margin.Dense"
                                             Disabled="@(!CanEdit || _isSaving)" />
                            <MudAutocomplete T="StorageLocation" @bind-Value="_directDestination" SearchFunc="SearchStorageLocationsAsync"
                                             ToStringFunc="location => location?.Name ?? string.Empty" Label="В ячейку"
                                             Clearable="true" Margin="Margin.Dense"
                                             Disabled="@(!CanEdit || _isSaving)" />
                            <MudSelect T="Guid?" @bind-Value="_directSkuId" Label="Номенклатура"
                                       Disabled="@(!CanEdit || _isSaving || _directSource is null)" Clearable="true" Margin="Margin.Dense">
                                @foreach (var balance in _directSourceBalances)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)balance.StockKeepingUnit.Id)">
                                        @balance.StockKeepingUnit.Name
                                        <MudText Typo="Typo.caption"> Остаток: @FormatQuantity(balance.Quantity)</MudText>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="double" @bind-Value="_directQuantity" Label="Количество" Min="0" HideSpinButtons="true"
                                             Disabled="@(!CanEdit || _isSaving)" Margin="Margin.Dense" />
                            <MudButton Color="Color.Info" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                       Disabled="@(!CanMoveDirect || _isSaving)" OnClick="MoveDirectAsync">
                                Переместить
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">История движений</MudText>
            <MudTable Items="_movements" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>№</MudTh>
                    <MudTh>Время</MudTh>
                    <MudTh>Из ячейки</MudTh>
                    <MudTh>В ячейку</MudTh>
                    <MudTh>Номенклатура</MudTh>
                    <MudTh>Количество</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="№">@context.RecorderLineNumber</MudTd>
                    <MudTd DataLabel="Время">@FormatDateTimeOffset(context.PostedAtUtc)</MudTd>
                    <MudTd DataLabel="Из ячейки">@context.SourceStorageLocation?.Name</MudTd>
                    <MudTd DataLabel="В ячейку">@context.DestinationStorageLocation?.Name</MudTd>
                    <MudTd DataLabel="Номенклатура">@context.StockKeepingUnit?.Name</MudTd>
                    <MudTd DataLabel="Количество">@FormatQuantity(context.Quantity)</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="pa-3">Движений пока нет.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudStack>
