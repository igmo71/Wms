@using Wms.Application.Users
@using Wms.Data

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value="_displayName"
                          Label="Отображаемое имя"
                          Required="true"
                          Immediate="true"
                          MaxLength="ApplicationUser.DisplayNameMaxLength" />
            <MudTextField T="string"
                          @bind-Value="_email"
                          Label="Email"
                          Required="true"
                          Immediate="true"
                          InputType="InputType.Email"
                          Disabled="@(User is not null)" />
            <MudSelect T="Guid?"
                       @bind-Value="_defaultWarehouseId"
                       Label="Склад по умолчанию"
                       Clearable="true"
                       Disabled="@(!_warehousesLoaded)">
                @foreach (var warehouse in _warehouses)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)warehouse.Id)">
                        @(warehouse.Name ?? warehouse.Id.ToString())
                    </MudSelectItem>
                }
            </MudSelect>
            @if (User is not null && User.DefaultWarehouseIsDeleted
                && _defaultWarehouseId == User.DefaultWarehouseId)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Назначенный склад «@(User.DefaultWarehouseName ?? User.DefaultWarehouseId.ToString())» недоступен. Выберите другой или очистите поле.
                </MudAlert>
            }
            @if (User is null)
            {
                <MudTextField T="string"
                              @bind-Value="_password"
                              Label="Начальный пароль"
                              Required="true"
                              Immediate="true"
                              InputType="InputType.Password" />
            }
            <MudSelect T="string"
                       @bind-SelectedValues="_roles"
                       MultiSelection="true"
                       Label="Роли"
                       Required="true">
                <MudSelectItem T="string" Value="@ApplicationRoles.Operator">Оператор</MudSelectItem>
                <MudSelectItem T="string" Value="@ApplicationRoles.Manager">Менеджер</MudSelectItem>
                <MudSelectItem T="string" Value="@ApplicationRoles.Administrator">Администратор</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption">Решение по количественному расхождению требует роли «Менеджер», в том числе для администратора.</MudText>
            @if (User is not null)
            {
                <MudText Typo="Typo.caption">После изменения ролей войдите в учетную запись заново, чтобы сразу применить новые права.</MudText>
                <MudSwitch T="bool"
                           @bind-Value="_isBlocked"
                           Color="Color.Error"
                           Label="Вход заблокирован" />
            }
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@IsSaveDisabled"
                   OnClick="SaveAsync">
            Сохранить
        </MudButton>
    </DialogActions>
</MudDialog>
