@page "/users"
@using Wms.Application.Users
@using Wms.Data
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]

<PageTitle>Пользователи</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Пользователи</MudText>
    <MudSpacer />
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="CreateUserAsync">
        Создать пользователя
    </MudButton>
</MudStack>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudTextField T="string"
                  Value="_searchString"
                  ValueChanged="OnSearchChangedAsync"
                  Label="Поиск по имени или email"
                  Immediate="true"
                  DebounceInterval="300"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" />
</MudPaper>

<MudDataGrid T="ApplicationUserListItem"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.DisplayName" Title="Отображаемое имя" Sortable="true" />
        <PropertyColumn Property="x => x.Email" Title="Email" Sortable="true" />
        <PropertyColumn Property="x => x.Role" Title="Роль" Sortable="true">
            <CellTemplate>@GetRoleName(context.Item.Role)</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Статус" Sortable="false">
            <CellTemplate>
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.Item.IsBlocked ? Color.Error : Color.Success)">
                    @(context.Item.IsBlocked ? "Заблокирован" : "Активен")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Редактировать">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => EditUserAsync(context.Item))" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ApplicationUserListItem" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
