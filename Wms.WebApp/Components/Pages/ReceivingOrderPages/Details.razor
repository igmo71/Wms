@page "/receiving-orders/{Id:guid}"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Domain.Enums
@using Wms.Common
@using Wms.Application.Receiving

<PageTitle>@(_order is null ? "Приходный ордер WMS" : $"Ордер WMS {_order.Number}")</PageTitle>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h5">Ордер WMS @_order.Number от @_order.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudText>
                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="ReloadAsync">Обновить</MudButton>
            </MudStack>
            <MudPaper Outlined="true" Class="pa-2 my-2">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="3"><MudText Typo="Typo.subtitle2">@(_order.WarehouseName ?? _order.WarehouseId.ToString())</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="3"><MudText Typo="Typo.subtitle2"><ReceivingStatusText Status="@_order.Status" /></MudText></MudItem>
                    <MudItem xs="12" sm="6" md="3"><MudText Typo="Typo.subtitle2">Место приёмки: @(_order.ReceivingLocationAddress ?? _order.ReceivingLocationId?.ToString() ?? "не выбрано")</MudText></MudItem>
                    <MudItem xs="12" sm="6" md="3"><MudText Typo="Typo.subtitle2">Приёмка: @_order.ActiveCycleNumber</MudText></MudItem>
                </MudGrid>
            </MudPaper>
            @if (_order.Status == ReceivingOrderStatus.InReceiving && _canManage)
            {
                @if (_order.Lpns.Any(x => x.Status == LicensePlateNumberStatus.Open))
                {
                    <MudText Class="mt-2">Перед завершением закройте или отмените открытые LPN.</MudText>
                }
                <MudButton Class="mt-2" Color="Color.Primary" Variant="Variant.Filled"
                           Disabled="@(_busy || _order.Lpns.Any(x => x.Status == LicensePlateNumberStatus.Open))"
                           OnClick="CompleteOrderAsync">Завершить ордер</MudButton>
            }
            @if (_order.Status == ReceivingOrderStatus.Received && _canManage)
            {
                <MudText Class="mt-2">Повторное открытие создаст новую приёмку без места приёмки и участников. Прежние данные сохранятся.</MudText>
                <MudButton Class="mt-2" Variant="Variant.Outlined" Disabled="_busy"
                           OnClick="ReopenOrderAsync">Начать новую приёмку</MudButton>
            }
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_lifecycleMessage))
        {
            <MudAlert Severity="Severity.Success">@_lifecycleMessage</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_sourceChangeMessage))
        {
            <MudAlert Severity="Severity.Success">@_sourceChangeMessage</MudAlert>
        }

        <ReceivingOrderDetailsView Order="_order" Sources="_sources"
                                   SourceHistory="_sourceHistory" SourceNames="_sourceNames"
                                   CanManage="_canManage" Busy="_busy"
                                   RefreshResult="_refreshResult" OnRefresh="RefreshSourcesAsync"
                                   OnChangeComposition="OpenSourceCompositionAsync" />

        <MudExpansionPanels Outlined="true" Elevation="0">
        <MudExpansionPanel HeaderClass="mud-elevation-1" @bind-Expanded="_showLpns">
            <TitleContent>
                <MudBadge Content="@_order.Lpns.Count" Color="Color.Default" Origin="Origin.CenterRight" BadgeClass="ms-3" Class="me-4">Приёмные LPN</MudBadge>
            </TitleContent>
            <ChildContent>
            @if (_order.Lpns.Count == 0)
            {
                <MudText>LPN пока нет.</MudText>
            }
            @if (_order.Lpns.Count > 0)
            {
                <MudTable T="ReceivingWorkLpnView" Items="SortedLpns" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>LPN</MudTh><MudTh>Статус</MudTh><MudTh>SKU</MudTh>
                        <MudTh>Срок годности</MudTh><MudTh>План</MudTh>
                        <MudTh>Факт по ордеру</MudTh><MudTh>Факт по LPN</MudTh><MudTh>Действия</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{ var item = context.Items.SingleOrDefault(); var orderItem = item is null ? null : _order.Items.FirstOrDefault(x => x.SkuId == item.SkuId); }
                        <MudTd DataLabel="LPN">
                            @if (context.Putaways.Count > 0 || _canManage && _deletionHistory.ContainsKey(context.Id))
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => ToggleLpnDetails(context.Id)">@context.Code</MudButton>
                            }
                            else
                            {
                                @context.Code
                            }
                        </MudTd>
                        <MudTd DataLabel="Статус"><ReceivingStatusText Status="@context.Status" /></MudTd>
                        <MudTd DataLabel="SKU">
                            @(item is null ? "—" : item.SkuName ?? item.SkuId.ToString())
                            @if (item is not null)
                            {
                                <MudText Typo="Typo.caption">@(item.UnitOfMeasure ?? "Ед. изм. неизвестна")</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Срок годности">@(item?.ExpirationDate?.ToString("dd.MM.yyyy") ?? (item is null ? "—" : "Не указан"))</MudTd>
                        <MudTd DataLabel="План">@(orderItem is null ? "—" : Format(orderItem.PlanQuantity))</MudTd>
                        <MudTd DataLabel="Факт по ордеру">@(orderItem is null ? "—" : orderItem.FactQuantity is null ? "Не проверено" : Format(orderItem.FactQuantity))</MudTd>
                        <MudTd DataLabel="Факт по LPN">@(item is null ? "—" : Format(item.Quantity))</MudTd>
                        <MudTd DataLabel="Действия">
                            @if (_canManage && _order.Status == ReceivingOrderStatus.InReceiving
                                && context.Status == LicensePlateNumberStatus.Open
                                && context.Items.Count == 1 && context.Items[0].Quantity > 0)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle"
                                           Disabled="_busy" OnClick="() => CloseLpnAsync(context)">Закрыть</MudButton>
                            }
                            @if (_canManage && context.Status == LicensePlateNumberStatus.Closed)
                            {
                                @if (context.Putaways.Count == 0 && context.Items.Count == 1)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" Disabled="_busy"
                                               OnClick="() => OpenCorrectionAsync(context)">Исправить</MudButton>
                                }
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline"
                                           Disabled="_busy" OnClick="() => OpenDeletionAsync(context)">Удалить</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent Context="lpn">
                        @if (_expandedLpnId == lpn.Id)
                        {
                            <MudTr>
                            <MudTd colspan="8">
                                @foreach (var item in lpn.Items)
                                {
                                    @if (lpn.Status != LicensePlateNumberStatus.Deleted)
                                    {
                                        <MudText>Размещено: @Format(item.PlacedQuantity) · Осталось: @Format(item.Quantity - item.PlacedQuantity) @(item.UnitOfMeasure ?? "ед. изм. неизвестна")</MudText>
                                    }
                                }
                                @if (lpn.Putaways.Count > 0)
                                {
                                    <MudTable T="ReceivingWorkPutawayView" Items="lpn.Putaways" Dense="true" Hover="true" Elevation="0">
                                        <HeaderContent><MudTh>Количество</MudTh><MudTh>Ячейка</MudTh><MudTh>Дата</MudTh><MudTh>Пользователь</MudTh></HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Количество">@Format(context.Quantity)</MudTd>
                                            <MudTd DataLabel="Ячейка">@(context.DestinationAddress ?? context.DestinationStorageLocationId.ToString())</MudTd>
                                            <MudTd DataLabel="Дата">@context.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                                            <MudTd DataLabel="Пользователь">@UserName(context.CreatedBy)</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                                @if (_canManage && _deletionHistory.TryGetValue(lpn.Id, out var history) && history.Count > 0)
                                {
                                    <MudText Typo="Typo.subtitle2">История удаления</MudText>
                                    <MudTable Items="history" Dense="true" Hover="true" Elevation="0">
                                        <HeaderContent><MudTh>Время</MudTh><MudTh>Пользователь</MudTh><MudTh>Откуда</MudTh><MudTh>Куда</MudTh><MudTh>SKU</MudTh><MudTh>Срок годности</MudTh><MudTh>Количество</MudTh></HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Время">@(context.PostedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</MudTd>
                                            <MudTd DataLabel="Пользователь">@UserName(context.ConfirmedBy)</MudTd>
                                            <MudTd DataLabel="Откуда">@(context.SourceAddress ?? "—")</MudTd>
                                            <MudTd DataLabel="Куда">@(context.DestinationAddress ?? "—")</MudTd>
                                            <MudTd DataLabel="SKU">@SkuName(context.SkuId)</MudTd>
                                            <MudTd DataLabel="Срок годности">@(context.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</MudTd>
                                            <MudTd DataLabel="Количество">@Format(context.Quantity)</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudTd>
                            </MudTr>
                        }
                    </ChildRowContent>
                </MudTable>
            }
            </ChildContent>
        </MudExpansionPanel>
        </MudExpansionPanels>

        <MudExpansionPanels Outlined="true" Elevation="0">
        <MudExpansionPanel HeaderClass="mud-elevation-1" @bind-Expanded="_showStages">
            <TitleContent>
                <MudBadge Content="@_order.Cycles.Count" Color="Color.Default" Origin="Origin.CenterRight" BadgeClass="ms-3" Class="me-4">Приёмки</MudBadge>
            </TitleContent>
            <ChildContent>
            @if (_order.Cycles.Count == 0)
            {
                <MudText>Приёмок пока нет.</MudText>
            }
            @foreach (var cycle in _order.Cycles)
            {
                <MudExpansionPanels Outlined="true" Elevation="0" Class="mt-3 mb-2">
                <MudExpansionPanel HeaderClass="mud-elevation-1">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
                            <MudText Typo="Typo.subtitle1">@StageTitle(cycle)</MudText>
                            <MudText Typo="Typo.body2">
                                Место приёмки: @(cycle.ReceivingLocationAddress ?? cycle.ReceivingLocationId?.ToString() ?? "не выбрано")
                                @if (cycle.CompletedAtUtc is not null)
                                {
                                    <span> · Завершил: @UserName(cycle.CompletedBy)</span>
                                }
                            </MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                    @if (cycle.CompletedAtUtc is not null)
                    {
                        @if (cycle.SourceCheckFailed)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-2">При завершении свежая сверка документов 1С не удалась.</MudAlert>
                        }
                        <MudTable T="ReceivingWorkCycleItemView" Items="SortedCycleItems(cycle)" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>SKU</MudTh><MudTh>План</MudTh><MudTh>Факт</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="SKU">@SkuName(context.SkuId)</MudTd>
                                <MudTd DataLabel="План">@(context.PlanQuantity?.ToString("0.###") ?? "Неизвестно")</MudTd>
                                <MudTd DataLabel="Факт">@(context.FactQuantity?.ToString("0.###") ?? "Не проверено")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    </ChildContent>
                </MudExpansionPanel>
                </MudExpansionPanels>
            }
            </ChildContent>
        </MudExpansionPanel>
        </MudExpansionPanels>
    </MudStack>
}
