@page "/receiving-orders/{Id:guid}"
@using Wms.Domain.Enums

<PageTitle>Приходный ордер</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else if (_order.Status == ReceivingOrderStatus.InReceiving)
{
    <ReceivingInProgressView Id="Id" OnCompleted="ReloadAfterCompletionAsync" />
}
else
{
    <ReceivingOrderDetailsView Id="Id" />
}
