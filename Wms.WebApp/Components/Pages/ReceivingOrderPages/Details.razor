@page "/receiving-orders/{Id:guid}"
@using Wms.Application
@using Wms.Common

<PageTitle>Детали приходного ордера</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">Приходный ордер @_order.Number</MudText>
            <MudSpacer />
            <MudButton Href="receiving-orders" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                К списку
            </MudButton>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Номер</MudText>
                    <MudText>@_order.Number</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Дата</MudText>
                    <MudText>@_order.DateTime.ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Статус</MudText>
                    <MudText>@_order.Status.GetDisplayName()</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Склад</MudText>
                    <MudText>@_order.WarehouseName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Место приёмки</MudText>
                    <MudText>@_order.ReceivingLocationName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">В работе с</MudText>
                    <MudText>@FormatDateTimeOffset(_order.StartedAtUtc)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Принят</MudText>
                    <MudText>@FormatDateTimeOffset(_order.CompletedAtUtc)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Комментарий</MudText>
                    <MudText>@_order.Comment</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudDataGrid T="ReceivingOrderItemDetails"
                     Items="_order.Items"
                     Hover="true"
                     Striped="true"
                     Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.LineNumber" Title="Строка" />
                <PropertyColumn Property="x => x.StockKeepingUnitName" Title="Номенклатура" />
                <PropertyColumn Property="x => x.PlanQuantity" Title="План" />
                <PropertyColumn Property="x => x.FactQuantity" Title="Факт" />
                <PropertyColumn Property="x => x.RemainingQuantity" Title="Осталось" />
                <PropertyColumn Property="x => x.Comment" Title="Комментарий" />
            </Columns>
        </MudDataGrid>
    </MudStack>
}
