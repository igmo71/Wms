@page "/receiving-orders/{Id:guid}"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Domain.Enums
@using Wms.Common

<PageTitle>Приходный ордер WMS</PageTitle>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Ордер WMS @(_order.Number ?? _order.Id.ToString())</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="ReloadAsync">Обновить</MudButton>
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        @if (_closeResult is not null)
        {
            <MudAlert Severity="@(_closeResult.SourceCheckSucceeded ? Severity.Success : Severity.Warning)">
                LPN закрыта. Использованный план: @Format(_closeResult.UsedPlan);
                факт SKU: @Format(_closeResult.TotalFact).
                @if (!_closeResult.SourceCheckSucceeded)
                {
                    <span>Сверка источников не подтверждена: @_closeResult.SourceCheckError</span>
                }
            </MudAlert>
        }

        <MudPaper Class="pa-4">
            <MudText>Склад: @_order.WarehouseId · Статус: @_order.Status.GetDisplayName()</MudText>
            <MudText>Цикл: @(_order.ActiveCycleNumber?.ToString() ?? "завершён") · Место приёмки: @(_order.ReceivingLocationId?.ToString() ?? "не выбрано")</MudText>
            <MudText Typo="Typo.caption">Завершение ордера не проводит товар. Приход возникает при закрытии каждой LPN.</MudText>
        </MudPaper>

        <ReceivingOrderDetailsView Order="_order" Sources="_sources"
                                   CanManage="_canManage" Busy="_busy"
                                   RefreshResult="_refreshResult" OnRefresh="RefreshSourcesAsync" />

        @if (_canManage)
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Добавить SKU из справочника</MudText>
                <MudStack Row="true" AlignItems="AlignItems.End">
                    <MudTextField T="string" @bind-Value="_skuSearch" Label="Наименование, код или штрихкод" />
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="SearchSkuAsync">Найти</MudButton>
                </MudStack>
                @foreach (var sku in _candidates)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudText>@(sku.Name ?? sku.SkuId.ToString()) · @sku.Code · @(sku.IsInOrder ? "уже в ордере" : "вне плана источников")</MudText>
                        <MudSpacer />
                        @if (!sku.IsInOrder)
                        {
                            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="() => AddSkuAsync(sku.SkuId)">Добавить</MudButton>
                        }
                    </MudStack>
                }
            </MudPaper>
        }

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Приёмные LPN</MudText>
            @if (_order.Lpns.Count == 0)
            {
                <MudText>Палет пока нет.</MudText>
            }
            @foreach (var lpn in _order.Lpns)
            {
                <MudPaper Class="pa-3 mb-2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">@lpn.Code · @lpn.Status.GetDisplayName()</MudText>
                        <MudSpacer />
                        @if (_canManage && lpn.Status == LicensePlateNumberStatus.Open)
                        {
                            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => PrepareClose(lpn.Id)">Закрыть LPN</MudButton>
                        }
                        @if (_canManage && lpn.Status == LicensePlateNumberStatus.Closed)
                        {
                            @if (lpn.Putaways.Count == 0 && lpn.Items.Count == 1)
                            {
                                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => PrepareCorrection(lpn)">Исправить количество</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="() => PreviewDeletionAsync(lpn.Id)">Предпросмотр удаления</MudButton>
                        }
                    </MudStack>
                    @foreach (var item in lpn.Items)
                    {
                        @if (lpn.Status == LicensePlateNumberStatus.Deleted)
                        {
                            <MudText Typo="Typo.caption">Состав до удаления</MudText>
                        }
                        <MudText>@(item.SkuName ?? item.SkuId.ToString()) · @Format(item.Quantity) @item.UnitOfMeasure · Срок годности: @(item.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</MudText>
                        @if (lpn.Status != LicensePlateNumberStatus.Deleted)
                        {
                            <MudText Typo="Typo.caption">Размещено: @Format(item.PlacedQuantity) @item.UnitOfMeasure · Осталось: @Format(item.Quantity - item.PlacedQuantity) @item.UnitOfMeasure</MudText>
                        }
                    }
                    @foreach (var putaway in lpn.Putaways)
                    {
                        <MudText Typo="Typo.caption">@(lpn.Status == LicensePlateNumberStatus.Deleted ? "Историческое размещение" : "Размещено") @Format(putaway.Quantity) → @putaway.DestinationStorageLocationId · @putaway.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                    @if (_closeLpnId == lpn.Id)
                    {
                        <MudDivider Class="my-2" />
                        <MudText>Перед закрытием WMS повторно сверит источники и проверит текущий план. Превышение или неизвестный план требует Manager.</MudText>
                        <label><input type="checkbox" @bind="_confirmExpired" /> Подтверждаю закрытие LPN с прошедшей датой, если она есть</label>
                        <MudTextField T="string" @bind-Value="_managerReason" Label="Причина менеджера (необязательно)" />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="CloseLpnAsync">Подтвердить закрытие</MudButton>
                    }
                    @if (_correctionLpnId == lpn.Id)
                    {
                        <MudDivider Class="my-2" />
                        <MudText>Поправка количества проводится в исходном месте приёмки. SKU и срок годности сохраняются.</MudText>
                        <MudNumericField T="decimal?" @bind-Value="_correctionQuantity" Label="Новое количество" Min="0" HideSpinButtons="true" />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                   Disabled="@(_busy || _correctionQuantity is null || _correctionQuantity < 0)"
                                   OnClick="CorrectLpnAsync">Провести поправку</MudButton>
                    }
                    @if (_deletionLpnId == lpn.Id && _deletionPreview is { } preview)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2">Обратные движения по исходным адресам</MudText>
                        <table class="mud-table mud-table-dense w-100">
                            <thead><tr><th>Откуда</th><th>Куда</th><th>SKU</th><th>Срок годности</th><th>Количество</th></tr></thead>
                            <tbody>
                            @foreach (var movement in preview.Reversals)
                            {
                                <tr>
                                    <td>@(movement.SourceAddress ?? "Вне склада")</td>
                                    <td>@(movement.DestinationAddress ?? "Вне склада")</td>
                                    <td>@SkuName(movement.StockKeepingUnitId)</td>
                                    <td>@(movement.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</td>
                                    <td>@Format(movement.Quantity)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Прогноз остатков после удаления</MudText>
                        <table class="mud-table mud-table-dense w-100">
                            <thead><tr><th>Ячейка</th><th>SKU</th><th>Срок годности</th><th>Сейчас</th><th>После</th></tr></thead>
                            <tbody>
                            @foreach (var balance in preview.Balances)
                            {
                                <tr>
                                    <td>@balance.Address</td>
                                    <td>@SkuName(balance.StockKeepingUnitId)</td>
                                    <td>@(balance.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</td>
                                    <td>@Format(balance.Before)</td>
                                    <td>
                                        @if (balance.After < 0)
                                        {
                                            <MudText Color="Color.Error">@Format(balance.After)</MudText>
                                        }
                                        else
                                        {
                                            @Format(balance.After)
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        @if (preview.RequiresNegativeConfirmation)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-2">После удаления появятся отрицательные остатки.</MudAlert>
                            <label><input type="checkbox" @bind="_confirmNegative" /> Подтверждаю отрицательные остатки по указанным ячейкам</label>
                        }
                        <MudButton Class="mt-2" Color="Color.Error" Variant="Variant.Filled"
                                   Disabled="@(_busy || preview.RequiresNegativeConfirmation && !_confirmNegative)"
                                   OnClick="DeleteLpnAsync">Подтвердить удаление LPN</MudButton>
                    }
                    @if (_canManage && lpn.Status == LicensePlateNumberStatus.Deleted
                        && _deletionHistory.TryGetValue(lpn.Id, out var history) && history.Count > 0)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2">История удаления · обратные движения</MudText>
                        <table class="mud-table mud-table-dense w-100">
                            <thead><tr><th>Время</th><th>Пользователь</th><th>Откуда</th><th>Куда</th><th>SKU</th><th>Срок годности</th><th>Количество</th><th>Исходное движение</th></tr></thead>
                            <tbody>
                            @foreach (var movement in history)
                            {
                                <tr>
                                    <td>@(movement.PostedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                    <td>@movement.ConfirmedBy</td>
                                    <td>@(movement.SourceAddress ?? "Вне склада")</td>
                                    <td>@(movement.DestinationAddress ?? "Вне склада")</td>
                                    <td>@SkuName(movement.SkuId)</td>
                                    <td>@(movement.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</td>
                                    <td>@Format(movement.Quantity)</td>
                                    <td>@movement.OriginalMovementId</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudStack>
}
