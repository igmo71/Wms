@page "/receiving-orders/{Id:guid}"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Domain.Enums
@using Wms.Common

<PageTitle>@(_order is null ? "Приходный ордер WMS" : $"Ордер WMS {_order.Number}")</PageTitle>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Ордер WMS @_order.Number</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="ReloadAsync">Обновить</MudButton>
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_lifecycleMessage))
        {
            <MudAlert Severity="Severity.Success">@_lifecycleMessage</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_sourceChangeMessage))
        {
            <MudAlert Severity="Severity.Success">@_sourceChangeMessage</MudAlert>
        }
        <MudPaper Class="pa-4">
            <MudText>Создан: @_order.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudText>
            <MudText>Склад: @(_order.WarehouseName ?? _order.WarehouseId.ToString()) · Статус: @_order.Status.GetDisplayName()</MudText>
            <MudText>Цикл: @_order.ActiveCycleNumber · Место приёмки: @(_order.ReceivingLocationAddress ?? _order.ReceivingLocationId?.ToString() ?? "не выбрано")</MudText>
            <MudText Typo="Typo.caption">Завершение ордера не проводит товар. Приход возникает при закрытии каждой LPN.</MudText>
            @if (_order.Status == ReceivingOrderStatus.InReceiving && _canManage)
            {
                @if (_order.Lpns.Any(x => x.Status == LicensePlateNumberStatus.Open))
                {
                    <MudText Class="mt-2">Перед завершением закройте или отмените открытые LPN в мобильном приложении.</MudText>
                }
                <MudButton Class="mt-2" Color="Color.Primary" Variant="Variant.Filled"
                           Disabled="@(_busy || _order.Lpns.Any(x => x.Status == LicensePlateNumberStatus.Open))"
                           OnClick="CompleteOrderAsync">Завершить ордер</MudButton>
            }
            @if (_order.Status == ReceivingOrderStatus.Received && _canManage)
            {
                <MudText Class="mt-2">Повторное открытие создаст новый цикл без места приёмки и участников. Прежний снимок сохранится.</MudText>
                <MudButton Class="mt-2" Variant="Variant.Outlined" Disabled="_busy"
                           OnClick="ReopenOrderAsync">Открыть новый цикл</MudButton>
            }
        </MudPaper>

        <ReceivingOrderDetailsView Order="_order" Sources="_sources"
                                   CanManage="_canManage" Busy="_busy"
                                   RefreshResult="_refreshResult" OnRefresh="RefreshSourcesAsync"
                                   OnChangeComposition="OpenSourceCompositionAsync" />

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Приёмные LPN</MudText>
            @if (_order.Lpns.Count == 0)
            {
                <MudText>Палет пока нет.</MudText>
            }
            @foreach (var lpn in _order.Lpns)
            {
                <MudPaper Class="pa-3 mb-2" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">@lpn.Code · @lpn.Status.GetDisplayName()</MudText>
                        <MudSpacer />
                        @if (_canManage && lpn.Status == LicensePlateNumberStatus.Closed)
                        {
                            @if (lpn.Putaways.Count == 0 && lpn.Items.Count == 1)
                            {
                                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => PrepareCorrection(lpn)">Исправить количество</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="() => PreviewDeletionAsync(lpn.Id)">Предпросмотр удаления</MudButton>
                        }
                    </MudStack>
                    @foreach (var item in lpn.Items)
                    {
                        @if (lpn.Status == LicensePlateNumberStatus.Deleted)
                        {
                            <MudText Typo="Typo.caption">Состав до удаления</MudText>
                        }
                        <MudText>@(item.SkuName ?? item.SkuId.ToString()) · @Format(item.Quantity) @item.UnitOfMeasure · Срок годности: @(item.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</MudText>
                        @if (lpn.Status != LicensePlateNumberStatus.Deleted)
                        {
                            <MudText Typo="Typo.caption">Размещено: @Format(item.PlacedQuantity) @item.UnitOfMeasure · Осталось: @Format(item.Quantity - item.PlacedQuantity) @item.UnitOfMeasure</MudText>
                        }
                    }
                    @foreach (var putaway in lpn.Putaways)
                    {
                        <MudText Typo="Typo.caption">@(lpn.Status == LicensePlateNumberStatus.Deleted ? "Историческое размещение" : "Размещено") @Format(putaway.Quantity) → @(putaway.DestinationAddress ?? putaway.DestinationStorageLocationId.ToString()) · @putaway.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    }
                    @if (_canManage && _correctionLpnId == lpn.Id)
                    {
                        <MudDivider Class="my-2" />
                        <MudText>Поправка количества проводится в исходном месте приёмки. SKU и срок годности сохраняются.</MudText>
                        <MudNumericField T="decimal?" @bind-Value="_correctionQuantity" Label="Новое количество" Min="0" HideSpinButtons="true" />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                   Disabled="@(_busy || _correctionQuantity is null || _correctionQuantity < 0)"
                                   OnClick="CorrectLpnAsync">Провести поправку</MudButton>
                    }
                    @if (_canManage && _deletionLpnId == lpn.Id && _deletionPreview is { } preview)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2">Обратные движения по исходным адресам</MudText>
                        <MudTable Items="preview.Reversals" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>Откуда</MudTh><MudTh>Куда</MudTh><MudTh>SKU</MudTh><MudTh>Срок годности</MudTh><MudTh>Количество</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Откуда">@(context.SourceAddress ?? "Вне склада")</MudTd>
                                <MudTd DataLabel="Куда">@(context.DestinationAddress ?? "Вне склада")</MudTd>
                                <MudTd DataLabel="SKU">@SkuName(context.StockKeepingUnitId)</MudTd>
                                <MudTd DataLabel="Срок годности">@(context.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</MudTd>
                                <MudTd DataLabel="Количество">@Format(context.Quantity)</MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Прогноз остатков после удаления</MudText>
                        <MudTable Items="preview.Balances" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>Ячейка</MudTh><MudTh>SKU</MudTh><MudTh>Срок годности</MudTh><MudTh>Сейчас</MudTh><MudTh>После</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Ячейка">@context.Address</MudTd>
                                <MudTd DataLabel="SKU">@SkuName(context.StockKeepingUnitId)</MudTd>
                                <MudTd DataLabel="Срок годности">@(context.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</MudTd>
                                <MudTd DataLabel="Сейчас">@Format(context.Before)</MudTd>
                                <MudTd DataLabel="После">
                                    @if (context.After < 0)
                                    {
                                        <MudText Color="Color.Error">@Format(context.After)</MudText>
                                    }
                                    else
                                    {
                                        @Format(context.After)
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        @if (preview.RequiresNegativeConfirmation)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-2">После удаления появятся отрицательные остатки.</MudAlert>
                            <MudCheckBox T="bool" @bind-Value="_confirmNegative" Label="Подтверждаю отрицательные остатки по указанным ячейкам" />
                        }
                        <MudButton Class="mt-2" Color="Color.Error" Variant="Variant.Filled"
                                   Disabled="@(_busy || preview.RequiresNegativeConfirmation && !_confirmNegative)"
                                   OnClick="DeleteLpnAsync">Подтвердить удаление LPN</MudButton>
                    }
                    @if (_canManage && lpn.Status == LicensePlateNumberStatus.Deleted
                        && _deletionHistory.TryGetValue(lpn.Id, out var history) && history.Count > 0)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2">История удаления · обратные движения</MudText>
                        <MudTable Items="history" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>Время</MudTh><MudTh>Пользователь</MudTh><MudTh>Откуда</MudTh><MudTh>Куда</MudTh><MudTh>SKU</MudTh><MudTh>Срок годности</MudTh><MudTh>Количество</MudTh><MudTh>Исходное движение</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Время">@(context.PostedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</MudTd>
                                <MudTd DataLabel="Пользователь">@context.ConfirmedBy</MudTd>
                                <MudTd DataLabel="Откуда">@(context.SourceAddress ?? "Вне склада")</MudTd>
                                <MudTd DataLabel="Куда">@(context.DestinationAddress ?? "Вне склада")</MudTd>
                                <MudTd DataLabel="SKU">@SkuName(context.SkuId)</MudTd>
                                <MudTd DataLabel="Срок годности">@(context.ExpirationDate?.ToString("dd.MM.yyyy") ?? "Не указан")</MudTd>
                                <MudTd DataLabel="Количество">@Format(context.Quantity)</MudTd>
                                <MudTd DataLabel="Исходное движение">@context.OriginalMovementId</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudStack>
}
