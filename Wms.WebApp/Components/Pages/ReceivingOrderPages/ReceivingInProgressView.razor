@using Wms.Domain.Enums

@if (_completeFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="2">
        <ReceivingOrderHeader Order="_order"
                              UserNames="_userNames"
                              ActionHint="@(_pendingCompletion is null && !_isCompleting ? CompletionBlockReason : null)">
            <Actions>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@(_pendingCompletion is null && CompletionLocked)"
                           StartIcon="@Icons.Material.Filled.Check"
                           OnClick="SetReceivedAsync">
                    @(_pendingCompletion is null ? "Завершить" : "Повторить завершение")
                </MudButton>
            </Actions>
        </ReceivingOrderHeader>

        @if (_isCompleting)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.caption">Выполняется свежая сверка и атомарный приход…</MudText>
        }

        @if (!string.IsNullOrWhiteSpace(_synchronizationErrorMessage))
        {
            <MudAlert Severity="Severity.Error">@_synchronizationErrorMessage</MudAlert>
        }

        <ReceivingOrderDiscrepancies Order="_order"
                                     Assessment="_synchronizationAssessment"
                                     UserNames="_userNames"
                                     IsAcknowledging="true" />

        <ReceivingOrderDecisionReason Order="_order"
                                      RequiresManager="@(_completionReconciliation?.RequiresManager == true)"
                                      CanApproveQuantityDifference="_canApproveQuantityDifference"
                                      @bind-ManagerReason="_managerReason"
                                      IsCompleting="_isCompleting"
                                      HasPendingCompletion="@(_pendingCompletion is not null)" />

        <ReceivingOrderContents Order="_order"
                                UserNames="_userNames"
                                ShowCurrentPlan="true"
                                CurrentPlanQuantity="CurrentPlanQuantity" />
    </MudStack>
}
