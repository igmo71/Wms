@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<MudTabs Elevation="0" Outlined="true" Rounded="true">
    <MudTabPanel Text="Номенклатура">
        <MudDataGrid T="ReceivingOrderItem"
                     Items="Order.Items.OrderBy(x => x.LineNumber)"
                     Hover="true"
                     Dense="true"
                     Class="pa-2">
            <Columns>
                <PropertyColumn Property="x => x.LineNumber" Title="№" />
                <PropertyColumn Property="x => x.StockKeepingUnit == null ? string.Empty : x.StockKeepingUnit.Name" Title="Номенклатура" />
                <TemplateColumn Title="Ед изм">
                    <CellTemplate>@UnitName(context.Item.StockKeepingUnit)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.PlanQuantity" Title="@PlanColumnTitle" Format="N3" />
                @if (_showSeparatePlans)
                {
                    <TemplateColumn Title="План 1С">
                        <CellTemplate>@FormatQuantity(CurrentPlanQuantity?.Invoke(context.Item))</CellTemplate>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Факт">
                    <CellTemplate>@FormatQuantity(context.Item.FactQuantity, "Не проверено")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Фактический вес">
                    <CellTemplate>@WeightDisplay.Format(context.Item.FactWeightKg)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Осталось">
                    <CellTemplate>@FormatQuantity(context.Item.RemainingQuantity)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Comment" Title="Комментарий" />
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="Палеты"
                 BadgeData="@OpenPalletBadge"
                 BadgeColor="Color.Warning"
                 Disabled="@(Order.LicensePlateNumbers.Count == 0)">
        @if (Order.LicensePlateNumbers.Count == 0)
        {
            <MudText Class="pa-3">К ордеру не привязаны палеты.</MudText>
        }
        else
        {
            <MudGrid Spacing="2" Class="pa-2">
                <MudItem xs="12" md="4" lg="3">
                    <MudStack Spacing="1">
                        @foreach (var pallet in OrderedPallets)
                        {
                            <MudPaper Class="pa-2"
                                      Elevation="0"
                                      Outlined="true"
                                      Style="@PalletStyle(pallet)"
                                      @onclick="() => SelectPallet(pallet.Id)">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@pallet.Code</MudText>
                                    <MudSpacer />
                                    <MudChip T="string" Size="Size.Small">@pallet.Status.GetDisplayName()</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.caption">@GetUserName(pallet.ResponsibleUserId)</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="8" lg="9">
                    @if (SelectedPallet is { } selected)
                    {
                        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                <MudText Typo="Typo.h6">@selected.Code</MudText>
                                <MudChip T="string" Size="Size.Small">@selected.Status.GetDisplayName()</MudChip>
                                <MudText Typo="Typo.body2">@GetUserName(selected.ResponsibleUserId)</MudText>
                            </MudStack>

                            @if (selected.Items.Count == 0)
                            {
                                <MudText>В палете нет строк номенклатуры.</MudText>
                            }
                            else
                            {
                                <MudDataGrid T="LicensePlateNumberItem"
                                             Items="selected.Items.OrderByDescending(x => x.UpdatedAtUtc ?? x.CreatedAtUtc)"
                                             Hover="true"
                                             Dense="true">
                                    <Columns>
                                        <TemplateColumn Title="Номенклатура"><CellTemplate>@context.Item.StockKeepingUnit?.Name</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Ед изм"><CellTemplate>@UnitName(context.Item)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Количество"><CellTemplate>@FormatQuantity(context.Item.Quantity)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Состояние"><CellTemplate>@(context.Item.IsDeleted ? "Удалено" : "В составе")</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Создал"><CellTemplate>@GetUserName(context.Item.CreatedBy)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Изменил"><CellTemplate>@GetUserName(context.Item.UpdatedBy)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Удалил"><CellTemplate>@GetUserName(context.Item.DeletedBy)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Последнее действие"><CellTemplate>@((context.Item.UpdatedAtUtc ?? context.Item.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm"))</CellTemplate></TemplateColumn>
                                    </Columns>
                                </MudDataGrid>
                            }

                            @if (selected.Putaways.Count > 0)
                            {
                                <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">История размещения</MudText>
                                <MudDataGrid T="LicensePlateNumberPutaway"
                                             Items="selected.Putaways.OrderByDescending(x => x.CreatedAtUtc)"
                                             Hover="true"
                                             Dense="true">
                                    <Columns>
                                        <TemplateColumn Title="Номенклатура"><CellTemplate>@context.Item.StockKeepingUnit.Name</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Количество"><CellTemplate>@FormatQuantity(context.Item.Quantity)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Назначение"><CellTemplate>@Destination(context.Item)</CellTemplate></TemplateColumn>
                                        <TemplateColumn Title="Исполнитель"><CellTemplate>@GetUserName(context.Item.CreatedBy)</CellTemplate></TemplateColumn>
                                        <PropertyColumn Property="x => x.CreatedAtUtc" Title="Проведено" Format="dd.MM.yyyy HH:mm" />
                                        <TemplateColumn Title="Движение"><CellTemplate><MudLink Href="@($"inventory-movements?search={context.Item.InventoryMovementId}")">@context.Item.InventoryMovementId</MudLink></CellTemplate></TemplateColumn>
                                    </Columns>
                                </MudDataGrid>
                            }
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>
</MudTabs>
