@page "/receiving-sources"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Application.Receiving

<PageTitle>Документы 1С для приёмки</PageTitle>

<div class="receiving-sources-page">
<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">Документы 1С для приёмки</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="_busy">Обновить</MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    <MudGrid>
    <MudItem xs="12" lg="7">
    <MudPaper Class="pa-4">
        <MudTextField T="string" @bind-Value="_sourceFilter" Immediate="true"
                      Label="Поиск по номеру документа 1С" Class="mb-3" />
        @if (_busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (!FilteredSources.Any())
        {
            <MudText>Документы не найдены.</MudText>
        }
        else
        {
            <MudTable T="ReceivingSourceView" Items="FilteredSources" Dense="true" Hover="true"
                      Class="source-list" Elevation="0" RowsPerPage="15" OnRowClick="OnSourceRowClick"
                      RowClassFunc="SourceRowClass">
                <HeaderContent>
                    <MudTh>Документ 1С</MudTh>
                    <MudTh>Отправитель / склад</MudTh>
                    <MudTh>Сверка</MudTh>
                    <MudTh>Состояние</MudTh>
                    <MudTh>Ордер WMS</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Документ 1С">
                        <MudText>@(context.Number ?? context.RefKey.ToString())</MudText>
                        <MudText Typo="Typo.caption">@SourceDate(context.Date)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Отправитель / склад">
                        <MudText>@(context.SenderName ?? context.Sender ?? "—")</MudText>
                        <MudText Typo="Typo.caption">@(context.WarehouseName ?? context.WarehouseId?.ToString() ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Сверка">
                        @if (context.LastAttemptError is not null)
                        {
                            <MudText Color="Color.Error">@context.LastAttemptError</MudText>
                        }
                        else
                        {
                            <MudText>@(context.LastSuccessfulCheckAtUtc is null ? "Не сверен" : "Успешно")</MudText>
                        }
                        <MudText Typo="Typo.caption">@(context.LastAttemptAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Состояние">@SourceStatus(context)</MudTd>
                    <MudTd DataLabel="Ордер WMS">
                        @if (context.LinkedOrderId is Guid orderId)
                        {
                            <span @onclick:stopPropagation="true">
                                <MudLink Href="@($"receiving-orders/{orderId}")">@(context.LinkedOrderNumber ?? "Открыть ордер")</MudLink>
                            </span>
                        }
                        else if (_canManage)
                        {
                            <div @onclick:stopPropagation="true">
                                <MudCheckBox T="bool" Value="@_selected.Contains(context.RefKey)"
                                             ValueChanged="@(value => ToggleSource(context.RefKey, value))" />
                            </div>
                        }
                        else
                        {
                            <MudText>Свободен</MudText>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
    </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-4">
            @if (_selected.Count > 0)
            {
                <MudTable T="SourcePlanRow" Items="SelectedPlan" Dense="true" Elevation="0" RowsPerPage="15">
                    <HeaderContent>
                        <MudTh>Номенклатура</MudTh>
                        <MudTh>План</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Номенклатура">@SkuName(context.SkuId)</MudTd>
                        <MudTd DataLabel="План">@(context.Quantity?.ToString("0.###") ?? "Неизвестно")</MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
                @if (SelectedSources.Any(x => x.HasUnknownSku))
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        В источниках есть строки без определённого SKU или количества.
                    </MudAlert>
                }
                @if (SelectedSources.Select(x => x.WarehouseId).Distinct().Count() != 1)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        Выбранные документы относятся к разным складам.
                    </MudAlert>
                }
                @if (_canManage)
                {
                    <MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled"
                               Disabled="@(_busy || !CanCreate)" OnClick="CreateAsync">
                        Создать ордер WMS
                    </MudButton>
                }
            }
            else if (ActiveSource is { } source)
            {
                @if (source.VersionId is null)
                {
                    <MudText>Документ ещё не сверен с 1С.</MudText>
                }
                else if (source.Lines.Count == 0)
                {
                    <MudText>В последней сохранённой версии нет строк номенклатуры.</MudText>
                }
                else
                {
                    <MudTable T="ReceivingSourceLineView" Items="SortedSourceLines(source)" Dense="true" Elevation="0" RowsPerPage="15">
                        <HeaderContent>
                            <MudTh>№</MudTh>
                            <MudTh>Номенклатура</MudTh>
                            <MudTh>Количество 1С</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="№">@context.LineNumber</MudTd>
                            <MudTd DataLabel="Номенклатура">
                                <MudText>@SourceSkuName(source, context)</MudText>
                                @if (context.Error is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Количество 1С">
                                @(context.Quantity?.ToString("0.###") ?? "Неизвестно")
                                @if (context.Quantity is null && context.RawQuantity is not null)
                                {
                                    <MudText Typo="Typo.caption">Исходное: @context.RawQuantity</MudText>
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager /></PagerContent>
                    </MudTable>
                }
            }
            else
            {
                <MudText>Нажмите на документ, чтобы увидеть его состав, или выберите свободные документы галками.</MudText>
            }
        </MudPaper>
    </MudItem>
    </MudGrid>
</MudStack>
</div>
