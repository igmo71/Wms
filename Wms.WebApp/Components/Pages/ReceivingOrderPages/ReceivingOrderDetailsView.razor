@using Wms.Application.Receiving

<MudExpansionPanels Outlined="true" Elevation="0">
<MudExpansionPanel HeaderClass="mud-elevation-1" @bind-Expanded="_showDocuments">
    <TitleContent>
        <MudBadge Content="@Sources.Count" Color="Color.Default" Origin="Origin.CenterRight" BadgeClass="ms-3" Class="me-4">Документы 1С</MudBadge>
    </TitleContent>
    <ChildContent>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2 mb-2">
        <MudSpacer />
        @if (CanManage && CanChange)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(Busy || !OnChangeComposition.HasDelegate)"
                       OnClick="() => OnChangeComposition.InvokeAsync()">
                Изменить состав
            </MudButton>
            <MudTooltip Text="Показано время последней попытки среди документов ордера. Нажмите, чтобы заново сверить каждый присоединённый документ с 1С.">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="Busy" OnClick="() => OnRefresh.InvokeAsync()">
                    Последняя сверка: @LastAttemptText
                </MudButton>
            </MudTooltip>
        }
    </MudStack>
    @if (Sources.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">Действующих документов 1С нет. Текущий план известных SKU равен нулю.</MudAlert>
    }
    @if (RefreshResult is { } result)
    {
        <MudAlert Severity="@(result.AllSucceeded ? Severity.Success : Severity.Warning)" Class="mb-2">
            @if (!result.HasSources)
            {
                <span>Сверять нечего: у ордера нет действующих документов 1С.</span>
            }
            else if (result.AllSucceeded)
            {
                <span>Все документы 1С успешно сверены.</span>
            }
            else
            {
                <span>Сверка завершена с ошибками. Последний успешный план сохранён.</span>
            }
        </MudAlert>
    }
    @if (Sources.Count > 0)
    {
        <MudTable T="ReceivingSourceView" Items="SortedSources" Dense="true" Hover="true" Striped="true" Elevation="0">
            <HeaderContent><MudTh>Номер</MudTh><MudTh>Дата</MudTh><MudTh>Отправитель</MudTh><MudTh>Склад</MudTh><MudTh>Складская операция</MudTh><MudTh>Хозяйственная операция</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Номер"><MudLink Href="@($"receiving-sources?document={context.RefKey}")">@(context.Number ?? context.RefKey.ToString())</MudLink></MudTd>
                <MudTd DataLabel="Дата">@SourceDate(context.Date)</MudTd>
                <MudTd DataLabel="Отправитель">@(context.SenderName ?? context.Sender ?? "—")</MudTd>
                <MudTd DataLabel="Склад">@(context.WarehouseName ?? context.WarehouseId?.ToString() ?? "—")</MudTd>
                <MudTd DataLabel="Складская операция">@(context.WarehouseOperation ?? "—")</MudTd>
                <MudTd DataLabel="Хозяйственная операция">@(context.BusinessOperation ?? "—")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    </ChildContent>
</MudExpansionPanel>
</MudExpansionPanels>

@if (SourceHistory.Count > 0)
{
    <MudExpansionPanels Outlined="true" Elevation="0" Class="mt-3">
    <MudExpansionPanel Text="История связей с документами 1С" HeaderClass="mud-elevation-1" @bind-Expanded="_showSourceHistory">
            <MudTable T="ReceivingSourceChangeHistoryView" Items="SourceHistory" Dense="true" Hover="true" Elevation="0">
                <HeaderContent><MudTh>Время</MudTh><MudTh>Действие</MudTh><MudTh>Документ 1С</MudTh><MudTh>Исполнитель</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Время">@context.OccurredAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Действие">@(context.Detached ? "Откреплён" : "Прикреплён")</MudTd>
                    <MudTd DataLabel="Документ 1С">@(SourceNames.GetValueOrDefault(context.SourceRefKey) ?? context.SourceRefKey.ToString())</MudTd>
                    <MudTd DataLabel="Исполнитель">@context.Actor</MudTd>
                </RowTemplate>
            </MudTable>
    </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReceivingSourceView> Sources { get; set; } = [];
    [Parameter] public IReadOnlyList<ReceivingSourceChangeHistoryView> SourceHistory { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<Guid, string> SourceNames { get; set; } = new Dictionary<Guid, string>();
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public bool CanChange { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public ReceivingOrderRefreshResult? RefreshResult { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnChangeComposition { get; set; }

    private string LastAttemptText => Sources.Count == 0 ? "нет"
        : Sources.Max(source => source.LastAttemptAtUtc)?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "нет";

    private IEnumerable<ReceivingSourceView> SortedSources => Sources
        .OrderBy(source => string.IsNullOrWhiteSpace(source.Number))
        .ThenBy(source => source.Number, StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(source => source.RefKey);

    private bool _showDocuments;
    private bool _showSourceHistory;

    private static string SourceDate(string? value) =>
        DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date)
            ? date.ToString("dd.MM.yyyy") : value ?? "—";
}
