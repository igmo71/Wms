@using Wms.Domain
@using Wms.Domain.Enums

@if (Order.Status == ReceivingOrderStatus.InReceiving && RequiresManager)
{
    @if (CanApproveQuantityDifference)
    {
        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1">Подтверждение</MudText>
            <MudTextField T="string"
                          Label="Подтвердить приёмку"
                          Value="ManagerReason"
                          ValueChanged="ManagerReasonChanged"
                          Disabled="@(IsCompleting || HasPendingCompletion)"
                          Required="true"
                          Lines="2"
                          Variant="Variant.Outlined" />
        </MudPaper>
    }
}
else if (Order.CompletionApprovedAtUtc is not null)
{
    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle1">Подтверждение</MudText>
        <MudText>@Order.CompletionApprovalReason</MudText>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public ReceivingOrder Order { get; set; } = null!;
    [Parameter] public bool RequiresManager { get; set; }
    [Parameter] public bool CanApproveQuantityDifference { get; set; }
    [Parameter] public string? ManagerReason { get; set; }
    [Parameter] public EventCallback<string?> ManagerReasonChanged { get; set; }
    [Parameter] public bool IsCompleting { get; set; }
    [Parameter] public bool HasPendingCompletion { get; set; }
}
