@page "/receiving-orders"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Domain.Enums
@using Wms.Common
@using Wms.Application.Receiving

<PageTitle>Ордера WMS</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">Приходные ордера WMS</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="_busy">Обновить</MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    <MudPaper Class="pa-4">
        <MudTextField T="string" @bind-Value="_orderFilter" Immediate="true"
                      Label="Поиск по номеру ордера WMS" Class="mb-3" />
        @if (_busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (!FilteredOrders.Any())
        {
            <MudText>Ордеров нет.</MudText>
        }
        else
        {
            <MudTable T="ReceivingWorkOrderView" Items="FilteredOrders" Dense="true" Hover="true"
                      Striped="true" Elevation="0" RowsPerPage="15">
                <HeaderContent><MudTh>Номер WMS</MudTh><MudTh>Создан</MudTh><MudTh>Склад</MudTh><MudTh>Статус</MudTh><MudTh>Источников</MudTh><MudTh>Строк</MudTh><MudTh>Расхождения и непроверенные SKU</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Номер WMS"><MudLink Href="@($"receiving-orders/{context.Id}")">@context.Number</MudLink></MudTd>
                    <MudTd DataLabel="Создан">@context.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Склад">@(context.WarehouseName ?? context.WarehouseId.ToString())</MudTd>
                    <MudTd DataLabel="Статус">@context.Status.GetDisplayName()</MudTd>
                    <MudTd DataLabel="Источников">@context.SourceRefKeys.Count</MudTd>
                    <MudTd DataLabel="Строк">@context.Items.Count</MudTd>
                    <MudTd DataLabel="Расхождения и непроверенные SKU">@context.CurrentDiscrepancyCount
                        @if (context.HasNewDiscrepancyAfterCompletion)
                        {
                            <MudText Color="Color.Warning">Новое после завершения</MudText>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
    </MudPaper>
</MudStack>
