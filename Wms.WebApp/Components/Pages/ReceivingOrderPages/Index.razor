@page "/receiving-orders"
@using Wms.Domain
@using Wms.Common
@using Wms.Domain.Enums

<PageTitle>Приходные ордера</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Приходные ордера</MudText>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row>
        <MudTextField T="string"
                      @bind-Value="_searchString"
                      Label="Поиск по номеру"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="OnSearchChangedAsync"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" />
        <MudDatePicker Label="Дата с"
                       Date="_dateFrom"
                       DateChanged="OnDateFromChangedAsync"
                       Clearable="true"
                       Class="ml-4" />
        <MudDatePicker Label="Дата по"
                       Date="_dateTo"
                       DateChanged="OnDateToChangedAsync"
                       Clearable="true"
                       Class="ml-4" />
        <MudAutocomplete T="Warehouse"
                         Value="_warehouse"
                         ValueChanged="OnWarehouseChangedAsync"
                         SearchFunc="SearchWarehousesAsync"
                         ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                         Label="Склад"
                         Clearable="true"
                         Class="ml-4" />
        <MudSelect T="WarehouseOperation?"
                   Label="Складская операция"
                   Value="_warehouseOperation"
                   ValueChanged="OnWarehouseOperationChangedAsync"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var warehouseOperation in Enum.GetValues<WarehouseOperation>())
            {
                <MudSelectItem T="WarehouseOperation?" Value="@((WarehouseOperation?)warehouseOperation)">
                    @warehouseOperation.GetDisplayName()
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="ReceivingOrderStatus?"
                   Label="Статус"
                   Value="_status"
                   ValueChanged="OnStatusChangedAsync"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var status in Enum.GetValues<ReceivingOrderStatus>())
            {
                <MudSelectItem T="ReceivingOrderStatus?" Value="@((ReceivingOrderStatus?)status)">
                    @status.GetDisplayName()
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="ReceivingOrderQueue?"
                   Label="Очередь"
                   Value="_queue"
                   ValueChanged="OnQueueChangedAsync"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var queue in Enum.GetValues<ReceivingOrderQueue>())
            {
                <MudSelectItem T="ReceivingOrderQueue?" Value="@((ReceivingOrderQueue?)queue)">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@queue.GetIcon()" Size="Size.Small" />
                        <MudText>@queue.GetDisplayName()</MudText>
                    </MudStack>
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="PutawayStatus?"
                   Label="Статус размещения"
                   Value="_putawayStatus"
                   ValueChanged="OnPutawayStatusChangedAsync"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var status in Enum.GetValues<PutawayStatus>())
            {
                <MudSelectItem T="PutawayStatus?" Value="@((PutawayStatus?)status)">
                    @status.GetDisplayName()
                </MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
    </MudStack>
</MudPaper>

<MudDataGrid T="ReceivingOrder"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <TemplateColumn Title="Номер" SortBy="x => x.Number">
            <CellTemplate>
                <MudLink Href="@GetOrderHref(context.Item)">@context.Item.Number</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Date" Title="Дата" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse == null ? string.Empty : x.Warehouse.Name" Title="Склад" />
        <PropertyColumn Property="x => x.Status" Title="Статус">
            <CellTemplate><MudChip T="string" Size="Size.Small" Color="@context.Item.Status.GetChipColor()">@context.Item.Status.GetDisplayName()</MudChip></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Queue" Title="Очередь">
            <CellTemplate>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@context.Item.Queue.GetIcon()" Size="Size.Small" />
                    <MudText>@context.Item.Queue.GetDisplayName()</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.WarehouseOperation" Title="Складская операция" Sortable="true">
            <CellTemplate>@context.Item.WarehouseOperation.GetDisplayName()</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.PutawayStatus" Title="Размещение">
            <CellTemplate><MudChip T="string" Size="Size.Small" Color="@context.Item.PutawayStatus.GetChipColor()">@context.Item.PutawayStatus.GetDisplayName()</MudChip></CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="1C" Sortable="false">
            <CellTemplate>
                <MudTooltip Text="@(context.Item.ExternalChangeDetected ? "Ордер 1С изменен" : "Синхронизирован с 1С")">
                    <MudIcon Icon="@(context.Item.ExternalChangeDetected ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)"
                             Color="@(context.Item.ExternalChangeDetected ? Color.Warning : Color.Success)" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Принято" SortBy="x => x.CompletedAtUtc">
            <CellTemplate>
                <MudText Typo="Typo.body2">@GetUserName(context.Item.CompletedBy)</MudText>
                <MudText Typo="Typo.caption">@FormatCompletionTime(context.Item.CompletedAtUtc)</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Размещено" SortBy="x => x.PutawayCompletedAtUtc">
            <CellTemplate>
                <MudText Typo="Typo.body2">@GetUserName(context.Item.PutawayCompletedBy)</MudText>
                <MudText Typo="Typo.caption">@FormatCompletionTime(context.Item.PutawayCompletedAtUtc)</MudText>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ReceivingOrder" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
