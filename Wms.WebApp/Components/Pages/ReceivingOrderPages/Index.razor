@page "/receiving-orders"
@using Wms.Domain
@using Wms.Common
@using Wms.Domain.Enums

<PageTitle>Приходные ордера</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Приходные ордера</MudText>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row>
        <MudTextField T="string"
                      @bind-Value="_searchString"
                      Label="Поиск по номеру"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="OnSearchChangedAsync"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" />
        <MudDatePicker Label="Дата с"
                       Date="_dateFrom"
                       DateChanged="OnDateFromChangedAsync"
                       Clearable="true"
                       Class="ml-4" />
        <MudDatePicker Label="Дата по"
                       Date="_dateTo"
                       DateChanged="OnDateToChangedAsync"
                       Clearable="true"
                       Class="ml-4" />
        <MudSelect T="ReceivingOrderStatus?"
                   Label="Статус"
                   Value="_status"
                   ValueChanged="OnStatusChangedAsync"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var status in Enum.GetValues<ReceivingOrderStatus>())
            {
                <MudSelectItem T="ReceivingOrderStatus?" Value="@((ReceivingOrderStatus?)status)">
                    @status.GetDisplayName()
                </MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="ReceivingOrderQueue?"
                   Label="Очередь"
                   Value="_queue"
                   ValueChanged="OnQueueChangedAsync"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var queue in Enum.GetValues<ReceivingOrderQueue>())
            {
                <MudSelectItem T="ReceivingOrderQueue?" Value="@((ReceivingOrderQueue?)queue)">
                    @queue.GetDisplayName()
                </MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
    </MudStack>
</MudPaper>

<MudDataGrid T="ReceivingOrder"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <TemplateColumn Title="Номер" SortBy="x => x.Number">
            <CellTemplate>
                <MudLink Href="@($"receiving-orders/{context.Item.Id}")">@context.Item.Number</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Date" Title="Дата" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse == null ? string.Empty : x.Warehouse.Name" Title="Склад" />
        <PropertyColumn Property="x => x.Status.GetDisplayName()" Title="Статус">
            <CellTemplate><MudChip T="string" Size="Size.Small" Color="@context.Item.Status.GetChipColor()">@context.Item.Status.GetDisplayName()</MudChip></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Queue.GetDisplayName()" Title="Очередь" />        
        <PropertyColumn Property="x => x.StartedAtUtc" Title="В работе с" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <PropertyColumn Property="x => x.CompletedAtUtc" Title="Принят" Format="dd.MM.yyyy HH:mm" Sortable="true" />
        <TemplateColumn Title="1C" Sortable="false">
            <CellTemplate>
                <MudTooltip Text="@(context.Item.ExternalChangeDetected ? "Ордер 1С изменен" : "Синхронизирован с 1С")">
                    <MudIcon Icon="@(context.Item.ExternalChangeDetected ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)"
                             Color="@(context.Item.ExternalChangeDetected ? Color.Warning : Color.Success)" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Детали">
                    <MudIconButton Href="@($"receiving-orders/{context.Item.Id}")"
                                   Icon="@Icons.Material.Filled.OpenInNew"
                                   Color="Color.Primary" />
                </MudTooltip>
                @if (context.Item.Status == ReceivingOrderStatus.InReceiving)
                {
                    <MudTooltip Text="Приёмка">
                        <MudIconButton Href="@($"receiving-orders/{context.Item.Id}/in-process")"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ReceivingOrder" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
