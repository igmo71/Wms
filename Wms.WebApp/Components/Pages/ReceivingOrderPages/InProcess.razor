@page "/receiving-orders/{Id:guid}/in-process"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Приёмка приходного ордера</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">Приёмка приходного ордера @_order.Number</MudText>
            <MudSpacer />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(_isCompleting || _receivingLocation is null)"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="CompleteOrderAsync">
                Завершить
            </MudButton>
            <MudButton Href="@($"receiving-orders/{Id}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                К деталям
            </MudButton>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Номер</MudText>
                    <MudText>@_order.Number</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Дата</MudText>
                    <MudText>@_order.Date.ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Статус</MudText>
                    <MudText>@_order.Status.GetDisplayName()</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">В работе с</MudText>
                    <MudText>@FormatDateTimeOffset(_order.StartedAtUtc)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Принят</MudText>
                    <MudText>@FormatDateTimeOffset(_order.CompletedAtUtc)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Склад</MudText>
                    <MudText>@_order.Warehouse?.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Зона приёмки</MudText>
                    <MudAutocomplete T="Zone"
                                     Value="_receivingZone"
                                     ValueChanged="OnReceivingZoneChanged"
                                     SearchFunc="SearchReceivingZonesAsync"
                                     ToStringFunc="zone => zone?.Name ?? string.Empty"
                                     Disabled="@(_order.Status != ReceivingOrderStatus.InProcess)"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Место приёмки</MudText>
                    <MudAutocomplete T="StorageLocation"
                                     Value="_receivingLocation"
                                     ValueChanged="OnReceivingLocationChanged"
                                     SearchFunc="SearchReceivingLocationsAsync"
                                     ToStringFunc="location => location?.Name ?? string.Empty"
                                     Disabled="@(_order.Status != ReceivingOrderStatus.InProcess || _receivingZone is null)"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="12">
                    <MudText Typo="Typo.caption">Комментарий</MudText>
                    <MudText>@_order.Comment</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_completeFailed)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        <MudDataGrid T="ReceivingOrderItem"
                     Items="_order.Items"
                     Hover="true"
                     Striped="true"
                     Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.LineNumber" Title="Строка" />
                <PropertyColumn Property="x => x.StockKeepingUnit == null ? string.Empty : x.StockKeepingUnit.Name" Title="Номенклатура" />
                <PropertyColumn Property="x => x.PlanQuantity" Title="План" />
                <TemplateColumn Title="Факт">
                    <CellTemplate>
                        <MudNumericField T="double"
                                         Value="context.Item.FactQuantity"
                                         ValueChanged="value => UpdateFactQuantityAsync(context.Item, value)"
                                         Variant="Variant.Text"
                                         HideSpinButtons="true" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.RemainingQuantity" Title="Осталось" />
                <TemplateColumn Title="Комментарий">
                    <CellTemplate>
                        <MudTextField T="string"
                                      Value="context.Item.Comment"
                                      ValueChanged="value => UpdateCommentAsync(context.Item, value)"
                                      Variant="Variant.Text" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudStack>
}
