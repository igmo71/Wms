@page "/receiving-orders/{Id:guid}/in-process"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Приёмка приходного ордера</PageTitle>

@if (_pendingItem is { } pending)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        Операция «@pending.Label» ожидает подтверждения результата.
        <MudButton OnClick="RetryItemAsync" Disabled="@_isSavingItem" Color="Color.Primary">Повторить</MudButton>
    </MudAlert>
}
@if (_completeFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    var sourceSnapshot = _order.SourceSnapshot;
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Приёмка приходного ордера @_order.Number от @_order.Date.ToString("dd.MM.yyyy HH:mm")</MudText>
            <MudSpacer />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(_pendingManagerCompletion is not null || _isSavingItem || _pendingItem is not null || _isAcknowledgingSynchronization || _isCompleting || (_pendingCompletion is null && (_receivingLocation is null || _order.UnconfirmedItemCount > 0 || _order.RequiresManagerCompletion || _synchronizationAssessment?.Level != OrderSynchronizationLevel.Synchronized || !string.IsNullOrWhiteSpace(_synchronizationErrorMessage))))"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="SetReceivedAsync">
                @(_pendingCompletion is null ? "Завершить" : "Повторить завершение")
            </MudButton>
            <MudButton Href="@($"receiving-orders/{Id}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                К деталям
            </MudButton>
        </MudStack>

        @if (_isCompleting)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.caption">Выполняется завершение приемки…</MudText>
        }


        @if (!string.IsNullOrWhiteSpace(_synchronizationErrorMessage))
        {
            <MudAlert Severity="Severity.Error">@_synchronizationErrorMessage</MudAlert>
        }

        <OrderSynchronizationPanel Receiving="true" Assessment="_synchronizationAssessment"
                                   IsAcknowledging="InputsLocked"
                                   OnAcknowledge="AcknowledgeSynchronizationAsync"
                                   AcknowledgedBy="@GetUserName(_order.SynchronizationAcknowledgedBy)"
                                   AcknowledgedAtUtc="_order.SynchronizationAcknowledgedAtUtc" />

        @if (_order.RequiresManagerCompletion)
        {
            <MudAlert Severity="Severity.Warning">Есть количественные расхождения. Завершение требует решения заведующего в Web.</MudAlert>
        }
        @if (_canManageReceiving && (_order.RequiresManagerCompletion || _pendingManagerCompletion is not null))
        {
            <MudPaper Class="pa-3" Outlined="true">
                <MudText>Завершение с текущими фактическими количествами</MudText>
                <MudTextField T="string" @bind-Value="_completionReason" Label="Причина завершения с расхождениями"
                              Lines="2" MaxLength="2000" Immediate="true" Disabled="InputsLocked" />
                <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="CompleteWithDiscrepanciesAsync"
                           Disabled="@(_isCompleting || _isSavingItem || _pendingItem is not null || _pendingCompletion is not null || _isAcknowledgingSynchronization || (_pendingManagerCompletion is null && (string.IsNullOrWhiteSpace(_completionReason) || _receivingLocation is null || _order.UnconfirmedItemCount > 0 || !string.IsNullOrWhiteSpace(_synchronizationErrorMessage))))">
                    @(_pendingManagerCompletion is null ? "Завершить с расхождениями" : "Повторить завершение с расхождениями")
                </MudButton>
            </MudPaper>
        }

        @if (_order.UnconfirmedItemCount > 0)
        {
            <MudAlert Severity="Severity.Info">
                Не проверено строк: @_order.UnconfirmedItemCount. Для завершения приёмки укажите факт каждой строки, включая явный ноль.
            </MudAlert>
        }

        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Склад</MudText><MudText>@_order.Warehouse?.Name</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Складская операция</MudText><MudText>@_order.WarehouseOperation.GetDisplayName()</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Отправитель</MudText><MudText>@PartyDisplay.Format(_order.Shipper, _order.ShipperId, _order.ShipperType)</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Статус</MudText><MudChip T="string" Size="Size.Small" Color="@_order.Status.GetChipColor()">@_order.Status.GetDisplayName()</MudChip></MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Очередь</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@_order.Queue.GetIcon()" Size="Size.Small" />
                        <MudText>@_order.Queue.GetDisplayName()</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Статус размещения</MudText><MudChip T="string" Size="Size.Small" Color="@_order.PutawayStatus.GetChipColor()">@_order.PutawayStatus.GetDisplayName()</MudChip></MudItem>
            </MudGrid>
            <MudDivider Class="my-1" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Зона приёмки</MudText>
                    <MudAutocomplete T="Zone"
                                     Value="_receivingZone"
                                     ValueChanged="OnReceivingZoneChanged"
                                     SearchFunc="SearchReceivingZonesAsync"
                                     ToStringFunc="zone => zone?.Name ?? string.Empty"
                                     Disabled="@(_order.Status != ReceivingOrderStatus.InReceiving || InputsLocked)"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Место приёмки</MudText>
                    <MudAutocomplete T="StorageLocation"
                                     Value="_receivingLocation"
                                     ValueChanged="OnReceivingLocationChanged"
                                     SearchFunc="SearchReceivingLocationsAsync"
                                     ToStringFunc="StorageLocationDisplay.Format"
                                     Disabled="@(_order.Status != ReceivingOrderStatus.InReceiving || _receivingZone is null || InputsLocked)"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTooltip Text="@(_order.Comment ?? "—")">
                        <MudText Typo="Typo.caption">Комментарий</MudText>
                        <MudText Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(_order.Comment ?? "—")</MudText>
                    </MudTooltip>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Фактический вес</MudText><MudText>@WeightDisplay.FormatTotal(_order.KnownFactWeightKg, _order.IsFactWeightComplete)</MudText></MudItem>
            </MudGrid>
            <MudDivider Class="my-1" />
            <MudGrid Spacing="2">
                <DocumentOperationInfo Title="Взял в работу" UserName="@GetUserName(_order.StartedBy)" Timestamp="_order.StartedAtUtc" />
                <DocumentOperationInfo Title="Принял" UserName="@GetUserName(_order.CompletedBy)" Timestamp="_order.CompletedAtUtc" />
                <DocumentOperationInfo Title="Начал размещение" UserName="@GetUserName(_order.PutawayStartedBy)" Timestamp="_order.PutawayStartedAtUtc" />
                <DocumentOperationInfo Title="Разместил" UserName="@GetUserName(_order.PutawayCompletedBy)" Timestamp="_order.PutawayCompletedAtUtc" />
            </MudGrid>
        </MudPaper>

        <MudDataGrid T="ReceivingOrderItem"
                     Items="_order.Items"
                     Hover="true"
                     Striped="true"
                     Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.LineNumber" Title="Строка" />
                <PropertyColumn Property="x => x.StockKeepingUnit == null ? string.Empty : x.StockKeepingUnit.Name" Title="Номенклатура" />
                <PropertyColumn Property="x => x.PlanQuantity" Title="План WMS" />
                <TemplateColumn Title="Текущий план 1С">
                    <CellTemplate>@FormatQuantity(sourceSnapshot?.Items?.FirstOrDefault(x => x.LineNumber == context.Item.LineNumber && x.StockKeepingUnitId == context.Item.StockKeepingUnitId)?.Quantity)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Факт">
                    <CellTemplate>
                        <MudNumericField T="decimal?"
                                         Value="context.Item.FactQuantity"
                                         Disabled="@InputsLocked"
                                         ValueChanged="value => UpdateFactQuantityAsync(context.Item, value)"
                                         Placeholder="Не проверено"
                                         Variant="Variant.Text"
                                         HideSpinButtons="true" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Фактический вес"><CellTemplate>@WeightDisplay.Format(context.Item.FactWeightKg)</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Осталось">
                    <CellTemplate>@FormatQuantity(context.Item.RemainingQuantity)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Комментарий">
                    <CellTemplate>
                        <MudTextField T="string"
                                      Value="context.Item.Comment"
                                      Disabled="@InputsLocked"
                                      ValueChanged="value => UpdateCommentAsync(context.Item, value)"
                                      Variant="Variant.Text" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudStack>
}
