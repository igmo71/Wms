@page "/receiving-orders/{Id:guid}/in-process"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Приёмка приходного ордера</PageTitle>

@if (_pendingItem is { } pending)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        Операция «@pending.Label» ожидает подтверждения результата.
        <MudButton OnClick="RetryItemAsync" Disabled="@_isSavingItem" Color="Color.Primary">Повторить</MudButton>
    </MudAlert>
}
@if (_completeFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_order is null)
{
    <MudAlert Severity="Severity.Warning">Приходный ордер не найден.</MudAlert>
}
else
{
    <MudStack Spacing="2">
        <MudAlert Severity="Severity.Info">Факт формируется только из состава LPN. Завершение не изменяет документ 1С.</MudAlert>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">Приёмка приходного ордера @_order.Number от @_order.Date.ToString("dd.MM.yyyy HH:mm")</MudText>
            <MudSpacer />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(_pendingCompletion is null && CompletionLocked)"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="SetReceivedAsync">
                @(_pendingCompletion is null ? "Завершить" : "Повторить завершение")
            </MudButton>
            <MudButton Href="@($"receiving-orders/{Id}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                К деталям
            </MudButton>
        </MudStack>

        @if (_isCompleting)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.caption">Выполняется свежая сверка и атомарный приход…</MudText>
        }


        @if (!string.IsNullOrWhiteSpace(_synchronizationErrorMessage))
        {
            <MudAlert Severity="Severity.Error">@_synchronizationErrorMessage</MudAlert>
        }

        <OrderSynchronizationPanel Assessment="_synchronizationAssessment"
                                   IsAcknowledging="true"
                                   ShowAcknowledgeButton="false"
                                   RequiresDecisionMessage="Факт отличается от актуального плана 1С. Для завершения требуется отдельное решение Manager с причиной."
                                   AcknowledgedBy="@GetUserName(_order.SynchronizationAcknowledgedBy)"
                                   AcknowledgedAtUtc="_order.SynchronizationAcknowledgedAtUtc" />

        @if (_order.LicensePlateNumbers.Any(x => x.Status == LicensePlateNumberStatus.Open))
        {
            <MudAlert Severity="Severity.Warning">
                Открытые LPN: @string.Join(", ", _order.LicensePlateNumbers
                    .Where(x => x.Status == LicensePlateNumberStatus.Open)
                    .Select(x => $"{x.Code} ({GetUserName(x.ResponsibleUserId)})"))
            </MudAlert>
        }

        @if (_completionReconciliation?.RequiresManager == true)
        {
            @if (_canApproveQuantityDifference)
            {
                <MudTextField T="string"
                              Label="Причина подтверждения количественного расхождения"
                              @bind-Value="_managerReason"
                              Disabled="@(_isCompleting || _pendingCompletion is not null)"
                              Required="true"
                              Lines="2"
                              Variant="Variant.Outlined" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning">Количественное расхождение может подтвердить только Manager.</MudAlert>
            }
        }

        @if (_order.UnconfirmedItemCount > 0)
        {
            <MudAlert Severity="Severity.Info">
                Не проверено строк: @_order.UnconfirmedItemCount. Для завершения приёмки укажите факт каждой строки, включая явный ноль.
            </MudAlert>
        }

        <MudPaper Class="pa-2" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Склад</MudText><MudText>@_order.Warehouse?.Name</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Складская операция</MudText><MudText>@_order.WarehouseOperation.GetDisplayName()</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Отправитель</MudText><MudText>@PartyDisplay.Format(_order.Shipper, _order.ShipperId, _order.ShipperType)</MudText></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Статус</MudText><MudChip T="string" Size="Size.Small" Color="@_order.Status.GetChipColor()">@_order.Status.GetDisplayName()</MudChip></MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Очередь</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@_order.Queue.GetIcon()" Size="Size.Small" />
                        <MudText>@_order.Queue.GetDisplayName()</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Статус размещения</MudText><MudChip T="string" Size="Size.Small" Color="@_order.PutawayStatus.GetChipColor()">@_order.PutawayStatus.GetDisplayName()</MudChip></MudItem>
            </MudGrid>
            <MudDivider Class="my-1" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Зона приёмки</MudText>
                    <MudAutocomplete T="Zone"
                                     Value="_receivingZone"
                                     ValueChanged="OnReceivingZoneChanged"
                                     SearchFunc="SearchReceivingZonesAsync"
                                     ToStringFunc="zone => zone?.Name ?? string.Empty"
                                     Disabled="@(_order.Status != ReceivingOrderStatus.InReceiving || InputsLocked)"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Место приёмки</MudText>
                    <MudAutocomplete T="StorageLocation"
                                     Value="_receivingLocation"
                                     ValueChanged="OnReceivingLocationChanged"
                                     SearchFunc="SearchReceivingLocationsAsync"
                                     ToStringFunc="StorageLocationDisplay.Format"
                                     Disabled="@(_order.Status != ReceivingOrderStatus.InReceiving || _receivingZone is null || InputsLocked)"
                                     Variant="Variant.Text"
                                     Dense="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTooltip Text="@(_order.Comment ?? "—")">
                        <MudText Typo="Typo.caption">Комментарий</MudText>
                        <MudText Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(_order.Comment ?? "—")</MudText>
                    </MudTooltip>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudText Typo="Typo.caption">Фактический вес</MudText><MudText>@WeightDisplay.FormatTotal(_order.KnownFactWeightKg, _order.IsFactWeightComplete)</MudText></MudItem>
            </MudGrid>
            <MudDivider Class="my-1" />
            <MudGrid Spacing="2">
                <DocumentOperationInfo Title="Взял в работу" UserName="@GetUserName(_order.StartedBy)" Timestamp="_order.StartedAtUtc" />
                <DocumentOperationInfo Title="Принял" UserName="@GetUserName(_order.CompletedBy)" Timestamp="_order.CompletedAtUtc" />
                <DocumentOperationInfo Title="Начал размещение" UserName="@GetUserName(_order.PutawayStartedBy)" Timestamp="_order.PutawayStartedAtUtc" />
                <DocumentOperationInfo Title="Разместил" UserName="@GetUserName(_order.PutawayCompletedBy)" Timestamp="_order.PutawayCompletedAtUtc" />
            </MudGrid>
        </MudPaper>

        <ReceivingOrderContents Order="_order"
                                UserNames="_userNames"
                                ShowCurrentPlan="true"
                                CurrentPlanTitle="Актуальный план 1С"
                                CurrentPlanQuantity="CurrentPlanQuantity" />
    </MudStack>
}
