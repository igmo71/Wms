@using Wms.Domain
@using Wms.Domain.Enums

<OrderSynchronizationPanel Assessment="Assessment"
                           Title="Расхождения"
                           ShowLevelColumn="false"
                           BlockingMessage=""
                           IsAcknowledging="IsAcknowledging"
                           ShowAcknowledgeButton="@(Order.Status == ReceivingOrderStatus.ReadyForReceiving)"
                           RequiresDecisionMessage=""
                           OnAcknowledge="OnAcknowledge"
                           AcknowledgedBy="@GetUserName(Order.SynchronizationAcknowledgedBy)"
                           AcknowledgedAtUtc="Order.SynchronizationAcknowledgedAtUtc" />

@code {
    [Parameter, EditorRequired] public ReceivingOrder Order { get; set; } = null!;
    [Parameter] public OrderSynchronizationAssessment? Assessment { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> UserNames { get; set; } = new Dictionary<string, string>();
    [Parameter] public bool IsAcknowledging { get; set; }
    [Parameter] public EventCallback OnAcknowledge { get; set; }

    private string GetUserName(string? userId) => string.IsNullOrWhiteSpace(userId)
        ? "—"
        : UserNames.TryGetValue(userId, out var userName) ? userName : "Пользователь не найден";
}
