@using Wms.Application.Receiving

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-2">Текущий план и факт</MudText>
    @if (Order.HasNewDiscrepancyAfterCompletion)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            После последнего завершения появилось новое расхождение. Прежнее решение показано в истории циклов ниже.
        </MudAlert>
    }
    @if (Order.CurrentItems.Any(x => x.PlanQuantity is decimal plan
        && x.FactQuantity is decimal fact && fact > plan))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Принятый факт превышает текущий план. Проверьте состав источников и приёмные LPN.
        </MudAlert>
    }
    @if (Sources.Any(x => x.LastAttemptError is not null))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Свежая сверка не всех источников подтверждена. Текущий план основан на последних успешных версиях.
        </MudAlert>
    }
    <MudTable T="ReceivingWorkItemView" Items="Order.CurrentItems" Dense="true" Hover="true" Striped="true" Elevation="0">
        <HeaderContent><MudTh>SKU</MudTh><MudTh>Код</MudTh><MudTh>План</MudTh><MudTh>Факт</MudTh><MudTh>Текущее расхождение</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SKU">@(context.SkuName ?? context.SkuId.ToString())</MudTd>
            <MudTd DataLabel="Код">@context.SkuCode</MudTd>
            <MudTd DataLabel="План">@Format(context.PlanQuantity) @context.UnitOfMeasure</MudTd>
            <MudTd DataLabel="Факт">@(context.FactQuantity is null ? "Не проверено" : Format(context.FactQuantity) + " " + context.UnitOfMeasure)</MudTd>
            <MudTd DataLabel="Текущее расхождение">
                @Difference(context)
                @if (context.PlanQuantity is null)
                {
                    <MudText Typo="Typo.caption">@UnknownPlanReason(context)</MudText>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ReceivingWorkOrderView Order { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<ReceivingSourceView> Sources { get; set; } = [];

    private static string Format(decimal? quantity) =>
        quantity?.ToString("0.###") ?? "Неизвестно";

    private static string Difference(ReceivingWorkItemView item) =>
        item.PlanQuantity is null ? "План неизвестен"
        : item.FactQuantity is null ? "Факт не проверен"
        : item.FactQuantity == item.PlanQuantity ? "Нет"
        : $"{item.FactQuantity - item.PlanQuantity:0.###} {item.UnitOfMeasure}";

    private string UnknownPlanReason(ReceivingWorkItemView item)
    {
        var reasons = Sources.Where(source => source.Posted == true
            && source.DeletionMark == false && source.WarehouseId == Order.WarehouseId)
            .SelectMany(source => source.Lines
                .Where(line => (line.StockKeepingUnitId == item.SkuId
                    || line.SourceSkuRefKey == item.SkuId) && line.Error is not null)
                .Select(line => $"{source.Number ?? source.RefKey.ToString()}, строка {line.LineNumber}: {line.Error}"))
            .ToArray();
        return reasons.Length > 0 ? string.Join("; ", reasons)
            : "Проверьте состояние источников и допустимость суммы количеств.";
    }
}
