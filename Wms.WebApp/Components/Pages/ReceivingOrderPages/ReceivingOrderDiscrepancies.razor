@using Wms.Application.Receiving

<MudExpansionPanels Outlined="true" Elevation="0">
<MudExpansionPanel Text="План - Факт" HeaderClass="mud-elevation-1" @bind-Expanded="_expanded">
    @if (Order.HasNewDiscrepancyAfterCompletion)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            После последнего завершения появилось новое расхождение. Данные предыдущей приёмки показаны ниже.
        </MudAlert>
    }
    @if (Order.CurrentItems.Any(x => x.PlanQuantity is decimal plan
        && x.FactQuantity is decimal fact && fact > plan))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Принятый факт превышает текущий план. Проверьте состав документов 1С и приёмные LPN.
        </MudAlert>
    }
    @if (Sources.Any(x => x.LastAttemptError is not null))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Свежая сверка не всех документов 1С подтверждена. Текущий план основан на последних успешных версиях.
        </MudAlert>
    }
    <MudTable T="ReceivingWorkItemView" Items="SortedItems" Dense="true" Hover="true" Elevation="0"
              RowStyleFunc="PlanRowStyle">
        <HeaderContent><MudTh>SKU</MudTh><MudTh>Код</MudTh><MudTh>План</MudTh><MudTh>Факт</MudTh><MudTh>Расхождение</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SKU">
                @(context.SkuName ?? context.SkuId.ToString())
                @if (!context.IsCurrent)
                {
                    <MudText Typo="Typo.caption">Есть открытый LPN</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Код">@context.SkuCode</MudTd>
            <MudTd DataLabel="План">@Format(context.PlanQuantity) @context.UnitOfMeasure</MudTd>
            <MudTd DataLabel="Факт">@(context.FactQuantity is null ? "Не проверено" : Format(context.FactQuantity) + " " + context.UnitOfMeasure)</MudTd>
            <MudTd DataLabel="Расхождение">
                @Difference(context)
                @if (context.PlanQuantity is null)
                {
                    <MudText Typo="Typo.caption">@UnknownPlanReason(context)</MudText>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public ReceivingWorkOrderView Order { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<ReceivingSourceView> Sources { get; set; } = [];

    private bool _expanded = true;

    private IReadOnlyList<ReceivingWorkItemView> SortedItems => Order.Items
        .Where(item => item.IsCurrent || Order.Lpns.Any(lpn =>
            lpn.Status == Wms.Domain.Enums.LicensePlateNumberStatus.Open
            && lpn.Items.Any(lpnItem => lpnItem.SkuId == item.SkuId)))
        .OrderBy(item => item.SkuName ?? item.SkuId.ToString(), StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(item => item.SkuId).ToArray();

    private static string PlanRowStyle(ReceivingWorkItemView item, int _) =>
        item.PlanQuantity is not decimal plan || item.FactQuantity is not decimal fact ? ""
            : plan == fact ? "background-color: var(--mud-palette-success-hover);"
            : "background-color: var(--mud-palette-warning-hover);";

    private static string Format(decimal? quantity) =>
        quantity?.ToString("0.###") ?? "Неизвестно";

    private static string Difference(ReceivingWorkItemView item) =>
        item.PlanQuantity is null ? "План неизвестен"
        : item.FactQuantity is null ? "Факт не проверен"
        : item.FactQuantity == item.PlanQuantity ? "Нет"
        : $"{item.FactQuantity - item.PlanQuantity:0.###} {item.UnitOfMeasure}";

    private string UnknownPlanReason(ReceivingWorkItemView item)
    {
        var reasons = Sources.Where(source => source.Posted == true
            && source.DeletionMark == false && source.WarehouseId == Order.WarehouseId)
            .SelectMany(source => source.Lines
                .Where(line => (line.StockKeepingUnitId == item.SkuId
                    || line.SourceSkuRefKey == item.SkuId) && line.Error is not null)
                .Select(line => $"{source.Number ?? source.RefKey.ToString()}, строка {line.LineNumber}: {line.Error}"))
            .ToArray();
        return reasons.Length > 0 ? string.Join("; ", reasons)
            : "Проверьте состояние документов 1С и допустимость суммы количеств.";
    }
}
