@page "/units-of-measure"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using Wms.Common
@using Wms.Domain

<PageTitle>Единицы измерения</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Единицы измерения</MudText>
    <MudSpacer />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_isImporting" OnClick="RefreshFromOneCAsync">
        @(_isImporting ? "Обновление..." : "Обновить из 1С")
    </MudButton>
</MudStack>
@if (_isImporting)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
@if (_importFailed)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_importMessage</MudAlert>
}
else if (_importSucceeded)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@_importMessage</MudAlert>
}
<MudPaper Class="pa-3 mb-4" Elevation="1"><MudStack Row="true" AlignItems="AlignItems.Center"><MudTextField T="string" Value="_searchString" ValueChanged="OnSearchChangedAsync" Label="Поиск по наименованию" Immediate="true" DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" /><MudSwitch T="bool" Value="_includeDeleted" ValueChanged="OnIncludeDeletedChangedAsync" Color="Color.Primary" Label="Показать деактивированные" Class="ml-4" /></MudStack></MudPaper>
<MudDataGrid T="UnitOfMeasure" @ref="_dataGrid" ServerData="LoadServerDataAsync" SortMode="SortMode.Single" Filterable="false" Hover="true" Striped="true" Dense="true" RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="Код" Sortable="true" /><PropertyColumn Property="x => x.Name" Title="Наименование" Sortable="true" /><PropertyColumn Property="x => x.Abbreviation" Title="Сокращение" Sortable="true" /><PropertyColumn Property="x => x.Description" Title="Описание" Sortable="true" />
        <TemplateColumn Title="Коэффициент" Sortable="false"><CellTemplate>@context.Item.Numerator / @context.Item.Denominator</CellTemplate></TemplateColumn>
        <TemplateColumn Title="Статус" Sortable="false"><CellTemplate><MudTooltip Text="@(context.Item.DeletionMark ? "Деактивирована" : "Активна")"><MudIcon Icon="@(context.Item.DeletionMark ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="@(context.Item.DeletionMark ? Color.Default : Color.Success)" /></MudTooltip></CellTemplate></TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="UnitOfMeasure" PageSizeOptions="new[] { 10, 25, 50 }" /></PagerContent>
</MudDataGrid>
