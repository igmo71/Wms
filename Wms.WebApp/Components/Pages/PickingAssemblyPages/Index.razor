@page "/picking-assemblies"
@attribute [Authorize(Roles = "Operator,Manager")]
@using Wms.Application.Picking

<PageTitle>Сборки WMS</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5">Комплексные сборки</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="ReloadAsync">Обновить</MudButton>
    </MudStack>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    <MudPaper Class="pa-4">
        <MudTextField T="string" @bind-Value="_filter" Immediate="true"
                      Label="Номер сборки или РО 1С" Class="mb-3" />
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudTable T="PickingAssemblyListItem" Items="Filtered" Dense="true" Hover="true"
                      RowsPerPage="15" Elevation="0">
                <HeaderContent>
                    <MudTh>Сборка</MudTh><MudTh>Склад</MudTh><MudTh>Состояние</MudTh>
                    <MudTh>Ответственный</MudTh><MudTh>РО 1С</MudTh><MudTh>Создана</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Сборка"><MudLink Href="@($"picking-assemblies/{context.Id}")">@context.Number</MudLink></MudTd>
                    <MudTd DataLabel="Склад">@(context.WarehouseName ?? context.WarehouseId.ToString())</MudTd>
                    <MudTd DataLabel="Состояние">@StatusText(context.Status)
                        @if (context.HasWarning) { <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" /> }
                    </MudTd>
                    <MudTd DataLabel="Ответственный">@context.ResponsibleDisplayName</MudTd>
                    <MudTd DataLabel="РО 1С">@string.Join(", ", context.Sources.Select(x => x.Number ?? x.SourceRefKey.ToString()))</MudTd>
                    <MudTd DataLabel="Создана">@context.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                </RowTemplate>
                <NoRecordsContent>Сборок нет.</NoRecordsContent>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
    </MudPaper>
</MudStack>
