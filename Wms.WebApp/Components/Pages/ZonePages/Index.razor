@page "/zones"
@using Wms.Common
@using Wms.Domain
@using Wms.Domain.Enums

<PageTitle>Зоны</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Зоны</MudText>
    <MudSpacer />
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateZoneAsync">
        Создать зону
    </MudButton>
</MudStack>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudTextField T="string"
                      Value="_searchString"
                      ValueChanged="OnSearchChangedAsync"
                      Label="Поиск по наименованию"
                      Immediate="true"
                      DebounceInterval="300"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" />
        <MudAutocomplete T="Warehouse"
                         Value="_warehouse"
                         ValueChanged="OnWarehouseChangedAsync"
                         SearchFunc="SearchWarehousesAsync"
                         ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                         Label="Склад"
                         Clearable="true"
                         Class="ml-4" />
        <MudSelect T="ZoneType?"
                   Value="_zoneType"
                   ValueChanged="OnZoneTypeChangedAsync"
                   Label="Тип"
                   Clearable="true"
                   Class="ml-4">
            @foreach (var zoneType in Enum.GetValues<ZoneType>())
            {
                <MudSelectItem T="ZoneType?" Value="zoneType">
                    @zoneType.GetDisplayName()
                </MudSelectItem>
            }
        </MudSelect>
        <MudSwitch T="bool"
                   Value="_includeDeleted"
                   ValueChanged="OnIncludeDeletedChangedAsync"
                   Color="Color.Primary"
                   Label="Показать деактивированные"
                   Class="ml-4" />
    </MudStack>
</MudPaper>

<MudDataGrid T="Zone"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Code" Title="Код" Sortable="false" />
        <PropertyColumn Property="x => x.Name" Title="Наименование" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse == null ? string.Empty : x.Warehouse.Name" Title="Склад" Sortable="false" />
        <PropertyColumn Property="x => x.Type" Title="Тип" Sortable="true">
            <CellTemplate>@context.Item.Type.GetDisplayName()</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Статус" Sortable="false">
            <CellTemplate>
                <MudTooltip Text="@(context.Item.DeletionMark ? "Деактивирована" : "Активна")">
                    <MudIcon Icon="@(context.Item.DeletionMark ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                             Color="@(context.Item.DeletionMark ? Color.Default : Color.Success)" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Редактировать">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => EditZoneAsync(context.Item))" />
                </MudTooltip>
                @if (context.Item.DeletionMark)
                {
                    <MudTooltip Text="Реактивировать">
                        <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                       Color="Color.Success"
                                       OnClick="@(() => UnMarkDeleteAsync(context.Item.Id))" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Деактивировать">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       OnClick="@(() => MarkDeleteAsync(context.Item.Id))" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Zone" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
