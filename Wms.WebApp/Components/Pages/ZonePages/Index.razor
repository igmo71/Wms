@page "/zones"
@using Wms.Domain

<PageTitle>Зоны</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Зоны</MudText>
    <MudSpacer />
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateZoneAsync">
        Создать зону
    </MudButton>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudTextField T="string"
                      Value="_searchString"
                      ValueChanged="OnSearchChangedAsync"
                      Label="Поиск по наименованию"
                      Immediate="true"
                      DebounceInterval="300"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" />
        <MudAutocomplete T="Warehouse"
                         Value="_warehouse"
                         ValueChanged="OnWarehouseChangedAsync"
                         SearchFunc="SearchWarehousesAsync"
                         ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                         Label="Склад"
                         Clearable="true"
                         Class="ml-4" />
        <MudSwitch T="bool"
                   Value="_includeDeleted"
                   ValueChanged="OnIncludeDeletedChangedAsync"
                   Color="Color.Primary"
                   Label="Показать деактивированные"
                   Class="ml-4" />
    </MudStack>
</MudPaper>

<MudDataGrid T="Zone"
             @ref="_dataGrid"
             ServerData="LoadServerDataAsync"
             SortMode="SortMode.Single"
             Filterable="false"
             Hover="true"
             Striped="true"
             Dense="true"
             RowsPerPage="25">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Наименование" Sortable="true" />
        <PropertyColumn Property="x => x.Warehouse == null ? string.Empty : x.Warehouse.Name" Title="Склад" Sortable="false" />
        <TemplateColumn Title="Статус" Sortable="false">
            <CellTemplate>
                @(context.Item.DeletionMark ? "Деактивирована" : "Активна")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Действия" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Редактировать">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="@(() => EditZoneAsync(context.Item))" />
                </MudTooltip>
                @if (context.Item.DeletionMark)
                {
                    <MudTooltip Text="Реактивировать">
                        <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                       Color="Color.Success"
                                       OnClick="@(() => UnMarkDeleteAsync(context.Item.Id))" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Деактивировать">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       OnClick="@(() => MarkDeleteAsync(context.Item.Id))" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Zone" PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudDataGrid>
