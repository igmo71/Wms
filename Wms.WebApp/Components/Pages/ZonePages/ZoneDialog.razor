@using Wms.Domain

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAutocomplete T="Warehouse"
                             Value="_warehouse"
                             ValueChanged="OnWarehouseChanged"
                             SearchFunc="SearchWarehousesAsync"
                             ToStringFunc="warehouse => warehouse?.Name ?? string.Empty"
                             Label="Склад"
                             Required="true"
                             Clearable="true" />
            <MudTextField T="string"
                          @bind-Value="_zone.Name"
                          Label="Наименование"
                          Required="true"
                          Immediate="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(_warehouse is null || string.IsNullOrWhiteSpace(_zone.Name))"
                   OnClick="SaveAsync">
            Сохранить
        </MudButton>
    </DialogActions>
</MudDialog>
