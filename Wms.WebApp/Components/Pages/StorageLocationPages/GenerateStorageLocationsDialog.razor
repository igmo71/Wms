@using Wms.Application.StorageLocations
@using Wms.Domain

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <DialogContent>
        <MudStack Spacing="2">
            <MudText>Ячейки будут добавлены прямо в папку <b>@Parent.Name</b>. Вложенные папки генератор не создаёт.</MudText>
            <MudAutocomplete T="Zone" @bind-Value="_zone" @bind-Value:after="InvalidatePreview"
                             SearchFunc="SearchZonesAsync" ToStringFunc="ZoneText"
                             Label="Функциональная зона" Required="true" Clearable="true" Disabled="@_busy" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Помещение</MudText>
                    <MudNumericField T="int" @bind-Value="_roomFrom" @bind-Value:after="InvalidatePreview" Label="С" Min="0" Max="9" />
                    <MudNumericField T="int" @bind-Value="_roomTo" @bind-Value:after="InvalidatePreview" Label="По" Min="0" Max="9" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Ряд</MudText>
                    <MudTextField T="string" @bind-Value="_rowFrom" @bind-Value:after="InvalidatePreview" Label="С" MaxLength="1" />
                    <MudTextField T="string" @bind-Value="_rowTo" @bind-Value:after="InvalidatePreview" Label="По" MaxLength="1" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Стойка</MudText>
                    <MudNumericField T="int" @bind-Value="_sectionFrom" @bind-Value:after="InvalidatePreview" Label="С" Min="0" Max="99" Format="00" />
                    <MudNumericField T="int" @bind-Value="_sectionTo" @bind-Value:after="InvalidatePreview" Label="По" Min="0" Max="99" Format="00" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Ячейка на полке</MudText>
                    <MudTextField T="string" @bind-Value="_cellFrom" @bind-Value:after="InvalidatePreview" Label="С" MaxLength="1" />
                    <MudTextField T="string" @bind-Value="_cellTo" @bind-Value:after="InvalidatePreview" Label="По" MaxLength="1" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Уровень</MudText>
                    <MudNumericField T="int" @bind-Value="_levelFrom" @bind-Value:after="InvalidatePreview" Label="С" Min="0" Max="9" />
                    <MudNumericField T="int" @bind-Value="_levelTo" @bind-Value:after="InvalidatePreview" Label="По" Min="0" Max="9" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption">Код строится как помещение · ряд · стойка · ячейка · уровень. Максимум @StorageLocationBatchService.MaximumBatchSize ячеек за раз.</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="PreviewAsync" Disabled="@_busy">Показать адреса</MudButton>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            @if (_preview is not null)
            {
                <MudText>Ячеек: @_preview.Count. Совпадений с существующими адресами: @_preview.Conflicts.Count.</MudText>
                <MudTable T="string" Items="_preview.Codes" Dense="true" Hover="true" RowsPerPage="10" Elevation="0">
                    <HeaderContent><MudTh>Адрес</MudTh><MudTh>Проверка</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@StorageLocationAddress.Format(context)</MudTd>
                        <MudTd>@(_preview.Conflicts.Contains(context) ? "Уже существует" : "Новый")</MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_busy">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync"
                   Disabled="@(_busy || _preview?.CanCreate != true)">Создать ячейки</MudButton>
    </DialogActions>
</MudDialog>
