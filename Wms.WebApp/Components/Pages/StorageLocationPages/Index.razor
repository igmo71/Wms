@page "/storage-locations"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using Wms.Domain

<PageTitle>Складские позиции</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Складские позиции</MudText>
    <MudSpacer />
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
               Disabled="@(_zone is null)" OnClick="CreateRootAsync">Корневая позиция</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SubdirectoryArrowRight"
               Disabled="@(_selectedLocation is null)" OnClick="CreateChildAsync">Дочерняя позиция</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlaylistAdd"
               Disabled="@(_zone is null)" OnClick="GenerateChildrenAsync">Создать пакет</MudButton>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudAutocomplete T="Warehouse" Value="_warehouse" ValueChanged="OnWarehouseChangedAsync"
                         SearchFunc="SearchWarehousesAsync" ToStringFunc="x => x?.Name ?? string.Empty"
                         Label="Склад" Clearable="true" />
        <MudAutocomplete T="Zone" Value="_zone" ValueChanged="OnZoneChangedAsync"
                         SearchFunc="SearchZonesAsync" ToStringFunc="ZoneText"
                         Label="Зона" Clearable="true" Class="ml-4" />
        <MudSwitch T="bool" Value="_includeDeleted" ValueChanged="OnIncludeDeletedChangedAsync"
                   Color="Color.Primary" Label="Показать деактивированные" Class="ml-4" />
    </MudStack>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

@if (_zone is null)
{
    <MudAlert Severity="Severity.Info">Выберите склад и зону.</MudAlert>
}
else if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-3" Elevation="1">
                @if (_locations.Count == 0)
                {
                    <MudText>В зоне пока нет складских позиций.</MudText>
                }
                else
                {
                    <MudTreeView T="StorageLocation" Hover="true" Dense="true"
                                 SelectedValue="_selectedLocation" SelectedValueChanged="OnSelectedLocationChanged">
                        @foreach (var location in GetChildren(null))
                        {
                            <StorageLocationTreeItem Location="location" Locations="_locations" />
                        }
                    </MudTreeView>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-3" Elevation="1">
                @if (_selectedLocation is null)
                {
                    <MudText>Выберите узел дерева.</MudText>
                }
                else
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">@_selectedLocation.Name</MudText>
                        <MudText><b>Адрес:</b> @(_zone.Code)-@(_selectedLocation.Code)</MudText>
                        <MudText><b>Тип:</b> @(_selectedLocation.IsFolder ? "Структурная группа" : "Место хранения")</MudText>
                        <MudText><b>Координаты:</b> @CoordinatesText</MudText>
                        <MudText><b>Порядок отбора:</b> @(_selectedLocation.PickSequence?.ToString() ?? "—")</MudText>
                        <MudStack Row="true" Class="mt-2">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditSelectedAsync">Изменить</MudButton>
                            @if (!_selectedLocation.IsFolder && !_selectedLocation.DeletionMark)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.QrCode2"
                                           OnClick="ShowLabelAsync">Этикетка</MudButton>
                            }
                            @if (_selectedLocation.DeletionMark)
                            {
                                <MudButton Color="Color.Success" Variant="Variant.Outlined" OnClick="ActivateSelectedAsync">Активировать</MudButton>
                            }
                            else
                            {
                                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="DeactivateSelectedAsync">Деактивировать</MudButton>
                            }
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
