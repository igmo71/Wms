@using Wms.Domain

@if (Children.Count > 0)
{
    <MudTreeViewItem T="StorageLocation" Value="Location" Text="@Text" Icon="@Icon" IconColor="@IconColor">
        @foreach (var child in Children)
        {
            <StorageLocationTreeItem Location="child" ChildrenByParent="ChildrenByParent" />
        }
    </MudTreeViewItem>
}
else
{
    <MudTreeViewItem T="StorageLocation" Value="Location" Text="@Text" Icon="@Icon" IconColor="@IconColor" />
}

@code {
    [Parameter, EditorRequired]
    public StorageLocation Location { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<Guid, IReadOnlyList<StorageLocation>> ChildrenByParent { get; set; } =
        new Dictionary<Guid, IReadOnlyList<StorageLocation>>();

    private IReadOnlyList<StorageLocation> Children => ChildrenByParent.TryGetValue(Location.Id, out var children)
        ? children : [];

    private string Text => Location.IsFolder
        ? Location.Name
        : string.Equals(Location.Name, Location.DisplayAddress, StringComparison.OrdinalIgnoreCase)
            ? Location.DisplayAddress
            : $"{Location.DisplayAddress} · {Location.Name}";
    private string Icon => Location.IsFolder
        ? Icons.Material.Filled.Folder
        : Location.ActiveLock is null
            ? Icons.Material.Filled.Inventory2
            : Icons.Material.Filled.Lock;
    private Color IconColor => Location.DeletionMark
        ? Color.Default
        : Location.ActiveLock is null
            ? Color.Primary
            : Color.Warning;
}
