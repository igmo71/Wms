<ContentPage
    x:Class="Wms.Mobile.TransitInventoryTransferStartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Транзитное перемещение">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                FontAttributes="Bold"
                FontSize="26"
                Text="Транзитная ячейка" />
            <Label
                x:Name="InstructionLabel"
                FontSize="18"
                Text="Отсканируйте QR транзитной ячейки." />

            <Border
                x:Name="LocationCard"
                IsVisible="False"
                Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label
                        x:Name="LocationLabel"
                        FontAttributes="Bold"
                        FontSize="20" />
                    <Label
                        x:Name="LocationStateLabel"
                        FontSize="17" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="ContinueButton"
                Clicked="OnContinueClicked"
                HeightRequest="60"
                IsVisible="False"
                Loaded="OnContinueButtonLoaded"
                Text="Создать перемещение" />

            <ActivityIndicator
                x:Name="ProgressIndicator"
                IsRunning="False"
                IsVisible="False" />
            <Label
                x:Name="ErrorLabel"
                HorizontalTextAlignment="Center"
                TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
