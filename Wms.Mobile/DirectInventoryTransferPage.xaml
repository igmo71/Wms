<ContentPage
    x:Class="Wms.Mobile.DirectInventoryTransferPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Прямое перемещение">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                x:Name="TransferNumberLabel"
                FontAttributes="Bold"
                FontSize="26" />
            <Label
                x:Name="TransferContextLabel"
                FontSize="16" />

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="StepLabel"
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="1. Исходная ячейка" />
                    <Label
                        x:Name="InstructionLabel"
                        FontSize="18"
                        Text="Отсканируйте QR исходной ячейки." />

                    <VerticalStackLayout
                        x:Name="QuantityPanel"
                        IsVisible="False"
                        Spacing="10">
                        <Label
                            x:Name="AvailableQuantityLabel"
                            FontAttributes="Bold"
                            FontSize="20" />
                        <Entry
                            x:Name="QuantityEntry"
                            FontSize="22"
                            Keyboard="Numeric"
                            Placeholder="Введите количество" />
                        <Button
                            x:Name="AcceptQuantityButton"
                            Clicked="OnAcceptQuantityClicked"
                            HeightRequest="56"
                            Text="Продолжить" />
                        <Label
                            x:Name="QuantityErrorLabel"
                            HorizontalTextAlignment="Center"
                            TextColor="Red" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="ConfirmButton"
                        Clicked="OnConfirmClicked"
                        HeightRequest="60"
                        IsVisible="False"
                        Loaded="OnConfirmButtonLoaded"
                        Text="Подтвердить перемещение" />

                    <VerticalStackLayout
                        x:Name="SuccessPanel"
                        IsVisible="False"
                        Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Движение успешно проведено"
                            TextColor="Green" />
                        <Label
                            x:Name="SuccessLabel"
                            FontSize="17" />
                        <Button
                            Clicked="OnNextMovementClicked"
                            HeightRequest="56"
                            Loaded="OnActionButtonLoaded"
                            Text="Следующее действие" />
                        <Button
                            x:Name="CompleteTransferButton"
                            Clicked="OnCompleteTransferClicked"
                            HeightRequest="56"
                            Loaded="OnActionButtonLoaded"
                            Text="Завершить документ" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        x:Name="ProgressIndicator"
                        IsRunning="False"
                        IsVisible="False" />

                    <Label
                        x:Name="ErrorLabel"
                        HorizontalTextAlignment="Center"
                        TextColor="Red" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="SourceCard"
                IsVisible="False"
                Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Исходная ячейка" />
                    <Label
                        x:Name="SourceLocationLabel"
                        FontSize="18" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="SkuCard"
                IsVisible="False"
                Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Товар" />
                    <Label
                        x:Name="SkuLabel"
                        FontSize="18" />
                    <Label
                        x:Name="SelectedQuantityLabel"
                        FontSize="18"
                        IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="DestinationCard"
                IsVisible="False"
                Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Ячейка назначения" />
                    <Label
                        x:Name="DestinationLocationLabel"
                        FontSize="18" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
