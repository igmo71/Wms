<ContentPage
    x:Class="Wms.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="WMS">

    <ScrollView>
      <VerticalStackLayout
          Padding="24"
          Spacing="16">

        <Label
            Text="WMS Mobile"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            x:Name="LoginPanel"
            Spacing="12">

            <Entry
                x:Name="EmailEntry"
                Keyboard="Email"
                Placeholder="Email" />

            <Entry
                x:Name="PasswordEntry"
                IsPassword="True"
                Placeholder="Пароль" />

            <Button
                x:Name="LoginButton"
                Clicked="OnLoginClicked"
                Text="Войти" />

        </VerticalStackLayout>

        <VerticalStackLayout
            x:Name="SessionPanel"
            IsVisible="False"
            Spacing="12">

            <Label
                x:Name="CurrentUserLabel"
                FontSize="18"
                HorizontalOptions="Center" />

            <Border Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Диагностика сканера" />

                    <Picker x:Name="ScanContextPicker" SelectedIndex="0">
                        <Picker.Items>
                            <x:String>Ячейка</x:String>
                            <x:String>Товар</x:String>
                        </Picker.Items>
                    </Picker>

                    <Button
                        x:Name="CameraButton"
                        Clicked="OnCameraClicked"
                        Text="Сканировать камерой" />

                    <Label
                        x:Name="ScannerStatusLabel"
                        Text="Ожидание сканирования…" />

                    <Label
                        x:Name="ResolvedBarcodeLabel"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="ScanHistoryLabel"
                        FontFamily="monospace"
                        LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>

            <Button
                Clicked="OnLogoutClicked"
                Text="Выйти" />

        </VerticalStackLayout>

        <ActivityIndicator
            x:Name="ProgressIndicator"
            IsRunning="False"
            IsVisible="False" />

        <Label
            x:Name="StatusLabel"
            HorizontalTextAlignment="Center"
            TextColor="Red" />

      </VerticalStackLayout>
    </ScrollView>

</ContentPage>
