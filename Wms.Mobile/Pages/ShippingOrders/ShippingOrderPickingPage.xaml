<ContentPage
    x:Class="Wms.Mobile.ShippingOrderPickingPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:Wms.Contracts.Mobile.V1;assembly=Wms.Contracts"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Отбор">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="NumberLabel" FontAttributes="Bold" FontSize="26" />
            <Label x:Name="StatusLabel" FontAttributes="Bold" FontSize="18" />

            <Border Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="WarehouseLabel" />
                    <Label x:Name="ReceiverLabel" />
                    <Label x:Name="QueueLabel" />
                    <Label x:Name="PlannedDateLabel" />
                    <Label x:Name="LocationLabel" />
                    <Label x:Name="ProgressLabel" FontAttributes="Bold" />
                    <Label x:Name="CommentLabel" FontAttributes="Italic" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="StepLabel" FontAttributes="Bold" FontSize="22" />
                    <Label x:Name="InstructionLabel" FontSize="18" />

                    <Button
                        x:Name="StartPickingButton"
                        Clicked="OnStartPickingClicked"
                        HeightRequest="58"
                        Loaded="OnNonScanControlLoaded"
                        Text="Начать отбор" />
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />

                    <VerticalStackLayout x:Name="LocationConfirmationPanel" IsVisible="False" Spacing="10">
                        <Label x:Name="ScannedLocationLabel" FontAttributes="Bold" FontSize="19" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                x:Name="ConfirmLocationButton"
                                Clicked="OnConfirmLocationClicked"
                                HeightRequest="54"
                                Loaded="OnNonScanControlLoaded"
                                Text="Начать" />
                            <Button
                                x:Name="CancelLocationButton"
                                Clicked="OnCancelLocationClicked"
                                Grid.Column="1"
                                HeightRequest="54"
                                Loaded="OnNonScanControlLoaded"
                                Text="Отмена" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LineCandidatesPanel" IsVisible="False" Spacing="10">
                        <Label FontSize="17" Text="Товар найден в нескольких строках. Выберите строку." />
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding ScanCandidates, Source={x:Reference Page}}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:MobileShippingOrderLineCandidateResponse">
                                    <Border Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnScanCandidateTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="3">
                                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding SkuName}" />
                                            <Label Text="{Binding SkuCode, StringFormat='Код: {0}'}" />
                                            <Label Text="{Binding LineNumber, StringFormat='Строка: {0}'}" />
                                            <Label Text="{Binding RemainingQuantity, StringFormat='Осталось: {0:g}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Clicked="OnCancelCandidatesClicked" Loaded="OnNonScanControlLoaded" Text="Отмена" />
                    </VerticalStackLayout>

                    <Border
                        x:Name="LineSearchPrompt"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}"
                        IsVisible="False"
                        Loaded="OnNonScanControlLoaded"
                        Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenLineSearchTapped" />
                        </Border.GestureRecognizers>
                        <Label FontSize="17" HorizontalTextAlignment="Center" Text="Найти строку вручную" />
                    </Border>

                    <VerticalStackLayout x:Name="LineSearchPanel" IsVisible="False" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Entry
                                x:Name="LineSearchEntry"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="18"
                                Placeholder="Наименование, код или штрихкод"
                                TextChanged="OnLineSearchTextChanged" />
                            <Label Grid.Column="1" FontSize="22" SemanticProperties.Description="Закрыть поиск" Text="✕" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCancelLineSearchTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <BoxView x:Name="LineSearchIndicator" Color="{StaticResource Primary}" HeightRequest="3" Opacity="0" />
                        <Label x:Name="LineSearchStatusLabel" HorizontalTextAlignment="Center" Text="Введите не менее двух символов." />
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding SearchCandidates, Source={x:Reference Page}}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:MobileShippingOrderLineCandidateResponse">
                                    <Border Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnSearchCandidateTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="3">
                                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding SkuName}" />
                                            <Label Text="{Binding SkuCode, StringFormat='Код: {0}'}" />
                                            <Label Text="{Binding LineNumber, StringFormat='Строка: {0}'}" />
                                            <Label Text="{Binding RemainingQuantity, StringFormat='Осталось: {0:g}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" Opacity="0" />
                    <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" TextColor="Red" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="CompletePickingButton"
                Clicked="OnCompletePickingClicked"
                HeightRequest="60"
                IsVisible="False"
                Loaded="OnNonScanControlLoaded"
                Text="Завершить отбор" />

            <Border x:Name="CompletionPanel" IsVisible="False" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="22" Text="Итог отбора" />
                    <Label x:Name="CompletionLinesLabel" FontSize="17" />
                    <Label x:Name="CompletionQuantitiesLabel" FontAttributes="Bold" FontSize="17" />
                    <Label x:Name="CompletionLocationLabel" FontSize="17" />
                    <Label
                        x:Name="CompletionWarningLabel"
                        FontAttributes="Bold"
                        FontSize="17"
                        TextColor="DarkOrange" />
                    <Button
                        x:Name="ConfirmDeviationButton"
                        Clicked="OnConfirmDeviationClicked"
                        HeightRequest="54"
                        Loaded="OnNonScanControlLoaded"
                        Text="Принять отклонения" />
                    <Label
                        x:Name="DeviationConfirmedLabel"
                        FontAttributes="Bold"
                        IsVisible="False"
                        Text="Отклонения подтверждены."
                        TextColor="Green" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            x:Name="ConfirmCompletionButton"
                            Clicked="OnConfirmCompletionClicked"
                            HeightRequest="58"
                            Loaded="OnNonScanControlLoaded"
                            Text="Завершить" />
                        <Button
                            x:Name="CancelCompletionButton"
                            Clicked="OnCancelCompletionClicked"
                            Grid.Column="1"
                            HeightRequest="58"
                            Loaded="OnNonScanControlLoaded"
                            Text="Назад" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label FontAttributes="Bold" FontSize="20" Text="Строки ордера" />
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding LineStates, Source={x:Reference Page}}"
                Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ShippingOrderPickingLineViewState">
                        <Border Padding="14" Stroke="Gray" StrokeThickness="1">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsAccented}" TargetType="Border" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="5">
                                <Label FontAttributes="Bold" FontSize="17" Text="{Binding SkuName}" />
                                <Label Text="{Binding LineText}" />
                                <Label FontSize="16" Text="{Binding QuantitySummary}" />
                                <Label
                                    FontAttributes="Italic"
                                    IsVisible="{Binding HasComment}"
                                    Text="{Binding Comment, StringFormat='Комментарий: {0}'}" />
                                <Label
                                    FontSize="15"
                                    IsEnabled="{Binding CanAddMovement}"
                                    IsVisible="{Binding CanAddMovement}"
                                    Loaded="OnNonScanControlLoaded"
                                    Text="Отобрать остаток"
                                    TextColor="{StaticResource Primary}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnAddLineMovementTapped" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding Movements}"
                                    IsVisible="{Binding HasMovements}"
                                    Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:ShippingOrderPickingMovementViewState">
                                            <Border
                                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}"
                                                Padding="10"
                                                Stroke="Gray"
                                                StrokeThickness="1">
                                                <Border.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccented}" TargetType="Border" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label FontAttributes="Bold" Text="{Binding SourceText}" />
                                                        <Label Text="{Binding QuantityText}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="1"
                                                        IsEnabled="{Binding ActionsEnabled}"
                                                        Loaded="OnNonScanControlLoaded"
                                                        Text="Удалить"
                                                        TextColor="IndianRed"
                                                        VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnDeleteMovementTapped" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
