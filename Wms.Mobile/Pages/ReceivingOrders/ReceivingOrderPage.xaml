<ContentPage x:Class="Wms.Mobile.ReceivingOrderPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Приёмка">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="8">
        <RefreshView x:Name="QueueRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="10">
                    <Picker x:Name="WarehousePicker" Title="Выберите склад"
                            ItemDisplayBinding="{Binding Name}" SelectedIndexChanged="OnWarehouseChanged" />
                    <Label Text="Отсканируйте документ 1С или выберите несколько источников ниже." />
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Label x:Name="SelectionLabel" FontSize="13" />
                    <Label FontAttributes="Bold" Text="Свободные документы 1С" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SourceRows, Source={x:Reference Page}}" Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingSourceRow">
                                <Border Padding="9" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding RefKey}" Tapped="OnSourceTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Label Text="{Binding SelectionMark}" FontSize="20" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Number}" FontAttributes="Bold" />
                                            <Label Text="{Binding PlanText}" FontSize="12" />
                                            <Label Text="{Binding Warning}" FontSize="12" TextColor="DarkOrange" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label FontAttributes="Bold" Text="Ордера WMS" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrderRows, Source={x:Reference Page}}" Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingWorkOrderRow">
                                <Border Padding="9" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding Id}" Tapped="OnOrderTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Number}" FontAttributes="Bold" />
                                        <Label Text="{Binding CreatedAtText}" FontSize="12" />
                                        <Label Text="{Binding StatusText}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="CreateButton" Text="Создать ордер из выбранных документов"
                    Clicked="OnCreateClicked" HeightRequest="46" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
