<ContentPage
    x:Class="Wms.Mobile.ReceivingOrderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Приёмка">

    <RefreshView x:Name="QueueRefreshView" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="10">

                <Picker
                    x:Name="WarehousePicker"
                    ItemDisplayBinding="{Binding Name}"
                    Loaded="OnNonScanControlLoaded"
                    SelectedIndexChanged="OnWarehouseChanged"
                    Title="Выберите склад" />

                <VerticalStackLayout Spacing="5">
                    <Border Padding="8" BackgroundColor="#FFF3CD" Stroke="#E0B000">
                        <Label
                            x:Name="ScanInstructionLabel"
                            FontSize="14"
                            Text="После выбора склада отсканируйте штрихкод приходного ордера." />
                    </Border>
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Border x:Name="ScanResultPanel" Padding="8" BackgroundColor="#E8F5E9"
                            Stroke="#81C784" IsVisible="False">
                        <Label x:Name="ScanResultLabel" FontSize="14" />
                    </Border>
                    <BoxView
                        x:Name="ProgressIndicator"
                        Color="{StaticResource Primary}"
                        HeightRequest="3"
                        IsVisible="False" />
                    <Label
                        x:Name="ErrorLabel"
                        HorizontalTextAlignment="Center"
                        IsVisible="False"
                        TextColor="Red" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label
                        x:Name="ReceivingStatusLabel"
                        HorizontalTextAlignment="Center"
                        IsVisible="False" />
                    <VerticalStackLayout
                        x:Name="ReceivingOrdersLayout"
                        BindableLayout.ItemsSource="{Binding ReceivingOrders}"
                        Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingOrderQueueItemViewState">
                                <Border
                                    Loaded="OnNonScanControlLoaded"
                                    Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            CommandParameter="{Binding Id}"
                                            Tapped="OnOrderTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                Text="{Binding Number}" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding DateText}" />
                                        </Grid>
                                        <Label
                                            FontAttributes="Bold"
                                            IsVisible="{Binding ShowStatus}"
                                            Text="{Binding StatusText}" />
                                        <Label
                                            FontAttributes="Bold"
                                            IsVisible="{Binding HasSynchronizationIssue}"
                                            Text="{Binding SynchronizationText}"
                                            TextColor="DarkOrange" />
                                        <Label
                                            FontAttributes="Bold"
                                            IsVisible="{Binding HasJoinBlock}"
                                            Text="{Binding JoinBlockText}"
                                            TextColor="Red" />
                                        <Label
                                            FontSize="16"
                                            Text="{Binding ProgressText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
