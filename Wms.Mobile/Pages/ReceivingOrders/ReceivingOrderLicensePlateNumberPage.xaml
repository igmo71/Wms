<ContentPage x:Class="Wms.Mobile.ReceivingOrderLicensePlateNumberPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="LPN">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="6">
        <RefreshView x:Name="LpnRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="CodeLabel" FontSize="21" FontAttributes="Bold" />
                    <Label x:Name="StatusLabel" FontSize="12" />
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Label Text="Сканируйте SKU или найдите его вручную." FontSize="12" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ItemRows, Source={x:Reference Page}}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingLpnItemRow">
                                <Border Padding="8" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding SkuId}" Tapped="OnItemTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Details}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="SearchPanel" IsVisible="False" Spacing="4">
                        <Button x:Name="ScopeButton" Text="Поиск: состав ордера" Clicked="OnScopeClicked" />
                        <SearchBar x:Name="SkuSearch" Placeholder="Наименование, код или штрихкод"
                                   SearchButtonPressed="OnSearchClicked" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CandidateRows, Source={x:Reference Page}}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ReceivingSkuChoiceRow">
                                    <Border Padding="8" Stroke="#D4D4D4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding SkuId}" Tapped="OnCandidateTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding Plan}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду" Clicked="OnRetryClicked" IsVisible="False" />
            <Button x:Name="SearchButton" Text="Выбрать SKU вручную" Clicked="OnManualSearchClicked" />
            <Button x:Name="CloseButton" Text="Закрыть LPN и провести приход" Clicked="OnCloseClicked" />
            <Button x:Name="CancelButton" Text="Отменить открытую LPN" Clicked="OnCancelClicked" />
            <Button x:Name="PutawayButton" Text="Разместить LPN" Clicked="OnPutawayClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
