<ContentPage
    x:Class="Wms.Mobile.ReceivingOrderLicensePlateNumberPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Паллета">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
            <Label x:Name="CodeLabel" FontAttributes="Bold" FontSize="22" />
            <Button x:Name="CancelButton" Grid.Column="1" Grid.RowSpan="2" Clicked="OnCancelClicked" FontSize="20" HeightRequest="36" Padding="0" Text="×" WidthRequest="36" />
            <Label x:Name="StatusLabel" Grid.Row="1" FontSize="13" />
            <Label x:Name="InstructionLabel" Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" />
        </Grid>
        <RefreshView x:Name="LpnRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="4">
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows, Source={x:Reference Page}}" Spacing="3">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingOrderLpnSkuRow">
                                <Border Padding="8,6" Stroke="#D4D4D4" StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding StockKeepingUnitId}" Tapped="OnSkuTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" Text="{Binding SkuName}" />
                                        <Label Grid.Row="1" FontSize="11" Text="{Binding SkuCode}" />
                                        <VerticalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="0">
                                            <Label FontSize="12" HorizontalTextAlignment="End" Text="{Binding PlanText}" />
                                            <Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" Text="{Binding QuantityText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" Opacity="0" />
            <Label x:Name="ErrorLabel" FontSize="12" HorizontalTextAlignment="Center" TextColor="Red" />
            <Button x:Name="CloseButton" Clicked="OnCloseClicked" HeightRequest="46" Text="Закрыть паллету" />
            <Button x:Name="ReopenButton" Clicked="OnReopenClicked" HeightRequest="46" Text="Возобновить паллету" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
