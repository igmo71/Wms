<ContentPage
    x:Class="Wms.Mobile.ReceivingOrderLicensePlateNumberPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Палета">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
            <Label x:Name="StatusLabel" FontSize="13" />
            <Button x:Name="CancelButton" Grid.Column="1" Clicked="OnCancelClicked" FontSize="20" HeightRequest="36" Loaded="OnNonScanControlLoaded" Padding="0" Text="×" WidthRequest="36" />
            <Label x:Name="InstructionLabel" Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" />
        </Grid>
        <RefreshView x:Name="LpnRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView x:Name="LpnScrollView">
                <VerticalStackLayout Spacing="4">
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <VerticalStackLayout x:Name="ManualSkuPanel" IsVisible="False" Spacing="5">
                        <Label FontAttributes="Bold" FontSize="14" Text="Выбор из плана ордера" />
                        <SearchBar x:Name="ManualSkuSearch" Placeholder="Название или код товара"
                                   TextChanged="OnManualSkuSearchChanged" />
                        <Label x:Name="ManualSkuHint" FontSize="12" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlannedSkuRows, Source={x:Reference Page}}" Spacing="3">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ReceivingOrderPlannedSkuRow">
                                    <Border Padding="8,6" BackgroundColor="#F3F3F3"
                                            Stroke="#D4D4D4" StrokeThickness="1">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPlanMatched}" Value="True">
                                                <Setter Property="Stroke" Value="#81C784" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding StockKeepingUnitId}" Tapped="OnSkuTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontAttributes="Bold" FontSize="13" LineBreakMode="WordWrap" Text="{Binding SkuName}" />
                                            <Label FontSize="11" Text="{Binding SkuCode}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Label FontAttributes="Bold" FontSize="14" Text="В палете · учтённые товары" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows, Source={x:Reference Page}}" Spacing="3">
                        <BindableLayout.EmptyView>
                            <Label Padding="8" Text="В палете нет номенклатуры." />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingOrderLpnSkuRow">
                                <Border Padding="8,6" BackgroundColor="White"
                                        Stroke="#D4D4D4" StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding StockKeepingUnitId}" Tapped="OnSkuTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label FontAttributes="Bold" FontSize="12" LineBreakMode="WordWrap" Text="{Binding SkuName}" />
                                        <Label Grid.Row="1" FontSize="11" Text="{Binding SkuCode}" />
                                        <VerticalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="0">
                                            <Label FontSize="12" HorizontalTextAlignment="End" Text="{Binding PlanText}" />
                                            <Label FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" Text="{Binding QuantityText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" Opacity="0" />
            <Label x:Name="ErrorLabel" FontSize="12" HorizontalTextAlignment="Center" TextColor="Red" />
            <Button x:Name="RetryCommandButton" Clicked="OnRetryCommandClicked" Loaded="OnNonScanControlLoaded" IsVisible="False" HeightRequest="46" Text="Повторить команду" />
            <Button x:Name="ManualSkuButton" Clicked="OnManualSkuClicked" Loaded="OnNonScanControlLoaded" HeightRequest="46" Text="Выбрать товар из ордера" />
            <Button x:Name="CloseButton" Clicked="OnCloseClicked" HeightRequest="46" Loaded="OnNonScanControlLoaded" Text="Закрыть палету" />
            <Button x:Name="ReopenButton" Clicked="OnReopenClicked" HeightRequest="46" Loaded="OnNonScanControlLoaded" Text="Возобновить палету" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
