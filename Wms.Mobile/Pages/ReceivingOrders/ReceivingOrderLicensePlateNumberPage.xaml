<ContentPage x:Class="Wms.Mobile.ReceivingOrderLicensePlateNumberPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="LPN">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="6">
        <RefreshView x:Name="LpnRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label x:Name="CodeLabel" FontSize="21" FontAttributes="Bold" />
                        <Label x:Name="StatusIcon" FontSize="21" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Label x:Name="ScanHintLabel" Text="Сканируйте SKU или найдите его вручную." FontSize="12" />
                    <VerticalStackLayout x:Name="EditorPanel" IsVisible="False" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="SkuNameLabel" FontAttributes="Bold" FontSize="20" LineBreakMode="WordWrap"
                                   VerticalTextAlignment="Center" />
                            <Button x:Name="ClearSkuButton" Grid.Column="1" Text="✕" FontSize="18"
                                    Padding="10,4" Clicked="OnClearSkuClicked" Loaded="OnNonScanControlLoaded"
                                    SemanticProperties.Description="Убрать SKU из LPN" />
                        </Grid>
                        <Label x:Name="SkuCodeLabel" FontSize="12" />
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                            <Label Text="План" />
                            <Label x:Name="PlanLabel" Grid.Column="1" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="Факт" />
                            <Label x:Name="FactLabel" Grid.Row="1" Grid.Column="1" FontAttributes="Bold" />
                            <Label Grid.Row="2" Text="В этом LPN" />
                            <Label x:Name="CurrentLabel" Grid.Row="2" Grid.Column="1" FontAttributes="Bold" />
                            <Label Grid.Row="3" Text="Единица измерения" />
                            <Label x:Name="UnitLabel" Grid.Row="3" Grid.Column="1" FontAttributes="Bold" />
                        </Grid>
                        <Label Margin="0,6,0,0" Text="Количество в LPN" />
                        <Entry x:Name="QuantityEntry" FontSize="22" Keyboard="Numeric" Placeholder="0"
                               Completed="OnQuantityCompleted" />
                        <VerticalStackLayout x:Name="ExpirationPanel" IsVisible="False" Spacing="3">
                            <Label x:Name="ExpirationHintLabel" FontSize="12" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="Срок годности" VerticalTextAlignment="Center" />
                                <DatePicker x:Name="ExpirationPicker" Grid.Column="1"
                                            Format="dd.MM.yyyy" FontSize="14" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="SearchPanel" IsVisible="False" Spacing="4">
                        <Button x:Name="ScopeButton" Text="Поиск: состав ордера" Clicked="OnScopeClicked" />
                        <SearchBar x:Name="SkuSearch" Placeholder="Наименование, код или штрихкод"
                                   SearchButtonPressed="OnSearchClicked" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CandidateRows, Source={x:Reference Page}}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ReceivingSkuChoiceRow">
                                    <Border Padding="8" Stroke="{AppThemeBinding Light=#D4D4D4, Dark=#5B5B5B}" StrokeThickness="2">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding SkuId}" Tapped="OnCandidateTapped" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsMatched}" Value="True">
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ReceivingMatchFactLight}, Dark={StaticResource ReceivingMatchFactDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsDifferent}" Value="True">
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ReceivingDifferentFactLight}, Dark={StaticResource ReceivingDifferentFactDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Details}" FontSize="12" IsVisible="{Binding HasDetails}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Start">
                                                <Label Text="{Binding PlanText}" FontFamily="OpenSansSemibold" FontSize="13" HorizontalTextAlignment="End" />
                                                <Label Text="{Binding FactText}" TextColor="{Binding FactColor}" FontFamily="OpenSansSemibold" FontSize="13" HorizontalTextAlignment="End"
                                                       SemanticProperties.Description="{Binding FactDescription}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду" Clicked="OnRetryClicked" IsVisible="False" />
            <Grid x:Name="ActionsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button x:Name="ApplyButton" Text="Сохранить" FontSize="12" IsVisible="False"
                        Padding="2,8" Clicked="OnApplyClicked" Loaded="OnNonScanControlLoaded"
                        SemanticProperties.Description="Сохранить количество и выйти из LPN" />
                <Button x:Name="CloseButton" Grid.Column="1" Text="Закрыть" FontSize="12" IsVisible="False"
                        Padding="2,8" Clicked="OnCloseClicked" Loaded="OnNonScanControlLoaded"
                        SemanticProperties.Description="Закрыть LPN и провести приход" />
                <Button x:Name="CancelButton" Grid.Column="2" Text="Отменить" FontSize="12"
                        Padding="2,8" Clicked="OnCancelClicked" Loaded="OnNonScanControlLoaded"
                        SemanticProperties.Description="Отменить LPN" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
