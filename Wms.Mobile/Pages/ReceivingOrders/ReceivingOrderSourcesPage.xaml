<ContentPage x:Class="Wms.Mobile.ReceivingOrderSourcesPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Приёмка › Документы 1С">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <HorizontalStackLayout Spacing="8">
            <Label x:Name="NumberLabel" Text="Новый ордер" FontSize="21" FontAttributes="Bold" />
            <Label x:Name="OrderStatusIcon" FontSize="21" VerticalTextAlignment="Center" IsVisible="False" />
        </HorizontalStackLayout>
        <RefreshView x:Name="SourcesRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Label x:Name="ScanHintLabel" FontSize="12"
                           Text="Сканируйте документ 1С. Он сразу прикрепится к ордеру." />
                    <Label x:Name="EmptyLabel" Text="Документы 1С не прикреплены."
                           IsVisible="False" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SourceRows, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingSourceCompactRow">
                                <Border Padding="8,6" Stroke="#D4D4D4"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                        <VerticalStackLayout Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer CommandParameter="{Binding RefKey}"
                                                                      Tapped="OnSourceTapped" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                                <Label Text="{Binding WarningGlyph}" TextColor="{Binding WarningColor}" FontAttributes="Bold"
                                                       IsVisible="{Binding HasWarning}"
                                                       SemanticProperties.Description="{Binding WarningDescription}" />
                                                <Label Grid.Column="1" Text="{Binding FirstLine}"
                                                       FontAttributes="Bold" LineBreakMode="WordWrap" />
                                            </Grid>
                                            <Label Text="{Binding SecondLine}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="×" FontSize="22"
                                                Padding="0" WidthRequest="40" HeightRequest="40"
                                                SemanticProperties.Description="Открепить документ 1С"
                                                IsVisible="{Binding CanDetach}"
                                                CommandParameter="{Binding RefKey}"
                                                Clicked="OnDetachClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    IsVisible="False" Clicked="OnRetryClicked" />
            <Button x:Name="JoinButton" Text="Начать"
                    IsVisible="False" Clicked="OnJoinClicked" />
            <Grid x:Name="SectionsGrid" ColumnDefinitions="*,*" ColumnSpacing="5"
                  IsVisible="False">
                <Button x:Name="SkuButton" Text="SKU" Clicked="OnSkuClicked" />
                <Button x:Name="LpnsButton" Grid.Column="1" Text="LPN" Clicked="OnLpnsClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
