<ContentPage
    x:Class="Wms.Mobile.ReceivingOrderReceivingPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:Wms.Contracts.Mobile.V1;assembly=Wms.Contracts"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Приёмка">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="NumberLabel" FontAttributes="Bold" FontSize="26" />
            <Label x:Name="StatusLabel" FontAttributes="Bold" FontSize="18" />

            <Border Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="WarehouseLabel" />
                    <Label x:Name="ShipperLabel" />
                    <Label x:Name="LocationLabel" />
                    <Label x:Name="ProgressLabel" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="StepLabel" FontAttributes="Bold" FontSize="22" />
                    <Label x:Name="InstructionLabel" FontSize="18" />

                    <Button
                        x:Name="StartReceivingButton"
                        Clicked="OnStartReceivingClicked"
                        HeightRequest="58"
                        Loaded="OnNonScanControlLoaded"
                        Text="Начать приёмку" />

                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />

                    <VerticalStackLayout
                        x:Name="LocationConfirmationPanel"
                        IsVisible="False"
                        Spacing="10">
                        <Label
                            x:Name="ScannedLocationLabel"
                            FontAttributes="Bold"
                            FontSize="19" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                x:Name="ConfirmLocationButton"
                                Clicked="OnConfirmLocationClicked"
                                HeightRequest="54"
                                Loaded="OnNonScanControlLoaded"
                                Text="Подтвердить" />
                            <Button
                                x:Name="CancelLocationButton"
                                Clicked="OnCancelLocationClicked"
                                Grid.Column="1"
                                HeightRequest="54"
                                Loaded="OnNonScanControlLoaded"
                                Text="Отмена" />
                        </Grid>
                    </VerticalStackLayout>

                    <Border
                        x:Name="LineSearchPrompt"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}"
                        IsVisible="False"
                        Loaded="OnNonScanControlLoaded"
                        Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenLineSearchTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="17"
                            HorizontalTextAlignment="Center"
                            Text="Найти строку вручную" />
                    </Border>

                    <VerticalStackLayout x:Name="LineSearchPanel" IsVisible="False" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Entry
                                x:Name="LineSearchEntry"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="18"
                                Placeholder="Наименование, код или штрихкод"
                                TextChanged="OnLineSearchTextChanged" />
                            <Label Grid.Column="1" FontSize="16" Text="Отмена" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCancelLineSearchTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <BoxView
                            x:Name="LineSearchIndicator"
                            Color="{StaticResource Primary}"
                            HeightRequest="3"
                            Opacity="0" />
                        <Label
                            x:Name="LineSearchStatusLabel"
                            HorizontalTextAlignment="Center"
                            Text="Введите не менее двух символов." />
                        <VerticalStackLayout
                            x:Name="LineSearchResultsLayout"
                            BindableLayout.ItemsSource="{Binding SearchCandidates, Source={x:Reference Page}}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:MobileReceivingOrderLineCandidateResponse">
                                    <Border Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                CommandParameter="{Binding .}"
                                                Tapped="OnSearchCandidateTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="3">
                                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding SkuName}" />
                                            <Label Text="{Binding SkuCode, StringFormat='Код: {0}'}" />
                                            <Label Text="{Binding LineNumber, StringFormat='Строка: {0}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LineCandidatesPanel" IsVisible="False" Spacing="10">
                        <Label
                            Text="Товар найден в нескольких строках. Выберите строку для +1."
                            FontSize="17" />
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding ScanCandidates, Source={x:Reference Page}}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="contracts:MobileReceivingOrderLineCandidateResponse">
                                    <Border Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                CommandParameter="{Binding .}"
                                                Tapped="OnScanCandidateTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="3">
                                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding SkuName}" />
                                            <Label Text="{Binding LineNumber, StringFormat='Строка: {0}'}" />
                                            <Label Text="{Binding PlanQuantity, StringFormat='План: {0:g}'}" />
                                            <Label Text="{Binding FactQuantity, StringFormat='Факт: {0:g}'}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button
                            x:Name="CancelCandidateButton"
                            Clicked="OnCancelCandidateClicked"
                            Loaded="OnNonScanControlLoaded"
                            Text="Отмена" />
                    </VerticalStackLayout>

                    <BoxView
                        x:Name="CommandProgressIndicator"
                        Color="{StaticResource Primary}"
                        HeightRequest="3"
                        Opacity="0" />
                    <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" TextColor="Red" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="CompleteReceivingButton"
                Clicked="OnCompleteReceivingClicked"
                HeightRequest="60"
                IsVisible="False"
                Loaded="OnNonScanControlLoaded"
                Text="Завершить приёмку" />

            <Label FontAttributes="Bold" FontSize="20" Text="Строки ордера" />
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding LineStates, Source={x:Reference Page}}"
                Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ReceivingOrderLineViewState">
                        <Border Padding="13" Stroke="Gray" StrokeThickness="1">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsAccented}" TargetType="Border" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="17"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding SkuName}" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        IsVisible="{Binding HasAccentText}"
                                        Text="{Binding AccentText}"
                                        TextColor="{StaticResource Primary}" />
                                </Grid>
                                <Label Text="{Binding LineText}" />
                                <Label FontSize="16" Text="{Binding QuantitySummary}" />
                                <Label
                                    FontAttributes="Italic"
                                    IsVisible="{Binding HasComment}"
                                    Text="{Binding Comment, StringFormat='Комментарий: {0}'}" />
                                <Label
                                    FontSize="15"
                                    IsEnabled="{Binding ActionsEnabled}"
                                    IsVisible="{Binding ShowActions}"
                                    Loaded="OnNonScanControlLoaded"
                                    Text="Количество"
                                    TextColor="{StaticResource Primary}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            CommandParameter="{Binding .}"
                                            Tapped="OnEditQuantityTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsEditing}">
                                    <Entry
                                        FontSize="20"
                                        Keyboard="Numeric"
                                        Placeholder="Итоговое количество"
                                        Text="{Binding QuantityText, Mode=TwoWay}">
                                        <Entry.Triggers>
                                            <DataTrigger Binding="{Binding HasQuantityError}" TargetType="Entry" Value="True">
                                                <Setter Property="TextColor" Value="Red" />
                                            </DataTrigger>
                                        </Entry.Triggers>
                                    </Entry>
                                    <Button
                                        Grid.Column="1"
                                        Clicked="OnSaveQuantityClicked"
                                        CommandParameter="{Binding .}"
                                        FontSize="22"
                                        HeightRequest="46"
                                        Loaded="OnNonScanControlLoaded"
                                        Padding="0"
                                        Text="✓"
                                        WidthRequest="46" />
                                    <Button
                                        Grid.Column="2"
                                        Clicked="OnCancelQuantityClicked"
                                        CommandParameter="{Binding .}"
                                        FontSize="24"
                                        HeightRequest="46"
                                        Loaded="OnNonScanControlLoaded"
                                        Padding="0"
                                        Text="×"
                                        WidthRequest="46" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
