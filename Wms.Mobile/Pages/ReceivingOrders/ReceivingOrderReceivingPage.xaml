<ContentPage x:Class="Wms.Mobile.ReceivingOrderReceivingPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Приёмка">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="7">
        <VerticalStackLayout Spacing="3">
            <Label x:Name="NumberLabel" FontSize="21" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" FontSize="13" />
        </VerticalStackLayout>
        <RefreshView x:Name="OrderRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <VerticalStackLayout x:Name="LocationPanel" Spacing="5" IsVisible="False">
                        <Label Text="Выберите место приёмки сканированием или поиском" />
                        <SearchBar x:Name="LocationSearch" Placeholder="Адрес или название"
                                   SearchButtonPressed="OnLocationSearch" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocationRows, Source={x:Reference Page}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ReceivingWorkLocationRow">
                                    <Border Padding="8" Stroke="#D4D4D4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding Id}" Tapped="OnLocationTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Display}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Label x:Name="ScanHintLabel" FontSize="12" />
                    <VerticalStackLayout x:Name="ProductsPanel" BindableLayout.ItemsSource="{Binding ItemRows, Source={x:Reference Page}}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingWorkItemRow">
                                <Border Stroke="#D4D4D4" BackgroundColor="{Binding BackgroundColor}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <VerticalStackLayout Padding="8,6">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer CommandParameter="{Binding SkuId}" Tapped="OnSkuTapped" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding PlanAndFact}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="0" FontSize="14"
                                                WidthRequest="44" HeightRequest="40" Padding="0"
                                                Margin="0,4,8,4"
                                                SemanticProperties.Description="Подтвердить отсутствие SKU"
                                                IsVisible="{Binding CanConfirmZero}"
                                                CommandParameter="{Binding SkuId}" Clicked="OnZeroClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="LpnsPanel" BindableLayout.ItemsSource="{Binding LpnRows, Source={x:Reference Page}}" IsVisible="False" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingWorkLpnRow">
                                <Border Padding="8" Stroke="#D4D4D4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Code}" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Button Text="Открыть" FontSize="11" CommandParameter="{Binding Id}" Clicked="OnLpnClicked" />
                                            <Button Text="Разместить" FontSize="11" IsVisible="{Binding CanPutaway}"
                                                    CommandParameter="{Binding Id}" Clicked="OnPutawayClicked" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду" IsVisible="False" Clicked="OnRetryClicked" />
            <Button x:Name="JoinButton" Text="Начать или присоединиться" Clicked="OnJoinClicked" />
            <Grid x:Name="TabsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button Text="SKU" Clicked="OnItemsTabClicked" />
                <Button Grid.Column="1" Text="LPN" Clicked="OnLpnsTabClicked" />
                <Button Grid.Column="2" x:Name="SourcesButton" Text="📄 1С"
                        SemanticProperties.Description="Документы 1С"
                        Clicked="OnSourcesClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
