<ContentPage x:Class="Wms.Mobile.ReceivingOrderLpnListPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Приёмка › LPN">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="7">
        <VerticalStackLayout Spacing="3">
            <HorizontalStackLayout Spacing="8">
                <Label x:Name="NumberLabel" FontSize="21" FontAttributes="Bold" />
                <Label x:Name="StatusIcon" FontSize="21" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <Label x:Name="LocationLabel" FontSize="13" />
        </VerticalStackLayout>
        <RefreshView x:Name="OrderRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Label x:Name="ScanHintLabel" FontSize="12" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LpnRows, Source={x:Reference Page}}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingWorkLpnRow">
                                <Border Padding="8" Stroke="{AppThemeBinding Light=#D4D4D4, Dark=#5B5B5B}"
                                        InputTransparent="{Binding IsReadOnly}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource ReceivingNeutralBackgroundLight}, Dark={StaticResource ReceivingNeutralBackgroundDark}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding Id}" Tapped="OnLpnTapped" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ReceivingMatchBackgroundLight}, Dark={StaticResource ReceivingMatchBackgroundDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDifferent}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ReceivingDifferentBackgroundLight}, Dark={StaticResource ReceivingDifferentBackgroundDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <HorizontalStackLayout Spacing="7">
                                                <Label Text="{Binding Code}" FontAttributes="Bold" />
                                                <Label Text="{Binding StatusGlyph}" TextColor="{Binding StatusColor}" FontAttributes="{Binding StatusFontAttributes}" FontSize="17"
                                                       VerticalTextAlignment="Center"
                                                       SemanticProperties.Description="{Binding StatusDescription}" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding SkuName}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding ExpirationText}" FontSize="12"
                                                   IsVisible="{Binding ShowsExpiration}" />
                                            <Label Text="{Binding OpenHint}" FontSize="11"
                                                   IsVisible="{Binding CanOpen}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                             HorizontalOptions="End" IsVisible="{Binding ShowsQuantities}">
                                            <Label Text="{Binding PlanText}" FontFamily="OpenSansSemibold"
                                                   FontSize="12" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding FactText}" TextColor="{Binding FactColor}" FontFamily="OpenSansSemibold"
                                                   FontSize="12" HorizontalTextAlignment="End"
                                                   SemanticProperties.Description="{Binding FactDescription}">
                                            </Label>
                                            <Label Text="{Binding QuantityText}" FontFamily="OpenSansSemibold"
                                                   FontSize="12" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду" IsVisible="False" Clicked="OnRetryClicked" />
            <Button x:Name="JoinButton" Text="Начать" Clicked="OnJoinClicked" />
            <Label x:Name="CompleteHintLabel" Text="Перед завершением закройте или отмените открытые LPN."
                   FontSize="12" IsVisible="False" />
            <Button x:Name="CompleteButton" Text="Завершить ордер" IsVisible="False"
                    Clicked="OnCompleteClicked" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                <Button x:Name="SkuButton" Text="SKU" Clicked="OnSkuClicked" />
                <Button x:Name="SourcesButton" Grid.Column="1" Text="📄 1С"
                        SemanticProperties.Description="Документы 1С" Clicked="OnSourcesClicked" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
