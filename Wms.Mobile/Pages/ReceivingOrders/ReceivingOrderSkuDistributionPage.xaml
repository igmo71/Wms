<ContentPage
    x:Class="Wms.Mobile.ReceivingOrderSkuDistributionPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="SKU">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="5">
            <Label x:Name="SkuNameLabel" FontAttributes="Bold" FontSize="16" LineBreakMode="WordWrap" />
            <Label x:Name="SkuCodeLabel" FontSize="12" />
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="6">
                <Label FontSize="12" Text="План:" />
                <Label x:Name="PlanLabel" Grid.Column="1" FontAttributes="Bold" FontSize="12" />
                <Label Grid.Column="2" FontSize="12" Text="Факт:" />
                <Label x:Name="FactLabel" Grid.Column="3" FontAttributes="Bold" FontSize="12" />
                <Label x:Name="UnitLabel" Grid.Column="4" FontSize="12" />
            </Grid>
            <Label FontAttributes="Bold" FontSize="13" Text="По LPN" />
            <local:OperationalCameraScannerView x:Name="CameraScannerView" IsVisible="False" />
            <Label x:Name="ScanHintLabel" Text="Сканируйте LPN для этого SKU."
                   FontSize="12" IsVisible="False" />
        </VerticalStackLayout>
        <RefreshView x:Name="SkuRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding LpnRows, Source={x:Reference Page}}" Spacing="4">
                    <BindableLayout.EmptyView>
                        <Label Padding="8" Text="SKU не добавлен ни в один LPN." />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ReceivingOrderSkuLpnRow">
                            <Border Padding="8,6" Stroke="#D4D4D4" StrokeThickness="1"
                                    InputTransparent="{Binding IsReadOnly}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding LicensePlateNumberId}" Tapped="OnLpnTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <HorizontalStackLayout Spacing="7">
                                        <Label FontAttributes="Bold" FontSize="15" Text="{Binding Code}" />
                                        <Label FontSize="16" Text="{Binding StatusGlyph}" TextColor="{Binding StatusColor}" FontAttributes="{Binding StatusFontAttributes}" VerticalTextAlignment="Center"
                                               SemanticProperties.Description="{Binding StatusDescription}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Grid.RowSpan="2" FontAttributes="Bold" FontSize="14" Text="{Binding QuantityText}" VerticalTextAlignment="Center" />
                                    <Label Grid.Row="1" FontSize="11" Text="{Binding ResponsibleUserName}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" FontSize="12" HorizontalTextAlignment="Center" TextColor="Red" />
            <Button x:Name="RetryButton" Text="Повторить команду" Clicked="OnRetryClicked" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
