<ContentPage x:Class="Wms.Mobile.ReceivingOrderJoinPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Приёмка › Присоединение">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="4">
            <Label x:Name="NumberLabel" FontSize="21" FontAttributes="Bold" />
            <Label x:Name="HintLabel" FontSize="13" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">
                <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                <VerticalStackLayout x:Name="LocationPanel" Spacing="6" IsVisible="False">
                    <SearchBar x:Name="LocationSearch" Placeholder="Адрес или название"
                               SearchButtonPressed="OnLocationSearch" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocationRows, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReceivingWorkLocationRow">
                                <Border Padding="8" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding Id}"
                                                              Tapped="OnLocationTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Display}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" IsVisible="False"
                    Text="Повторить присоединение" Clicked="OnRetryClicked" />
            <Button x:Name="JoinExistingButton" IsVisible="False"
                    Text="Присоединиться" Clicked="OnJoinExistingClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
