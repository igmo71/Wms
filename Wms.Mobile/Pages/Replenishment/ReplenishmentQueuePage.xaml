<ContentPage x:Class="Wms.Mobile.ReplenishmentQueuePage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Подпитка">
    <ContentPage.Resources>
        <Style x:Key="LocationIcon" TargetType="Path">
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray900Brush}, Dark={StaticResource WhiteBrush}}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style x:Key="LocationAddress" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="8">
        <RefreshView x:Name="QueueRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="9">
                    <Picker x:Name="WarehousePicker" Title="Выберите склад"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnWarehouseChanged" />
                    <Label Text="Задания по приоритету отгрузки. Потяните вниз для обновления."
                           FontSize="13" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TaskRows, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReplenishmentQueueRow">
                                <Border Padding="9" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding Id}"
                                                              Tapped="OnTaskTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <Image Source="{Binding PriorityIcon}" WidthRequest="20" HeightRequest="20"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding PriorityText}" FontSize="20" FontAttributes="Bold" />
                                            <Label Grid.Column="2" Text="{Binding AssemblyNumber, StringFormat='№ {0}'}"
                                                   FontSize="11" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding SkuName}" FontSize="16" FontAttributes="Bold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                            <Path Style="{StaticResource LocationIcon}"
                                                  Data="M3,14 H7 L9,17 H15 L17,14 H21 V21 H3 Z M12,13 V3 M8,7 L12,3 L16,7"
                                                  SemanticProperties.Description="Ячейка-источник" />
                                            <Label Grid.Column="1" Text="{Binding SourceAddress}"
                                                   Style="{StaticResource LocationAddress}" />
                                            <Path Grid.Row="1" Style="{StaticResource LocationIcon}"
                                                  Data="M3,14 H7 L9,17 H15 L17,14 H21 V21 H3 Z M12,3 V13 M8,9 L12,13 L16,9"
                                                  SemanticProperties.Description="Ячейка назначения" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DestinationAddress}"
                                                   Style="{StaticResource LocationAddress}" />
                                        </Grid>
                                        <Label Text="{Binding ProgressText}" FontSize="13" />
                                        <Label Text="{Binding StateText}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="EmptyLabel" Text="Заданий нет." IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
