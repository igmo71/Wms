<ContentPage x:Class="Wms.Mobile.ReplenishmentQueuePage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Подпитка">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="8">
        <RefreshView x:Name="QueueRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="9">
                    <Picker x:Name="WarehousePicker" Title="Выберите склад"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnWarehouseChanged" />
                    <Label Text="Задания по приоритету отгрузки. Потяните вниз для обновления."
                           FontSize="13" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TaskRows, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReplenishmentQueueRow">
                                <Border Padding="9" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding Id}"
                                                              Tapped="OnTaskTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding PriorityText}" FontSize="12" />
                                        <Label Text="{Binding ProgressText}" FontSize="13" />
                                        <Label Text="{Binding AddressText}" FontSize="12" />
                                        <Label Text="{Binding StateText}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="EmptyLabel" Text="Заданий нет." IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
