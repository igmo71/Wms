<ContentPage x:Class="Wms.Mobile.ReplenishmentTaskPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Подпитка › Задание"
             HideSoftInputOnTapped="True">
    <ContentPage.Resources>
        <Style x:Key="LocationAddressCard" TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="8">
        <RefreshView x:Name="TaskRefreshView" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="SkuLabel" FontSize="21" FontAttributes="Bold" />
                    <Label x:Name="ProgressLabel" FontSize="15" />
                    <Label x:Name="StatusLabel" FontSize="13" />
                    <Button x:Name="CameraButton" Text="Сканировать ячейку"
                            IsVisible="False" Clicked="OnCameraClicked" />
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />

                    <VerticalStackLayout x:Name="ReservePanel" Spacing="5" IsVisible="False">
                        <Label x:Name="ReserveActionLabel" FontAttributes="Bold" />
                        <Button x:Name="ReserveAddressButton" Style="{StaticResource LocationAddressCard}"
                                SemanticProperties.Hint="Открыть подтверждение для ячейки Хранения"
                                Clicked="OnReserveAddressClicked" />
                        <Label x:Name="ReturnInstructionLabel" Text="Верните поддон, если на нём остался товар."
                               FontSize="12" IsVisible="False" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ActivePanel" Spacing="6" IsVisible="False">
                        <VerticalStackLayout x:Name="OtherStockPanel" Spacing="2">
                            <Label Text="Другие товары на поддоне" FontSize="12" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StockRows, Source={x:Reference Page}}"
                                                 Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReplenishmentStockRow">
                                        <Label Text="{Binding Text}" FontSize="12" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="TransferPanel" Spacing="5">
                            <Label Text="Подпитать ячейку «Комплектации»" FontAttributes="Bold" />
                            <Picker x:Name="GroupPicker" Title="Срок годности"
                                    ItemDisplayBinding="{Binding DisplayText}"
                                    SelectedIndexChanged="OnGroupChanged" />
                            <Entry x:Name="QuantityEntry" Keyboard="Numeric" FontSize="22"
                                   Placeholder="Фактически перенесено" />
                            <Button x:Name="DestinationAddressButton" Style="{StaticResource LocationAddressCard}"
                                    SemanticProperties.Hint="Открыть подтверждение переноса"
                                    Clicked="OnDestinationAddressClicked" />
                            <Label x:Name="DestinationScanLabel" Text="Сканируйте ячейку «Комплектации»." />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="Проведённые переносы" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TransferRows, Source={x:Reference Page}}"
                                         Spacing="3">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ReplenishmentTransferRow">
                                <Label Text="{Binding Text}" FontSize="12" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    IsVisible="False" Clicked="OnRetryClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
