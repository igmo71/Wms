<ContentPage
    x:Class="Wms.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="WMS">

    <ScrollView>
      <VerticalStackLayout
          Padding="24"
          Spacing="16">

        <Label
            Text="WMS Mobile"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            x:Name="LoginPanel"
            Spacing="12">

            <Entry
                x:Name="EmailEntry"
                Keyboard="Email"
                Placeholder="Email" />

            <Entry
                x:Name="PasswordEntry"
                IsPassword="True"
                Placeholder="Пароль" />

            <Button
                x:Name="LoginButton"
                Clicked="OnLoginClicked"
                Text="Войти" />

        </VerticalStackLayout>

        <VerticalStackLayout
            x:Name="SessionPanel"
            IsVisible="False"
            Spacing="16">

            <Label
                x:Name="CurrentUserLabel"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                Clicked="OnInventoryTransferClicked"
                FontSize="18"
                HeightRequest="64"
                Text="Перемещение" />

            <Button
                Clicked="OnInventoryCountClicked"
                FontSize="18"
                HeightRequest="64"
                Text="Инвентаризация" />

            <Button
                Clicked="OnReceivingOrdersClicked"
                FontSize="18"
                HeightRequest="64"
                Text="Приёмка и размещение" />

            <Button
                Clicked="OnShippingOrdersClicked"
                FontSize="18"
                HeightRequest="64"
                Text="Отбор и отгрузка" />

            <Button
                Clicked="OnScannerDiagnosticsClicked"
                FontSize="16"
                HeightRequest="56"
                Text="Диагностика сканера" />

            <Button
                Clicked="OnLogoutClicked"
                Text="Выйти" />

        </VerticalStackLayout>

        <ActivityIndicator
            x:Name="ProgressIndicator"
            IsRunning="False"
            IsVisible="False" />

        <Label
            x:Name="StatusLabel"
            HorizontalTextAlignment="Center"
            TextColor="Red" />

      </VerticalStackLayout>
    </ScrollView>

</ContentPage>
