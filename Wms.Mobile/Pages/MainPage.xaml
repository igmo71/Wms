<ContentPage
    x:Class="Wms.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="WMS">

    <ScrollView>
      <VerticalStackLayout
          Padding="16"
          Spacing="12">

        <Label
            Text="WMS Mobile"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            x:Name="LoginPanel"
            Spacing="12">

            <Entry
                x:Name="EmailEntry"
                Keyboard="Email"
                Placeholder="Email" />

            <Entry
                x:Name="PasswordEntry"
                IsPassword="True"
                Placeholder="Пароль" />

            <Button
                x:Name="LoginButton"
                Clicked="OnLoginClicked"
                Text="Войти" />

        </VerticalStackLayout>

        <VerticalStackLayout
            x:Name="SessionPanel"
            IsVisible="False"
            Spacing="10">

            <Label
                x:Name="CurrentUserLabel"
                FontSize="18"
                HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button
                    Clicked="OnReceivingOrdersClicked"
                    FontSize="16"
                    HeightRequest="52"
                    Text="Приёмка" />
                <Button
                    Grid.Column="1"
                    Clicked="OnPutawayClicked"
                    FontSize="16"
                    HeightRequest="52"
                    Text="Размещение" />
            </Grid>

            <Button
                Clicked="OnShippingOrdersClicked"
                FontSize="16"
                HeightRequest="52"
                Text="Отбор и отгрузка" />

            <Button
                Clicked="OnInventoryTransferClicked"
                FontSize="16"
                HeightRequest="52"
                Text="Перемещение" />

            <Button
                Clicked="OnInventoryCountClicked"
                FontSize="16"
                HeightRequest="52"
                Text="Инвентаризация" />

            <Button
                Clicked="OnScannerDiagnosticsClicked"
                FontSize="16"
                HeightRequest="48"
                Text="Диагностика сканера" />

            <Button
                Clicked="OnLogoutClicked"
                Text="Выйти" />

        </VerticalStackLayout>

        <ActivityIndicator
            x:Name="ProgressIndicator"
            IsRunning="False"
            IsVisible="False" />

        <Label
            x:Name="StatusLabel"
            HorizontalTextAlignment="Center"
            TextColor="Red" />

        <Button
            x:Name="ConnectionDiagnosticsButton"
            Clicked="OnConnectionDiagnosticsClicked"
            Text="Проверить подключение" />

        <Button
            x:Name="CopyConnectionDiagnosticsButton"
            Clicked="OnCopyConnectionDiagnosticsClicked"
            IsVisible="False"
            Text="Скопировать отчёт" />

        <Label
            x:Name="ConnectionDiagnosticsLabel"
            FontFamily="monospace"
            IsVisible="False"
            LineBreakMode="CharacterWrap" />

      </VerticalStackLayout>
    </ScrollView>

</ContentPage>
