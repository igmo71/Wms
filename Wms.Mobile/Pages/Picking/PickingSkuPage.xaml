<ContentPage x:Class="Wms.Mobile.PickingSkuPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Отбор › SKU">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="3">
            <Label x:Name="NumberLabel" FontSize="21" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" FontSize="13" />
            <Label x:Name="OwnerLabel" FontSize="13" />
        </VerticalStackLayout>
        <RefreshView x:Name="SkuRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="7">
                    <Label Text="SKU сборки" FontAttributes="Bold" FontSize="17" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SkuRows, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PickingSkuPlanRow">
                                <Border Padding="9" Stroke="#D4D4D4"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSkuTapped"
                                            CommandParameter="{Binding SkuId}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}" FontAttributes="Bold"
                                               LineBreakMode="WordWrap" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding PlanText}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding FactText}" FontFamily="OpenSansSemibold"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Подтверждённый факт" FontAttributes="Bold" FontSize="16" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EntryRows, Source={x:Reference Page}}"
                                         Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PickingEntryListRow">
                                <Grid ColumnDefinitions="*,Auto" Padding="7" ColumnSpacing="8">
                                    <Label Text="{Binding Text}" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1" Text="Вернуть" FontSize="12"
                                            IsVisible="{Binding CanReturn}"
                                            CommandParameter="{Binding Id}" Clicked="OnReturnClicked" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    IsVisible="False" Clicked="OnRetryClicked" />
            <Button x:Name="TakeOverButton" Text="Принять сборку"
                    IsVisible="False" Clicked="OnTakeOverClicked" />
            <Button x:Name="StartButton" Text="Начать Отбор"
                    IsVisible="False" Clicked="OnStartClicked" />
            <Button x:Name="SourcesButton" Text="Документы 1С"
                    Clicked="OnSourcesClicked" />
            <Button x:Name="RouteButton" Text="Маршрут" Clicked="OnRouteClicked"
                    IsVisible="False" />
            <Button x:Name="CloseButton" Text="Закрыть и отгрузить"
                    Clicked="OnCloseClicked" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
