<ContentPage x:Class="Wms.Mobile.PickingSourcesPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Отбор">
    <Shell.TitleView>
        <Label x:Name="HeaderTitleLabel" MaxLines="1"
               WidthRequest="240" HeightRequest="40" HorizontalOptions="Start"
               LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
    </Shell.TitleView>
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="3">
            <local:PerformanceDiagnosticsView />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label x:Name="StatusLabel" FontSize="13" MaxLines="1"
                       MaximumWidthRequest="160"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="OwnerLabel" Grid.Column="1" FontSize="13"
                       MaxLines="1" LineBreakMode="TailTruncation"
                       HorizontalTextAlignment="End" />
            </Grid>
        </VerticalStackLayout>
        <RefreshView x:Name="SourcesRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                    <Label x:Name="ScanHintLabel" FontSize="12"
                           Text="Сканируйте первый РО 1С, чтобы создать сборку." />
                    <Label x:Name="EmptyLabel" Text="Документы 1С ещё не добавлены." />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SourceRows, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PickingSourceRow">
                                <Border Padding="8" Stroke="#D4D4D4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding NumberText}" FontAttributes="Bold" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                                <Image Source="{Binding QueueIcon}" WidthRequest="16" HeightRequest="16"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding QueueText}" FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Label Text="{Binding StatusText}" FontSize="12" />
                                            <Label Text="{Binding ErrorText}" TextColor="DarkOrange"
                                                   FontSize="12" IsVisible="{Binding HasError}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="×"
                                                WidthRequest="40" HeightRequest="40" Padding="0"
                                                IsVisible="{Binding CanDetach}"
                                                CommandParameter="{Binding SourceRefKey}"
                                                Clicked="OnDetachClicked"
                                                SemanticProperties.Description="Открепить РО 1С" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <ActivityIndicator x:Name="ProgressIndicator" HeightRequest="28"
                               IsRunning="False" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    IsVisible="False" Clicked="OnRetryClicked" />
            <Button x:Name="TakeOverButton" Text="Принять сборку"
                    IsVisible="False" Clicked="OnTakeOverClicked" />
            <Button x:Name="StartButton" Text="Начать Отбор"
                    IsVisible="False" Clicked="OnStartClicked" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button x:Name="SkuButton" Text="SKU" FontSize="12"
                        Padding="2,8" Clicked="OnSkuClicked" />
                <Button x:Name="RouteButton" Grid.Column="1" Text="Маршрут"
                        FontSize="12" Padding="2,8" Clicked="OnRouteClicked" />
                <Button Grid.Column="2" Text="📄 1С" FontSize="12" Padding="2,8"
                        IsEnabled="False" FontAttributes="Bold"
                        SemanticProperties.Description="Текущий раздел: Документы 1С" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
