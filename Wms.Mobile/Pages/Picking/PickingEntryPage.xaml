<ContentPage x:Class="Wms.Mobile.PickingEntryPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Отбор › Факт"
             HideSoftInputOnTapped="True">
    <Shell.TitleView>
        <Label x:Name="HeaderTitleLabel" MaxLines="1"
               WidthRequest="240" HeightRequest="40" HorizontalOptions="Start"
               LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
    </Shell.TitleView>
    <Grid RowDefinitions="Auto,*,Auto" Padding="12">
        <local:PerformanceDiagnosticsView Margin="0,0,0,8" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">
                <Border x:Name="SkuCard" Padding="9" Stroke="#D4D4D4" BackgroundColor="White">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <Label x:Name="SkuLabel" FontSize="14" FontAttributes="Bold"
                               TextColor="#202124" LineBreakMode="WordWrap" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5" HorizontalOptions="End">
                                <Label Text="План" FontSize="12" TextColor="#505050" />
                                <Label x:Name="PlanLabel" Grid.Column="1" FontSize="14"
                                       FontFamily="OpenSansSemibold" TextColor="#202124"
                                       MaxLines="1" LineBreakMode="NoWrap" HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5" HorizontalOptions="End">
                                <Label Text="Факт" FontSize="12" TextColor="#505050" />
                                <Label x:Name="FactLabel" Grid.Column="1" FontSize="14"
                                       FontFamily="OpenSansSemibold" TextColor="#202124"
                                       MaxLines="1" LineBreakMode="NoWrap" HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5" HorizontalOptions="End">
                                <Label x:Name="RemainingCaptionLabel" Text="Осталось" FontSize="12"
                                       TextColor="#505050" />
                                <Label x:Name="RemainingLabel" Grid.Column="1" FontSize="14"
                                       FontFamily="OpenSansSemibold" TextColor="#202124"
                                       MaxLines="1" LineBreakMode="NoWrap" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                        <Button x:Name="InfoButton" Grid.Row="1" ImageSource="material_info.png"
                                WidthRequest="36" HeightRequest="36" MinimumWidthRequest="36"
                                MinimumHeightRequest="36" Padding="6" CornerRadius="6"
                                HorizontalOptions="Start" BackgroundColor="#E5E7EB" Clicked="OnInfoClicked"
                                ToolTipProperties.Text="Остатки SKU по ячейкам"
                                SemanticProperties.Description="Остатки SKU по ячейкам" />
                    </Grid>
                </Border>
                <Border Padding="9" Stroke="#D4D4D4">
                    <VerticalStackLayout Spacing="3">
                        <Label x:Name="RecommendationCaptionLabel" FontSize="12" />
                        <Label x:Name="RecommendationLabel" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                <Label x:Name="SourceCaptionLabel" Text="Считанная ячейка" FontSize="12" IsVisible="False" />
                <Label x:Name="SourceAddressLabel" FontSize="22" FontAttributes="Bold" IsVisible="False" />
                <HorizontalStackLayout x:Name="AvailableBlock" Spacing="8" IsVisible="False">
                    <Label Text="Доступно" FontSize="12" VerticalTextAlignment="Center" />
                    <Label x:Name="AvailableLabel" FontSize="14" FontFamily="OpenSansSemibold" />
                </HorizontalStackLayout>
                <Label x:Name="StockLabel" FontSize="12" />
                <Label x:Name="ExpiryLabel" FontSize="13" />
                <Label x:Name="QuantityCaptionLabel" Text="Количество к отбору" FontSize="12" />
                <Entry x:Name="QuantityEntry" Keyboard="Numeric" FontSize="22"
                       Placeholder="Количество" />
                <Label x:Name="ShortageHintLabel" Text="Если найдено меньше предложенного, укажите весь фактический остаток этого SKU и срока в ячейке, включая ноль."
                       FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Margin="0,8,0,0" Spacing="5">
            <ActivityIndicator x:Name="ProgressIndicator" HeightRequest="28"
                               IsRunning="False" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    Clicked="OnRetryClicked" IsVisible="False" />
            <Button x:Name="HoldPalletButton" Text="Снять весь поддон"
                    Clicked="OnHoldPalletClicked" IsVisible="False" />
            <Button x:Name="ConfirmButton" Text="Подтвердить Отбор"
                    Clicked="OnConfirmClicked" IsEnabled="False" />
            <Button x:Name="ReturnPalletButton" Text="Вернуть поддон в исходную ячейку"
                    Clicked="OnReturnPalletClicked" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
