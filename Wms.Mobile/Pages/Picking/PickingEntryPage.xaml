<ContentPage x:Class="Wms.Mobile.PickingEntryPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Отбор › Факт"
             HideSoftInputOnTapped="True">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="8">
        <ScrollView>
            <VerticalStackLayout Spacing="8">
                <Label x:Name="NumberLabel" FontSize="20" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                    <Label x:Name="SkuLabel" FontSize="18" FontAttributes="Bold" />
                    <Button Grid.Column="1" Text="ⓘ" FontSize="17" WidthRequest="34"
                            BackgroundColor="Transparent" Clicked="OnInfoClicked"
                            SemanticProperties.Description="Остатки SKU по ячейкам" />
                </Grid>
                <Label x:Name="RemainingLabel" />
                <Label x:Name="RecommendationLabel" FontSize="13" />
                <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Entry x:Name="LocationEntry" Placeholder="Сканируйте ячейку"
                           ReturnType="Done" Completed="OnLocationCompleted" />
                    <Button Grid.Column="1" Text="Проверить"
                            Clicked="OnCheckLocationClicked" />
                </Grid>
                <Label x:Name="StockLabel" FontSize="13" />
                <Label x:Name="ExpiryLabel" FontSize="13" />
                <Entry x:Name="QuantityEntry" Keyboard="Numeric" FontSize="22"
                       Placeholder="Количество" />
                <Label Text="Проверьте количество и нажмите подтверждение."
                       FontSize="12" />
                <Button x:Name="HoldPalletButton" Text="Снять весь поддон"
                        Clicked="OnHoldPalletClicked" IsVisible="False" />
                <Button x:Name="ConfirmButton" Text="Подтвердить Отбор"
                        Clicked="OnConfirmClicked" IsEnabled="False" />
                <Button x:Name="ShortageButton" Text="Сообщить о недостаче"
                        Clicked="OnShortageClicked" IsVisible="False" />
                <Button x:Name="ReturnPalletButton" Text="Вернуть поддон в исходную ячейку"
                        Clicked="OnReturnPalletClicked" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    Clicked="OnRetryClicked" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
