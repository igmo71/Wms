<ContentPage x:Class="Wms.Mobile.PickingRoutePage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Отбор">
    <Shell.TitleView>
        <Label x:Name="HeaderTitleLabel" MaxLines="1"
               WidthRequest="240" HeightRequest="40" HorizontalOptions="Start"
               LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
    </Shell.TitleView>
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="3">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label x:Name="StatusLabel" FontSize="13" MaxLines="1"
                       MaximumWidthRequest="160" LineBreakMode="TailTruncation" />
                <Label x:Name="OwnerLabel" Grid.Column="1" FontSize="13"
                       MaxLines="1" LineBreakMode="TailTruncation"
                       HorizontalTextAlignment="End" />
            </Grid>
            <Label Text="Маршрут рекомендательный. Сканируйте ячейку из списка или выберите пункт."
                   FontSize="12" />
            <local:OperationalCameraScannerView x:Name="CameraScannerView" />
        </VerticalStackLayout>
        <RefreshView x:Name="RouteRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="7">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PickingRouteRow">
                                <Border Padding="10" Stroke="{AppThemeBinding Light=#D4D4D4, Dark=#5B5B5B}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="StrokeThickness" Value="3" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0F0F0, Dark=#353535}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light=#707070, Dark=#A0A0A0}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStepTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Address}" FontSize="23" FontAttributes="Bold"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1" Text="{Binding StepQuantity}" FontSize="13"
                                                   FontAttributes="Bold" VerticalTextAlignment="Center"
                                                   MaxLines="1" LineBreakMode="NoWrap" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Label Text="{Binding Heading}" FontAttributes="Bold"
                                                   LineBreakMode="WordWrap" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding PlanText}" HorizontalTextAlignment="End"
                                                       MaxLines="1" LineBreakMode="NoWrap" />
                                                <Label Text="{Binding AvailableText}" HorizontalTextAlignment="End"
                                                       MaxLines="1" LineBreakMode="NoWrap" />
                                                <Label Text="{Binding FactText}" FontFamily="OpenSansSemibold"
                                                       HorizontalTextAlignment="End" MaxLines="1" LineBreakMode="NoWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Text="{Binding Detail}" FontSize="13"
                                               IsVisible="{Binding HasDetail}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="EmptyLabel" Text="Доступных шагов нет."
                           IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <ActivityIndicator x:Name="ProgressIndicator" HeightRequest="28"
                               IsRunning="False" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    Clicked="OnRetryClicked" IsVisible="False" />
            <Button x:Name="CloseButton" Text="Закрыть и отгрузить"
                    Clicked="OnCloseClicked" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button x:Name="SkuButton" Text="SKU" FontSize="12"
                        Padding="2,8" Clicked="OnSkuClicked" />
                <Button Grid.Column="1" Text="Маршрут" FontSize="12" Padding="2,8"
                        IsEnabled="False" FontAttributes="Bold"
                        SemanticProperties.Description="Текущий раздел: Маршрут" />
                <Button x:Name="SourcesButton" Grid.Column="2" Text="📄 1С"
                        FontSize="12" Padding="2,8" Clicked="OnSourcesClicked"
                        SemanticProperties.Description="Документы 1С" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
