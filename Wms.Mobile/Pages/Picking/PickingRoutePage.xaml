<ContentPage x:Class="Wms.Mobile.PickingRoutePage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Отбор › Маршрут">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="3">
            <Label x:Name="NumberLabel" FontSize="21" FontAttributes="Bold" />
            <Label Text="Маршрут рекомендательный. Можно выбрать SKU и ячейку вручную."
                   FontSize="12" />
        </VerticalStackLayout>
        <RefreshView x:Name="RouteRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="7">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps, Source={x:Reference Page}}"
                                         Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PickingRouteRow">
                                <Border Padding="10" Stroke="#D4D4D4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStepTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Heading}" FontAttributes="Bold" />
                                        <Label Text="{Binding Detail}" FontSize="13" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="EmptyLabel" Text="Доступных шагов нет."
                           IsVisible="False" />
                    <Label Text="Недоступное количество" FontAttributes="Bold" FontSize="16" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Gaps, Source={x:Reference Page}}"
                                         Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PickingRouteGapRow">
                                <Label Text="{Binding Text}" TextColor="DarkOrange" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}"
                     HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="RetryButton" Text="Повторить команду"
                    Clicked="OnRetryClicked" IsVisible="False" />
            <Button x:Name="CloseButton" Text="Закрыть и отгрузить"
                    Clicked="OnCloseClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
