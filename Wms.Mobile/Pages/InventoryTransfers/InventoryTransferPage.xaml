<ContentPage
    x:Class="Wms.Mobile.InventoryTransferPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Перемещение">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
        RowSpacing="14">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                FontAttributes="Bold"
                FontSize="28"
                Text="Перемещение" />
        </VerticalStackLayout>

        <Picker
            x:Name="WarehousePicker"
            Grid.Row="1"
            ItemDisplayBinding="{Binding Name}"
            SelectedIndexChanged="OnWarehouseChanged"
            Title="Выберите склад" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
                x:Name="NewDirectTransferButton"
                Clicked="OnCreateDirectClicked"
                HeightRequest="56"
                Text="+ Напрямую" />
            <Button
                Grid.Column="1"
                Clicked="OnOpenTransitClicked"
                HeightRequest="56"
                Text="Транзит" />
        </Grid>

        <Button
            x:Name="RefreshButton"
            Grid.Row="3"
            Clicked="OnRefreshClicked"
            HeightRequest="52"
            Text="Обновить" />

        <VerticalStackLayout Grid.Row="4" Spacing="8">
            <ActivityIndicator
                x:Name="ProgressIndicator"
                IsRunning="False"
                IsVisible="False" />

            <Label
                x:Name="ErrorLabel"
                HorizontalTextAlignment="Center"
                TextColor="Red" />
        </VerticalStackLayout>

        <CollectionView
            x:Name="TransfersView"
            Grid.Row="5"
            Margin="0,4,0,0"
            SelectionChanged="OnTransferSelected"
            SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Text="Незавершённых перемещений нет."
                    TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding Number}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding Status}" />
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,4,0,0"
                                Text="{Binding Context}" />
                            <Label
                                Grid.Row="2"
                                Text="{Binding Date}" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="Открыть ›"
                                TextColor="Gray" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
