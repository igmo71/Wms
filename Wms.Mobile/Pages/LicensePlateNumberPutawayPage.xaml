<ContentPage
    x:Class="Wms.Mobile.LicensePlateNumberPutawayPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:Wms.Contracts.Mobile.V1;assembly=Wms.Contracts"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Размещение LPN"
    HideSoftInputOnTapped="True">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label x:Name="InstructionLabel" IsVisible="False" />
            <local:OperationalCameraScannerView x:Name="CameraScannerView" />

            <VerticalStackLayout x:Name="LpnPanel" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label x:Name="LpnCodeLabel" FontAttributes="Bold" FontSize="22" />
                        <Label x:Name="CompletedLabel" Text="✓" TextColor="Green" FontSize="22"
                               SemanticProperties.Description="Палета полностью размещена" IsVisible="False" />
                    </HorizontalStackLayout>
                    <Label x:Name="LpnStatusLabel" IsVisible="False" />
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Page}}"
                        Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:MobileLicensePlateNumberPutawayItemResponse">
                                <Border Padding="8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding RemainingQuantity}">
                                            <DataTrigger.Value>
                                                <x:Decimal>0</x:Decimal>
                                            </DataTrigger.Value>
                                            <Setter Property="BackgroundColor" Value="#E8F5E9" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnItemTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontAttributes="Bold" Text="{Binding SkuName}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding SkuCode}" />
                                            <Label Grid.Column="1" Text="{Binding UnitOfMeasure, TargetNullValue='—'}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                                            <Label FontSize="12" Text="Принято" />
                                            <Label Grid.Column="1" FontSize="12" Text="Размещено" />
                                            <Label Grid.Column="2" FontSize="12" Text="Осталось" />
                                            <Label Grid.Row="1" Text="{Binding AcceptedQuantity, StringFormat='{0:0.###}'}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PlacedQuantity, StringFormat='{0:0.###}'}" />
                                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding RemainingQuantity, StringFormat='{0:0.###}'}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="QuantityPanel" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="SelectedSkuLabel" FontAttributes="Bold" FontSize="20" />
                    <Label x:Name="RemainingLabel" />
                    <Entry x:Name="QuantityEntry" FontSize="22" Keyboard="Numeric" Placeholder="Количество"
                           ReturnType="Done" Focused="OnQuantityFocused" TextChanged="OnQuantityTextChanged"
                           Completed="OnQuantityCompleted" Unfocused="OnQuantityUnfocused" />
                    <Button x:Name="EntireRemainderButton" Clicked="OnEntireRemainderClicked"
                            Loaded="OnNonScanControlLoaded" Text="Весь остаток" />
                    <Label x:Name="QuantityStatusLabel" FontAttributes="Bold" />
                    <Button x:Name="RetryButton" Clicked="OnRetryClicked" IsVisible="False"
                            Loaded="OnNonScanControlLoaded" Text="Повторить то же размещение" />
                    <Label FontAttributes="Bold" Text="Рекомендации позиций" />
                    <Label Text="1. Позиции с текущим остатком SKU" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentSkuStockRecommendations, Source={x:Reference Page}}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:MobileLicensePlateNumberPutawayRecommendationResponse">
                                <Border Padding="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding Address}" />
                                        <Label Text="{Binding Name}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="2. Пустые позиции с историей этого SKU" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EmptyWithSkuHistoryRecommendations, Source={x:Reference Page}}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:MobileLicensePlateNumberPutawayRecommendationResponse">
                                <Border Padding="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding Address}" />
                                        <Label Text="{Binding Name}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="3. Остальные пустые позиции" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EmptyRecommendations, Source={x:Reference Page}}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:MobileLicensePlateNumberPutawayRecommendationResponse">
                                <Border Padding="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding Address}" />
                                        <Label Text="{Binding Name}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label FontSize="12" Text="Можно отсканировать любую допустимую позицию хранения." />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="HistoryPanel" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold" Text="История размещения" />
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding History, Source={x:Reference Page}}"
                        Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:MobileLicensePlateNumberPutawayHistoryResponse">
                                <Border Padding="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding SkuName}" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <Label Text="{Binding DestinationAddress}" />
                                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='{0:0.###}'}" />
                                            <Label Grid.Column="2" Text="{Binding UnitOfMeasure, TargetNullValue='—'}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding CreatedByName}" FontSize="12" />
                                            <Label Grid.Column="1" Text="{Binding CreatedAtUtc, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="12" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button x:Name="NextLpnButton" Loaded="OnNonScanControlLoaded" Clicked="OnNextLpnClicked" IsVisible="False" Text="Следующий LPN" />
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" Opacity="0" />
            <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
