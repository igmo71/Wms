<ContentPage x:Class="Wms.Mobile.LicensePlateNumberPutawayDetailsPage"
             x:Name="Page"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wms.Mobile"
             Title="Размещение LPN">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="5">
        <ScrollView>
            <VerticalStackLayout Spacing="8">
                <Label x:Name="CodeLabel" FontAttributes="Bold" FontSize="20" />
                <Label x:Name="StatusLabel" FontSize="12" />
                <local:OperationalCameraScannerView x:Name="CameraScannerView" />
                <Label Text="Выберите строку LPN или отсканируйте её SKU." FontSize="12" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Page}}" Spacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ReceivingPutawayItemRow">
                            <Border Padding="8" Stroke="#D4D4D4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding Id}" Tapped="OnItemTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding QuantityText}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label FontAttributes="Bold" Text="История размещения" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding History, Source={x:Reference Page}}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ReceivingPutawayHistoryRow">
                            <Border Padding="7" Stroke="#D4D4D4">
                                <Label Text="{Binding Description}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <BoxView x:Name="ProgressIndicator" Color="{StaticResource Primary}" HeightRequest="3" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="Red" FontSize="12" />
            <Button x:Name="NextLpnButton" Text="Следующий LPN" Clicked="OnNextLpnClicked" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
