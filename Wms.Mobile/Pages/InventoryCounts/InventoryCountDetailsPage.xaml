<ContentPage
    x:Class="Wms.Mobile.InventoryCountDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wms.Mobile"
    Title="Пересчёт ячейки">

    <ScrollView x:Name="PageScrollView" SizeChanged="OnPageScrollViewSizeChanged">
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="NumberLabel" FontAttributes="Bold" FontSize="25" />
            <Label x:Name="LocationLabel" FontSize="18" />

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="StepLabel"
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="Пересчёт товара" />
                    <Label
                        x:Name="InstructionLabel"
                        FontSize="18"
                        Text="Отсканируйте товар. Каждый принятый скан добавляет одну единицу." />
                    <local:OperationalCameraScannerView x:Name="CameraScannerView" />

                    <Border
                        x:Name="SkuSearchPrompt"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}"
                        Loaded="OnNonScanControlLoaded"
                        Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenSkuSearchTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="17"
                            HorizontalTextAlignment="Center"
                            Text="Найти товар вручную" />
                    </Border>

                    <VerticalStackLayout x:Name="SkuSearchPanel" IsVisible="False" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Entry
                                x:Name="SkuSearchEntry"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="18"
                                Placeholder="Наименование, код или штрихкод"
                                TextChanged="OnSkuSearchTextChanged" />
                            <Label Grid.Column="1" FontSize="16" Text="Отмена" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCancelSkuSearchTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <ActivityIndicator
                            x:Name="SkuSearchIndicator"
                            IsRunning="False"
                            IsVisible="False" />
                        <Label
                            x:Name="SkuSearchStatusLabel"
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            Text="Введите не менее двух символов." />
                        <VerticalStackLayout x:Name="SkuSearchResults" Spacing="8" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        x:Name="ProgressIndicator"
                        IsRunning="False"
                        IsVisible="False" />
                    <Label x:Name="ErrorLabel" HorizontalTextAlignment="Center" TextColor="Red" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="ProgressLabel" FontAttributes="Bold" FontSize="18" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    x:Name="PostButton"
                    Clicked="OnPostClicked"
                    HeightRequest="58"
                    Loaded="OnNonScanControlLoaded"
                    Text="Провести" />
                <Button
                    x:Name="DeleteDraftButton"
                    Grid.Column="1"
                    Clicked="OnDeleteDraftClicked"
                    HeightRequest="58"
                    Loaded="OnNonScanControlLoaded"
                    Text="Удалить черновик" />
            </Grid>

            <Label FontAttributes="Bold" FontSize="20" Text="Содержимое ячейки" />
            <VerticalStackLayout x:Name="ItemsContainer" Spacing="10" />
            <BoxView
                x:Name="KeyboardScrollSpacer"
                HeightRequest="0"
                IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
